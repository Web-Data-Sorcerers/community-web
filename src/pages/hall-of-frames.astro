---
export const prerender = false;
import {
  getPageState,
  getSectionState,
} from '../data/site-visibility-registry.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ArcaneChamber from '../components/ArcaneChamber.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import HallOfFramesHero from '../components/HallOfFramesHero.astro';
import HallOfFramesFeatured from '../components/HallOfFramesFeatured.astro';
import HallOfFramesProjects from '../components/HallOfFramesProjects.astro';
import HallOfFramesMilestone from '../components/HallOfFramesMilestone.astro';
const enabled = getPageState(Astro.locals.visibility!, 'hall-of-frames');
const visible = (section: string) =>
  getSectionState(Astro.locals.visibility!, 'hall-of-frames', section);

const site =
  Astro.site ?? new URL('https://data-sorcerers-community-sigma.vercel.app');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: site.href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Hall of Frames',
      item: new URL('/hall-of-frames', site).href,
    },
  ],
};
---

<BaseLayout
  title="Hall of Frames — Data Sorcerers"
  description="Explore the Data Sorcerers featured sorcerers, project highlights and community milestones."
  structuredData={[breadcrumbSchema]}
>
  <Navbar active="Hall of Frames" />
  {enabled ? (
    <main id="main">
      <HallOfFramesHero />
      {visible('featured') && <HallOfFramesFeatured />}
      {visible('projects') && <HallOfFramesProjects />}
      {visible('milestones') && <HallOfFramesMilestone />}
    </main>
  ) : (
    <main id="main">
      <ArcaneChamber pageId="hall-of-frames" />
    </main>
  )}
  {enabled && <Footer />}
  {enabled && <Motion />}
</BaseLayout>
