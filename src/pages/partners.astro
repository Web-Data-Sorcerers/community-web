---
export const prerender = false;
import {
  getPageState,
  getSectionState,
} from '../data/site-visibility-registry.mjs';
import ArcaneChamber from '../components/ArcaneChamber.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import PartnersHero from '../components/PartnersHero.astro';
import OurPartners from '../components/OurPartners.astro';
import WhyPartners from '../components/WhyPartners.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
const enabled = getPageState(Astro.locals.visibility!, 'partners');
const visible = (section: string) =>
  getSectionState(Astro.locals.visibility!, 'partners', section);
---

<BaseLayout
  title="Partners — Data Sorcerers"
  description="Build something meaningful with Data Sorcerers. Partner with our AI & data community across industry, academia, and the wider technology ecosystem."
>
  <Navbar active="Partners" />
  {enabled ? (
    <main id="main">
      <PartnersHero />
      {visible('partners') && <OurPartners />}
      {visible('why-partners') && <WhyPartners />}
    </main>
  ) : (
    <main id="main">
      <ArcaneChamber pageId="partners" />
    </main>
  )}
  {enabled && <Footer />}
  {enabled && <Motion />}
</BaseLayout>
