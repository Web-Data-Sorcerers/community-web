---
export const prerender = false;
import {
  getPageState,
  getSectionState,
} from '../data/site-visibility-registry.mjs';
import ArcaneChamber from '../components/ArcaneChamber.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import PartnersHero from '../components/PartnersHero.astro';
import OurPartners from '../components/OurPartners.astro';
import WhyPartners from '../components/WhyPartners.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { getSiteOrigin, canonicalUrl } from '../data/site-url.mjs';
const enabled = getPageState(Astro.locals.visibility!, 'partners');
const visible = (section: string) =>
  getSectionState(Astro.locals.visibility!, 'partners', section);
const site = Astro.site ?? new URL(getSiteOrigin());
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: canonicalUrl('/', site),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Partners',
      item: canonicalUrl('/partners/', site),
    },
  ],
};
---

<BaseLayout
  title="Partnership & Ecosystem — Data Sorcerers"
  description="Collaborate with Data Sorcerers. Partner with our AI & data innovation community across industry, academia, and open-source technology."
  structuredData={[breadcrumbSchema]}
>
  <Navbar active="Partners" />
  {enabled ? (
    <main id="main">
      <PartnersHero />
      {visible('partners') && <OurPartners />}
      {visible('why-partners') && <WhyPartners />}
    </main>
  ) : (
    <main id="main">
      <ArcaneChamber pageId="partners" />
    </main>
  )}
  {enabled && <Footer />}
  {enabled && <Motion />}
</BaseLayout>
