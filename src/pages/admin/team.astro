---
import AdminNavigation from '../../components/admin/AdminNavigation.astro';
import AdminProjectsPanel from '../../components/admin/AdminProjectsPanel.astro';
import AdminTeamPanel from '../../components/admin/AdminTeamPanel.astro';
import AdminRecruitmentPanel from '../../components/admin/AdminRecruitmentPanel.astro';
const title = 'Team Editor | Data Sorcerers';
const description = 'Halaman privat owner Data Sorcerers untuk mengelola Team.';
const canonical = new URL('/admin/team/', Astro.site).href;
const image = new URL('/og/og-default.jpg', Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Data Sorcerers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: canonical })}></script>
    <style is:global>
      @font-face { font-family: Manrope; src: url('/fonts/manrope-400.woff2') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: Manrope; src: url('/fonts/manrope-700.woff2') format('woff2'); font-weight: 700; font-display: swap; }
      @font-face { font-family: 'Bluu Next'; src: url('/fonts/bluu-next-700.woff2') format('woff2'); font-weight: 700; font-display: swap; }
      :root {
        color-scheme: dark;
        --font-display: 'Bluu Next', serif;
        --font-body: Manrope, sans-serif;
        --bg: #050507;
        --surface: #141122;
        --surface-sub: #0e0c18;
        --text: #ffffff;
        --muted: #a8a3b8;
        --accent: #9b7bff;
        --accent-glow: rgba(155, 123, 255, 0.28);
        --border-glass: rgba(155, 123, 255, 0.16);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: radial-gradient(circle at 50% -10%, #17132b 0%, #090710 45%, #050507 100%);
        background-attachment: fixed;
        color: var(--text);
        font: 400 16px/1.5 var(--font-body);
        min-height: 100vh;
      }
      main {
        max-width: 1280px;
        margin: 0 auto;
        padding: 32px 24px;
      }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <main>
      <AdminNavigation active="team" />
      <AdminProjectsPanel />
      <AdminTeamPanel />
      <AdminRecruitmentPanel />
      <noscript><p>Aktifkan JavaScript untuk mengelola Team.</p></noscript>
    </main>
    <script>
      import { initShell } from '../../scripts/admin-shell.js';
      import '../../scripts/cms-admin-editor.js';
      import '../../scripts/cms-team-editor.js';
      import '../../scripts/recruitment-admin.js';
      document.addEventListener('DOMContentLoaded', () => initShell('team'));
      if (document.readyState === 'complete') setTimeout(() => initShell('team'), 100);
    </script>
  </body>
</html>
