---
import AdminNavigation from '../../components/admin/AdminNavigation.astro';
const title = 'Projects Editor | Data Sorcerers';
const description =
  'Halaman privat owner Data Sorcerers untuk mengelola Projects dan meminta penerbitan perubahan ke situs.';
const canonical = new URL('/admin/', Astro.site).href;
const image = new URL('/og/og-default.jpg', Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Data Sorcerers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        url: canonical,
      })}
    ></script>
    <style is:global>
      @font-face {
        font-family: Manrope;
        src: url('/fonts/manrope-400.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: Manrope;
        src: url('/fonts/manrope-700.woff2') format('woff2');
        font-weight: 700;
        font-display: swap;
      }
      @font-face {
        font-family: 'Bluu Next';
        src: url('/fonts/bluu-next-700.woff2') format('woff2');
        font-weight: 700;
        font-display: swap;
      }
      :root {
        color-scheme: dark;
        --font-display: 'Bluu Next', serif;
        --font-body: Manrope, sans-serif;
        --bg: #050507;
        --surface: #141122;
        --surface-sub: #0e0c18;
        --text: #ffffff;
        --muted: #a8a3b8;
        --accent: #9b7bff;
        --accent-glow: rgba(155, 123, 255, 0.28);
        --border-glass: rgba(155, 123, 255, 0.16);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: radial-gradient(
          circle at 50% -10%,
          #17132b 0%,
          #090710 45%,
          #050507 100%
        );
        background-attachment: fixed;
        color: var(--text);
        font: 400 16px/1.5 var(--font-body);
        min-height: 100vh;
      }
      main {
        max-width: 1280px;
        margin: 0 auto;
        padding: 32px 24px;
      }
      header {
        background: linear-gradient(
          180deg,
          rgba(20, 17, 34, 0.8) 0%,
          rgba(13, 11, 22, 0.5) 100%
        );
        border: 1px solid var(--border-glass);
        border-radius: 20px;
        padding: 32px;
        margin-bottom: 32px;
        backdrop-filter: blur(16px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      }
      h1 {
        margin: 0 0 12px;
        font: 700 36px/1.2 var(--font-display);
        color: #ffffff;
        letter-spacing: 0.5px;
        text-shadow: 0 0 24px rgba(155, 123, 255, 0.2);
      }
      h2 {
        margin: 0 0 16px;
        font: 700 22px/1.25 var(--font-display);
        color: #ffffff;
      }
      p {
        margin: 0;
        color: var(--muted);
      }
      header p:not(.brand) {
        max-width: 700px;
        line-height: 1.6;
        color: #b5b0c4;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        color: #c4b5fd;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
      }
      .layout {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) minmax(0, 2.4fr);
        gap: 32px;
        align-items: start;
      }
      nav[aria-label='Daftar project'] {
        background: linear-gradient(180deg, #131020 0%, #0d0b16 100%);
        border: 1px solid var(--border-glass);
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      }
      .editor {
        padding: 32px;
        background: linear-gradient(180deg, #151124 0%, #0e0c18 100%);
        border: 1px solid var(--border-glass);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
      }
      #add {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: rgba(155, 123, 255, 0.1);
        border: 1px dashed rgba(155, 123, 255, 0.4);
        color: #c4b5fd;
        border-radius: 10px;
        padding: 12px;
        font-weight: 600;
        margin-bottom: 20px;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      #add:hover:not(:disabled) {
        background: rgba(155, 123, 255, 0.2);
        border-color: #9b7bff;
        color: #ffffff;
        box-shadow: 0 0 16px rgba(155, 123, 255, 0.25);
      }
      #project-list {
        display: grid;
        gap: 8px;
      }
      button,
      input,
      textarea,
      select {
        font: inherit;
      }
      button {
        border: 1px solid rgba(155, 123, 255, 0.24);
        border-radius: 10px;
        padding: 10px 18px;
        color: var(--text);
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
        transition: all 0.2s ease;
      }
      button:hover:not(:disabled) {
        background: rgba(155, 123, 255, 0.12);
        border-color: rgba(155, 123, 255, 0.4);
        color: #ffffff;
      }
      button:disabled {
        cursor: wait;
        opacity: 0.55;
      }
      button:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .project-choice {
        width: 100%;
        text-align: left;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(10, 8, 16, 0.6);
        color: #bcb7cb;
        font-size: 14px;
        font-weight: 500;
        overflow-wrap: anywhere;
        transition: all 0.2s ease;
      }
      .project-choice:hover:not(:disabled) {
        background: rgba(155, 123, 255, 0.08);
        border-color: rgba(155, 123, 255, 0.24);
        color: #ffffff;
      }
      .project-choice[aria-current='true'] {
        border-color: var(--accent);
        background: linear-gradient(
          135deg,
          rgba(155, 123, 255, 0.22) 0%,
          rgba(124, 92, 252, 0.12) 100%
        );
        color: #ffffff;
        font-weight: 600;
        box-shadow: 0 0 16px rgba(155, 123, 255, 0.2);
      }
      .primary {
        background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
        color: #ffffff;
        border: 1px solid rgba(155, 123, 255, 0.4);
        font-weight: 700;
        padding: 12px 24px;
        box-shadow: 0 4px 18px rgba(155, 123, 255, 0.35);
        border-radius: 10px;
      }
      .primary:hover:not(:disabled) {
        filter: brightness(1.1);
        transform: translateY(-1px);
        box-shadow: 0 6px 22px rgba(155, 123, 255, 0.45);
        color: #ffffff;
      }
      .primary:active:not(:disabled) {
        transform: translateY(0);
      }
      form {
        display: grid;
        gap: 20px;
      }
      label {
        display: grid;
        gap: 8px;
        font-size: 13px;
        font-weight: 600;
        color: #c4b5fd;
        letter-spacing: 0.3px;
      }
      input,
      textarea,
      select {
        width: 100%;
        min-width: 0;
        border: 1px solid rgba(155, 123, 255, 0.2);
        border-radius: 10px;
        padding: 12px 16px;
        color: var(--text);
        background: #08060f;
        transition: all 0.2s ease;
      }
      input:focus,
      textarea:focus,
      select:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 3px rgba(155, 123, 255, 0.22);
        background: #0d0a17;
      }
      textarea {
        resize: vertical;
        min-height: 140px;
        line-height: 1.6;
      }
      .tags {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-top: 16px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
      #delete {
        border: 1px solid rgba(244, 63, 94, 0.3);
        color: #fda4af;
        background: rgba(244, 63, 94, 0.06);
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: 600;
      }
      #delete:hover:not(:disabled) {
        background: rgba(244, 63, 94, 0.16);
        border-color: #f43f5e;
        color: #ffffff;
      }
      #status {
        padding: 14px 20px;
        background: rgba(155, 123, 255, 0.08);
        border: 1px solid rgba(155, 123, 255, 0.24);
        border-radius: 12px;
        color: #ddd6fe;
        margin-bottom: 24px;
        font-size: 14px;
        line-height: 1.5;
        overflow-wrap: anywhere;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
      }
      #status[data-error='true'] {
        background: rgba(244, 63, 94, 0.1);
        border-color: rgba(244, 63, 94, 0.3);
        color: #fecdd3;
      }
      #retry,
      #reload {
        margin-top: 0;
        margin-bottom: 16px;
        padding: 10px 18px;
        border-radius: 10px;
        background: rgba(155, 123, 255, 0.1);
        border: 1px solid rgba(155, 123, 255, 0.3);
        color: #c4b5fd;
        font-weight: 600;
      }
      #retry:hover:not(:disabled),
      #reload:hover:not(:disabled) {
        background: rgba(155, 123, 255, 0.2);
        color: #ffffff;
      }
      .hint {
        font-size: 13px;
        color: #8e889f;
        line-height: 1.5;
      }
      #image-upload {
        padding: 10px;
        background: rgba(155, 123, 255, 0.04);
        border: 1px dashed rgba(155, 123, 255, 0.3);
        cursor: pointer;
      }
      #image-upload:hover {
        border-color: var(--accent);
        background: rgba(155, 123, 255, 0.08);
      }
      #image-preview {
        border-radius: 12px;
        border: 1px solid rgba(155, 123, 255, 0.2);
        background: #07050b;
        padding: 8px;
      }
      [hidden] {
        display: none !important;
      }
      .auth-actions {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
      .login-link {
        display: inline-block;
        padding: 10px 20px;
        background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
        color: #ffffff;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(155, 123, 255, 0.35);
      }
      .login-form {
        display: flex;
        gap: 12px;
        align-items: flex-end;
        flex-wrap: wrap;
        padding: 16px 20px;
        background: rgba(10, 8, 16, 0.85);
        border: 1px solid rgba(155, 123, 255, 0.24);
        border-radius: 14px;
      }
      .login-form label {
        font-size: 12px;
        font-weight: 600;
        color: #bcb7cb;
        gap: 6px;
      }
      .login-form input {
        padding: 8px 12px;
        min-height: 40px;
        border-radius: 8px;
        background: #050408;
      }
      .login-form .primary {
        min-height: 40px;
        padding: 8px 20px;
        justify-self: start;
      }
      #logout {
        border: 1px solid rgba(244, 63, 94, 0.3);
        color: #fda4af;
        background: rgba(244, 63, 94, 0.06);
        border-radius: 8px;
        padding: 8px 16px;
      }
      #logout:hover {
        background: rgba(244, 63, 94, 0.16);
        border-color: #f43f5e;
        color: #ffffff;
      }
      .auth-actions a {
        color: #a8a3b8;
        text-decoration: none;
        font-size: 14px;
        transition: color 0.2s;
      }
      .auth-actions a:hover {
        color: #ffffff;
      }
      a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .brand-logo {
        width: 48px;
        height: auto;
        margin-bottom: 16px;
        filter: drop-shadow(0 0 12px rgba(155, 123, 255, 0.4));
      }
      @media (max-width: 768px) {
        main {
          padding: 16px 12px;
        }
        header {
          padding: 20px 16px;
          border-radius: 14px;
        }
        h1 {
          font-size: 28px;
        }
        .layout {
          grid-template-columns: 1fr;
          gap: 20px;
        }
        .editor {
          padding: 20px 16px;
          border-radius: 14px;
        }
        .tags {
          grid-template-columns: 1fr;
        }
        .login-form {
          flex-direction: column;
          align-items: stretch;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <AdminNavigation active="projects" />
      <header>
        <img
          class="brand-logo"
          src="/images/logo.png"
          alt="Data Sorcerers"
          width="48"
          height="52"
        />
        <p class="brand">Data Sorcerers · Editor</p>
        <h1>Kelola projects</h1>
        <p>
          Pilih project, ubah isinya, lalu simpan. Situs diperbarui setelah
          proses penerbitan selesai.
        </p>
        <div class="auth-actions">
          <form id="login-form" class="login-form" hidden>
            <label>
              Email
              <input
                id="login-email"
                type="email"
                autocomplete="username"
                required
              />
            </label>
            <label>
              Kata sandi
              <input
                id="login-password"
                type="password"
                autocomplete="current-password"
                required
              />
            </label>
            <button class="primary" id="login-submit" type="submit">
              Masuk
            </button>
          </form>
          <button id="login" type="button" class="login-link" hidden>
            Masuk
          </button>
          <button id="logout" type="button" hidden>
            Keluar
          </button>
          <a href="/">Kembali ke situs</a>
        </div>
      </header>
      <p id="status" role="status" aria-live="polite">
        Memeriksa akses…
      </p>
      <button id="retry" type="button" hidden>
        Coba terbitkan lagi
      </button>
      <button id="reload" type="button" hidden>
        Muat ulang projects
      </button>
      <div class="layout" id="workspace" hidden>
        <nav aria-label="Daftar project">
          <h2>Projects</h2>
          <button id="add" type="button">
            Tambah project
          </button>
          <div id="project-list"></div>
        </nav>
        <section class="editor" aria-labelledby="editor-title">
          <h2 id="editor-title">Isi project</h2>
          <form id="project-form">
            <fieldset
              id="fields"
              style="
                border: 0;
                padding: 0;
                margin: 0;
                min-width: 0;
                display: grid;
                gap: 16px;
              "
            >
              <label>
                Judul project
                <input id="title" required maxlength="20000" />
              </label>
              <label>
                Deskripsi
                <textarea
                  id="description"
                  required
                  maxlength="20000"
                ></textarea>
              </label>
              <p class="hint">
                Gunakan judul dan deskripsi singkat agar nyaman dibaca di kartu
                situs.
              </p>
              <div class="tags">
                <label>
                  Kategori pertama
                  <input id="tag-one" required maxlength="20000" />
                </label>
                <label>
                  Kategori kedua
                  <input id="tag-two" required maxlength="20000" />
                </label>
              </div>
              <label>
                Gambar project<select id="image" required></select>
              </label>
              <label>
                Upload gambar
                <input
                  id="image-upload"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  aria-describedby="image-hint"
                />
              </label>
              <p class="hint" id="image-hint">
                Pilih JPG, PNG atau WebP, maksimal 2 MB. Gambar terbit setelah
                project disimpan.
              </p>
              <img
                id="image-preview"
                alt="Preview gambar project"
                hidden
                style="width: 100%; max-height: 240px; object-fit: contain;"
              />
              <div class="actions">
                <button class="primary" id="save" type="submit">
                  Simpan dan terbitkan
                </button>
                <button id="delete" type="button">
                  Hapus project
                </button>
              </div>
            </fieldset>
          </form>
        </section>
      </div>
      <noscript>
        <p>Aktifkan JavaScript untuk masuk dan mengelola Projects.</p>
      </noscript>
    </main>
    <script>
      import '../../scripts/cms-admin-editor.js';
    </script>
  </body>
</html>
