---
export const prerender = false;
import { getPageState } from '../data/site-visibility-registry.mjs';
import ArcaneChamber from '../components/ArcaneChamber.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ContactHero from '../components/ContactHero.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { getSiteOrigin, canonicalUrl } from '../data/site-url.mjs';
const enabled = getPageState(Astro.locals.visibility!, 'contact');

const site = Astro.site ?? new URL(getSiteOrigin());
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: canonicalUrl('/', site),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact',
      item: canonicalUrl('/contact/', site),
    },
  ],
};
---

<BaseLayout
  title="Contact Us — Data Sorcerers"
  description="Hubungi tim Data Sorcerers untuk pertanyaan, peluang kolaborasi, dan kemitraan ekosistem AI dan data di Indonesia."
  structuredData={[breadcrumbSchema]}
>
  <Navbar active="Contact" />
  {enabled ? (
    <main id="main">
      <ContactHero />
    </main>
  ) : (
    <main id="main">
      <ArcaneChamber pageId="contact" />
    </main>
  )}
  {enabled && <Footer />}
  {enabled && <Motion />}
</BaseLayout>
