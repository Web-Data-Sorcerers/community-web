---
export const prerender = false;
import { getPageState } from '../data/site-visibility-registry.mjs';
import ArcaneChamber from '../components/ArcaneChamber.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ContactHero from '../components/ContactHero.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
const enabled = getPageState(Astro.locals.visibility!, 'contact');
---

<BaseLayout
  title="Contact — Data Sorcerers"
  description="Get in touch with Data Sorcerers. Share your idea, challenge, or collaboration opportunity and explore what we can build together."
>
  <Navbar active="Contact" />
  {enabled ? (
    <main id="main">
      <ContactHero />
    </main>
  ) : (
    <main id="main">
      <ArcaneChamber pageId="contact" />
    </main>
  )}
  {enabled && <Footer />}
  {enabled && <Motion />}
</BaseLayout>
