---
export const prerender = false;
import {
  getPageState,
  getSectionState,
} from '../data/site-visibility-registry.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ArcaneChamber from '../components/ArcaneChamber.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import AboutHero from '../components/AboutHero.astro';
import VisiMisi from '../components/VisiMisi.astro';
import Philosophy from '../components/Philosophy.astro';
import OurEcosystem from '../components/OurEcosystem.astro';
import OurTeam from '../components/OurTeam.astro';
const enabled = getPageState(Astro.locals.visibility!, 'about');
const visible = (section: string) =>
  getSectionState(Astro.locals.visibility!, 'about', section);
const site =
  Astro.site ?? new URL('https://data-sorcerers-community-sigma.vercel.app');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: site.href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'About Us',
      item: new URL('/about', site).href,
    },
  ],
};
---

<BaseLayout
  title="About Us — Data Sorcerers"
  description="Meet the Data Sorcerers community, our philosophy, mission, ecosystem and team."
  structuredData={[breadcrumbSchema]}
>
  <Navbar active="About Us" />
  {enabled ? (
    <main id="main">
      <AboutHero />
      {visible('vision-mission') && <VisiMisi />}
      {visible('philosophy') && <Philosophy variant="about" />}
      {visible('ecosystem') && <OurEcosystem />}
      {visible('team') && <OurTeam />}
    </main>
  ) : (
    <main id="main">
      <ArcaneChamber pageId="about" />
    </main>
  )}
  {enabled && <Footer />}
  {enabled && <Motion />}
</BaseLayout>
