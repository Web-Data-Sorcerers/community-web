---
export const prerender = false;
import { getSectionState } from '../data/site-visibility-registry.mjs';
import Recruitment from '../components/Recruitment.astro';
import Projects from '../components/Projects.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import Motion from '../components/Motion.astro';
import Hero from '../components/Hero.astro';
import Philosophy from '../components/Philosophy.astro';
import Domains from '../components/Domains.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
const visible = (id: string) =>
  getSectionState(Astro.locals.visibility!, 'home', id);
---

<BaseLayout
  title="Data Sorcerers — AI & Data Innovation Community"
  description="An AI & Data Innovation Community where students, researchers, and engineers learn, experiment, and build meaningful technology together."
>
  <Navbar />
  <main id="main">
    <Hero />
    {visible('philosophy') && <Philosophy />}
    {visible('what-we-do') && <WhatWeDo />}
    {visible('domains') && <Domains />}
    {visible('projects') && <Projects />}
    {visible('recruitment-cta') && <Recruitment />}
  </main>
  <Footer />
  <Motion />
</BaseLayout>
