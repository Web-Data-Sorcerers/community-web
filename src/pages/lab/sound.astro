---
import BaseLayout from '../../layouts/BaseLayout.astro';

const cues = [
  { id: 'hover', label: 'Hover', hint: 'Airy glass tick — links, cards' },
  { id: 'click', label: 'Click', hint: 'Arcane pluck — buttons, tabs' },
  { id: 'select', label: 'Select', hint: 'Brighter pluck — nav, toggles' },
  {
    id: 'transition',
    label: 'Transition',
    hint: 'Seal whoosh — internal page navigation',
  },
  { id: 'open', label: 'Open', hint: 'Rising whoosh — menu, role card' },
  { id: 'close', label: 'Close', hint: 'Falling whoosh — menu, FAQ' },
  { id: 'success', label: 'Success', hint: 'Rising chime — apply, confirm' },
  { id: 'error', label: 'Error', hint: 'Soft thud — disabled, invalid' },
] as const;
---

<BaseLayout
  title="Sound Lab — Data Sorcerers"
  description="Internal audition page for the procedural arcane sound palette used across the Data Sorcerers site."
  noindex
>
  <main class="lab">
    <header>
      <p class="eyebrow">Internal · noindex</p>
      <h1>Sound Lab</h1>
      <p>
        <a href="/">Back to Home</a>
      </p>
      <p class="lead">
        Tap a cue to audition the procedural arcane palette. Background music
        starts when the browser permits playback. Every sound is synthesised in
        the browser — no audio files.
      </p>
    </header>
    <section class="ambient-section" aria-labelledby="ambient-heading">
      <h2 id="ambient-heading">Backsound auditions</h2>
      <p class="cue-hint">
        Listen for a full phrase before switching. Background music is enabled
        automatically. Reduced motion keeps background music silent.
      </p>
      <div class="ambient-grid">
        <button
          class="cue"
          type="button"
          data-ambient="library"
          aria-pressed="false"
        >
          <span class="cue-label">Magical Library</span>
          <span class="cue-hint">
            Warm celesta, gentle harp and soft pads. Original 68 BPM
            composition.
          </span>
        </button>
        <button
          class="cue"
          type="button"
          data-ambient="castle"
          aria-pressed="false"
        >
          <span class="cue-label">Moonlit Castle</span>
          <span class="cue-hint">
            Sparse glass bells and darker pads. Original 64 BPM composition.
          </span>
        </button>
        <button
          class="cue"
          type="button"
          data-ambient="waltz"
          aria-pressed="true"
        >
          <span class="cue-label">Enchanted Castle Waltz</span>
          <span class="cue-hint">
            Mystery music box in 3/4, rising harp, soft strings and distant
            choir. Original 54-second composition.
          </span>
        </button>
      </div>
      <p class="cue-hint" id="ambient-status" role="status">
        Selected: Enchanted Castle Waltz. Tap a preset to start listening.
      </p>
    </section>
    <div class="cue-grid">
      {cues.map((cue) => (
        <button class="cue" type="button" data-cue={cue.id}>
          <span class="cue-label">{cue.label}</span>
          <span class="cue-hint">{cue.hint}</span>
        </button>
      ))}
    </div>
  </main>
</BaseLayout>
<style>
  .lab {
    min-height: 100svh;
    padding: 120px var(--page-gutter) 120px;
    background: radial-gradient(
        120% 80% at 20% 0%,
        #241046 0%,
        #0a0713 55%,
        #050507 100%
      )
      #050507;
    color: #ede8ff;
  }
  .lab > * {
    max-width: 1080px;
    margin-inline: auto;
  }
  .lab a {
    color: #cfc4e6;
    text-underline-offset: 4px;
  }
  .eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #9b7bff;
  }
  h1 {
    margin: 0;
    font: 400 64px/72px var(--font-heading);
  }
  .lead {
    max-width: 640px;
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 27px;
    color: #cfc4e6;
  }
  .cue-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 56px;
  }
  .ambient-section {
    margin-top: 48px;
  }
  .ambient-section h2 {
    font: 700 32px/40px var(--font-heading);
    margin: 0 0 16px;
  }
  .ambient-section p {
    margin: 16px 0;
  }
  .ambient-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .ambient-grid .cue {
    padding: 24px;
    border-radius: 24px;
  }
  .cue[aria-pressed='true'] {
    border-color: #9b7bff;
    background: rgb(155 123 255 / 12%);
  }
  .cue {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 24px;
    border: 1px solid rgb(203 197 255 / 30%);
    border-radius: 20px;
    background: rgb(255 255 255 / 5%);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.3s ease,
      background 0.3s ease;
  }
  .cue:hover,
  .cue:focus-visible {
    border-color: #9b7bff;
    background: rgb(155 123 255 / 12%);
  }
  .cue:focus-visible {
    outline: 2px solid #9b7bff;
    outline-offset: 3px;
  }
  .cue-label {
    font-size: 22px;
    font-weight: 600;
  }
  .cue-hint {
    font-size: 14px;
    line-height: 20px;
    color: #b6a8c6;
  }
  @media (max-width: 760px) {
    .lab {
      padding-block: 88px;
    }
    h1 {
      font-size: 40px;
      line-height: 48px;
    }
    .cue-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .ambient-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<script>
  import sound, { type Cue } from '../../scripts/sound';

  const initLab = () => {
    const status = document.querySelector('#ambient-status');
    if (status)
      status.textContent = `Selected: ${sound.ambientPreset === 'library' ? 'Magical Library' : sound.ambientPreset === 'castle' ? 'Moonlit Castle' : 'Enchanted Castle Waltz'}. Tap a preset to listen.`;
    document
      .querySelectorAll<HTMLButtonElement>('[data-ambient]')
      .forEach((el) => {
        el.setAttribute(
          'aria-pressed',
          String(el.dataset.ambient === sound.ambientPreset),
        );
        if (el.dataset.dsAmbientBound) return;
        el.dataset.dsAmbientBound = '1';
        el.addEventListener('click', () => {
          sound.unlock();
          window.dispatchEvent(
            new CustomEvent('ds:ambient', {
              detail: { profile: el.dataset.ambient },
            }),
          );
          document
            .querySelectorAll<HTMLButtonElement>('[data-ambient]')
            .forEach((button) => {
              button.setAttribute('aria-pressed', String(button === el));
            });
          const status = document.querySelector('#ambient-status');
          if (status)
            status.textContent = matchMedia('(prefers-reduced-motion: reduce)')
              .matches
              ? 'Background music is silent while reduced motion is enabled.'
              : `Selected: ${el.querySelector('.cue-label')?.textContent}. Listen for a full phrase.`;
        });
      });
    document.querySelectorAll<HTMLButtonElement>('[data-cue]').forEach((el) => {
      if (el.dataset.dsCueBound) return;
      el.dataset.dsCueBound = '1';
      el.addEventListener('click', () => {
        sound.unlock();
        sound.play((el.dataset.cue as Cue) ?? 'click');
      });
    });
  };

  document.addEventListener('astro:page-load', initLab);
</script>
