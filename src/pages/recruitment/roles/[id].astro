---
export const prerender = false;
import { getPageState } from '../../../data/site-visibility-registry.mjs';
import ArcaneChamber from '../../../components/ArcaneChamber.astro';
import Navbar from '../../../components/Navbar.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RoleDetail from '../../../components/RoleDetail.astro';
import { roles } from '../../../data/roles';

const role = roles.find((item) => item.id === Astro.params.id);
if (!role) return new Response('Not found', { status: 404 });
const pageId = 'role-' + role.id;
const enabled = getPageState(Astro.locals.visibility!, pageId);

const firstSentence = role.about.split(/(?<=\.)\s/)[0];
let description = firstSentence;
if (description.length > 160)
  description = description.slice(0, 157).trimEnd() + '…';
else if (description.length < 60)
  description = `${role.title} — open role at Data Sorcerers. See the role details, requirements and how to apply.`;

const site =
  Astro.site ?? new URL('https://data-sorcerers-community-sigma.vercel.app');
const roleUrl = new URL(`/recruitment/roles/${role.id}`, site).href;
const jobPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: role.title,
  description: `${role.about}\n\nKey Qualifications:\n${role.requirements.map((r) => `- ${r}`).join('\n')}`,
  identifier: {
    '@type': 'PropertyValue',
    name: 'Data Sorcerers',
    value: role.id,
  },
  datePosted: '2026-10-01',
  validThrough: '2026-10-20T23:59:59+07:00',
  employmentType: 'VOLUNTEER',
  hiringOrganization: {
    '@type': 'Organization',
    name: 'Data Sorcerers',
    sameAs: site.href,
    logo: new URL('/icon-512.png', site).href,
  },
  jobLocationType: 'TELECOMMUTE',
  applicantLocationRequirements: {
    '@type': 'Country',
    name: 'Indonesia',
  },
  url: roleUrl,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: site.href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Recruitment',
      item: new URL('/recruitment', site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: role.title,
      item: roleUrl,
    },
  ],
};
---

<BaseLayout
  title={`${role.title} — Open Role — Data Sorcerers`}
  description={description}
  type="article"
  structuredData={[jobPostingSchema, breadcrumbSchema]}
>
  {enabled ? (
    <RoleDetail role={role} />
  ) : (
    <>
      <Navbar active="Recruitment" />
      <main id="main">
        <ArcaneChamber pageId={pageId} />
      </main>
    </>
  )}
</BaseLayout>
