---
export const prerender = false;
import { getPageState } from '../../data/site-visibility-registry.mjs';
import ArcaneChamber from '../../components/ArcaneChamber.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import RecruitmentForm from '../../components/recruitment/RecruitmentForm.astro';
const enabled = getPageState(Astro.locals.visibility!, 'recruitment-apply');
---

<BaseLayout
  title="Apply — Data Sorcerers Open Recruitment"
  description="Bring your foundation. Build what comes next. Join Data Sorcerers and turn your curiosity into capability, research, and real-world impact."
>
  <Navbar active="Recruitment" />
  <main id="main">
    {enabled ? (
      <RecruitmentForm />
    ) : (
      <ArcaneChamber pageId="recruitment-apply" />
    )}
  </main>
  {enabled && <Footer />}
</BaseLayout>
