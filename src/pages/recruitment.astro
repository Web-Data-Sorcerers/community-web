---
export const prerender = false;
import {
  getPageState,
  getSectionState,
} from '../data/site-visibility-registry.mjs';
import ArcaneChamber from '../components/ArcaneChamber.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import RecruitmentHero from '../components/RecruitmentHero.astro';
import WhoShouldJoin from '../components/WhoShouldJoin.astro';
import WhatYouWillDo from '../components/WhatYouWillDo.astro';
import AvailableRoles from '../components/AvailableRoles.astro';
import SelectionTimeline from '../components/SelectionTimeline.astro';
import Faq from '../components/Faq.astro';
import Snippets from '../components/Snippets.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { faqItems } from '../data/faq';
import { getSiteOrigin, canonicalUrl } from '../data/site-url.mjs';
const enabled = getPageState(Astro.locals.visibility!, 'recruitment');
const visible = (section: string) =>
  getSectionState(Astro.locals.visibility!, 'recruitment', section);

const site = Astro.site ?? new URL(getSiteOrigin());
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: canonicalUrl('/', site),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Recruitment',
      item: canonicalUrl('/recruitment/', site),
    },
  ],
};
---

<BaseLayout
  title="Open Recruitment Komunitas AI 2026 | Data Sorcerers"
  description="Pendaftaran terbuka Data Sorcerers 2026. Bergabung dengan komunitas AI dan data di Indonesia melalui peran teknis, produk, dan manajemen komunitas."
  structuredData={enabled && visible('faq') ? [faqSchema, breadcrumbSchema] : [breadcrumbSchema]}
>
  <Navbar active="Recruitment" />
  {enabled ? (
    <main id="main">
      <RecruitmentHero />
      {visible('who-should-join') && <WhoShouldJoin />}
      {visible('what-you-will-do') && <WhatYouWillDo />}
      {visible('available-roles') && <AvailableRoles />}
      {visible('timeline') && <SelectionTimeline />}
      {visible('faq') && <Faq />}
      {visible('snippets') && <Snippets />}
      {visible('cta') && <Cta />}
    </main>
  ) : (
    <main id="main">
      <ArcaneChamber pageId="recruitment" />
    </main>
  )}
  {enabled && <Footer />}
  {enabled && <Motion />}
</BaseLayout>
