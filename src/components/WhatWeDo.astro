---
const pillars = [
  {
    number: '01',
    title: 'LEARNING',
    description:
      'Structured learning paths, workshops, and curated resources to build deep capability in AI and data.',
  },
  {
    number: '02',
    title: 'EXPERIMENTATION',
    description:
      'Rapid experimentation culture — test ideas, technologies, and approaches in a safe and collaborative environment.',
  },
  {
    number: '03',
    title: 'RESEARCH',
    description:
      'Conduct meaningful research, publish papers, and create new knowledge that advances the field of AI and data science.',
  },
  {
    number: '04',
    title: 'BUILD',
    description:
      'Turn ideas and research into production-grade projects, open-source tools, and real-world solutions that create impact.',
  },
];
---

<section id="what-we-do" class="what-we-do" aria-labelledby="pillars-title">
  <div class="pillars-layout">
    <div class="section-heading">
      <span class="eyebrow">What We Do</span>
      <h2 id="pillars-title">
        <span class="line">
          <span>Four Pillars</span>
        </span>
        <span class="line">
          <span>of Innovation</span>
        </span>
      </h2>
    </div>
    {pillars.map(({ number, title, description }) => (
      <article
        class:list={['pillar', `pillar-${number}`]}
        aria-labelledby={`pillar-${number}-title`}
      >
        <div class="pillar-inner">
          <img
            class="card-glow"
            src="/images/what-we-do/card-glow.svg"
            width="1231"
            height="357"
            alt=""
            loading="lazy"
          />
        </div>
        <div class="pillar-copy">
          <div class="pillar-heading">
            <span class="number">{number}</span>
            <h3 id={`pillar-${number}-title`}>{title}</h3>
          </div>
          <p>{description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .what-we-do {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background-color: #000;
    background-image: url('/images/starfield/starfield-base.png');
    background-repeat: repeat;
    background-size: 520px 440px;
    padding: 80px;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .what-we-do > .pillars-layout {
    width: 100%;
  }
  .what-we-do::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(
        580px 580px at 94% -18%,
        rgb(108 59 255 / 50%),
        transparent 78%
      ),
      radial-gradient(
        330px 330px at 50% 50%,
        rgb(108 59 255 / 44%) 0%,
        rgb(108 59 255 / 40%) 16%,
        rgb(108 59 255 / 30%) 34%,
        rgb(108 59 255 / 18%) 52%,
        rgb(108 59 255 / 8%) 70%,
        rgb(108 59 255 / 3%) 88%,
        transparent 100%
      );
    background-repeat: no-repeat;
  }
  .what-we-do::after {
    content: '';
    position: absolute;
    inset: -460px;
    z-index: -1;
    pointer-events: none;
    background-image: url('/images/starfield/starfield-far.png');
    background-repeat: repeat;
    background-size: 440px 360px;
    opacity: 0;
  }
  /* Star layers are hidden in the base state (`opacity: 0`) so that under
     `prefers-reduced-motion: reduce` the section stays pixel-identical to the
     reference PNG. The living sky is opt-in inside the `no-preference` media
     query below: only `transform`/`opacity` animate (compositor), and each star
     layer drifts one full background tile per loop so the wrap is seamless. The
     layer `inset` is kept larger than its tile so the sliding box always covers
     the section. The mid layer stays disabled (two drifting layers + glow keep
     the compositing cost low). The base, far and near layers are rasterised
     once into periodic tiles by `npm run assets:starfield`; the page blits a
     small repeating texture instead of re-evaluating dozens of radial-gradients
     while the huge layers raster. */
  .pillars-layout::before {
    content: '';
    position: absolute;
    inset: -160px;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(
        2px 2px at 60px 70px,
        rgb(255 255 255 / 95%),
        transparent 66%
      ),
      radial-gradient(
        1.6px 1.6px at 220px 40px,
        rgb(255 255 255 / 80%),
        transparent 66%
      ),
      radial-gradient(
        2.4px 2.4px at 400px 120px,
        rgb(255 255 255 / 92%),
        rgb(155 123 255 / 20%) 46%,
        transparent 72%
      ),
      radial-gradient(
        1.8px 1.8px at 120px 250px,
        rgb(255 255 255 / 100%),
        transparent 66%
      ),
      radial-gradient(
        2px 2px at 330px 300px,
        rgb(237 232 255 / 90%),
        transparent 66%
      ),
      radial-gradient(
        1.6px 1.6px at 460px 360px,
        rgb(255 255 255 / 78%),
        transparent 66%
      ),
      radial-gradient(
        2.2px 2.2px at 40px 340px,
        rgb(255 255 255 / 88%),
        rgb(155 123 255 / 22%) 46%,
        transparent 72%
      ),
      radial-gradient(
        1.4px 1.4px at 260px 200px,
        rgb(255 255 255 / 100%),
        transparent 66%
      ),
      radial-gradient(
        1.6px 1.6px at 180px 150px,
        rgb(255 255 255 / 70%),
        transparent 66%
      ),
      radial-gradient(
        1.8px 1.8px at 430px 220px,
        rgb(255 255 255 / 96%),
        transparent 66%
      ),
      radial-gradient(
        1.4px 1.4px at 80px 180px,
        rgb(255 255 255 / 85%),
        transparent 66%
      ),
      radial-gradient(
        1.6px 1.6px at 360px 60px,
        rgb(255 255 255 / 92%),
        transparent 66%
      );
    background-size: 320px 270px;
    opacity: 0;
  }
  .pillars-layout::after {
    content: '';
    position: absolute;
    inset: -540px;
    z-index: -1;
    pointer-events: none;
    background-image: url('/images/starfield/starfield-near.png');
    background-repeat: repeat;
    background-size: 520px 400px;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .what-we-do::before {
      animation: wwd-glow-breathe 11s ease-in-out infinite alternate;
    }
    /* One full background tile per loop, linear → seamless outer-space drift. */
    .what-we-do::after {
      opacity: 0.8;
      animation: wwd-drift-far 12s linear infinite;
    }
    .pillars-layout::after {
      opacity: 0.85;
      animation: wwd-drift-near 7s linear infinite;
    }
    /* Promote the oversized layers only while the section is near the viewport. */
    /* Off-screen (`is-idle`) they keep no compositor layer or resident texture. */
    .what-we-do:not(.is-idle)::before {
      will-change: opacity;
    }
    .what-we-do:not(.is-idle)::after,
    .what-we-do:not(.is-idle) .pillars-layout::after {
      will-change: transform;
    }
    /* motion.ts toggles `is-idle` while the section is off-screen. */
    .what-we-do.is-idle::before,
    .what-we-do.is-idle::after,
    .what-we-do.is-idle .pillars-layout::after {
      animation-play-state: paused;
    }
  }
  @keyframes wwd-glow-breathe {
    from {
      opacity: 0.86;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes wwd-drift-far {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-440px, -360px, 0);
    }
  }
  @keyframes wwd-drift-near {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-520px, -400px, 0);
    }
  }
  .pillars-layout {
    position: relative;
    display: grid;
    grid-template-columns: 391px 1fr 391px;
    grid-template-rows: 254px 172px 254px;
    max-width: 1280px;
    margin-inline: auto;
  }
  .section-heading {
    position: relative;
    isolation: isolate;
    grid-area: 2 / 1 / 3 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-inline: 0;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    width: 84px;
    padding: 4px 8px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 40%);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    color: #fff;
    white-space: nowrap;
  }
  h2 {
    margin: 1px 0 0 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67.2px;
    letter-spacing: 0;
    text-align: center;
    color: transparent;
  }
  h2 span {
    display: block;
  }
  h2 > .line {
    overflow: hidden;
    height: 67px;
  }
  /* Gradient lives on the line's inner span (not the h2) so the `.line` overflow
     clip actually masks it during the reveal — `background-clip: text` on the h2
     paints outside a descendant's clip otherwise. */
  h2 > .line > span {
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }
  .pillar {
    position: relative;
    isolation: isolate;
    height: 254px;
    width: 391px;
    border-radius: 20px 0;
    background: rgb(255 255 255 / 15%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* The clipping lives on this untransformed wrapper: `.pillar` carries the 3-D
     tilt, and `overflow:hidden` + radius + a transform on the same element
     renders square corners. */
  .pillar-inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }
  .pillar::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(135deg, #e0dcff 0%, #2e276c 50%, #cbc5ff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .pillar-01 {
    grid-area: 1 / 1;
    width: 391px;
  }
  .pillar-02 {
    grid-area: 1 / 3;
    justify-self: end;
    width: 391px;
  }
  .pillar-03 {
    grid-area: 3 / 1;
    width: 391px;
  }
  .pillar-04 {
    grid-area: 3 / 3;
    justify-self: end;
    width: 391px;
  }
  .pillar-copy {
    position: relative;
    z-index: 2;
    width: 325px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }
  .pillar-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .number {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #ede8ff;
  }
  h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 26px;
    font-weight: 700;
    line-height: 39px;
    letter-spacing: 0;
    color: #ffffff;
    white-space: nowrap;
  }
  p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #ffffff;
  }
  .card-glow {
    position: absolute;
    left: -237.4px;
    top: 101.6px;
    width: 1230.8px;
    height: 357px;
    max-width: none;
    pointer-events: none;
  }
  .pillar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: radial-gradient(
      240px 240px at var(--mx, 50%) var(--my, 50%),
      rgb(155 123 255 / 32%),
      rgb(108 59 255 / 12%) 46%,
      transparent 72%
    );
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pillar {
      transition: box-shadow 0.5s ease;
    }
    .pillar::before {
      transition: opacity 0.45s ease;
    }
    .card-glow {
      transition:
        filter 0.5s ease,
        transform 0.5s ease;
    }
  }
  @media (hover: hover) {
    .pillar:hover {
      box-shadow:
        0 30px 70px -28px rgb(108 59 255 / 75%),
        inset 0 0 0 1px rgb(155 123 255 / 35%);
    }
    .pillar:hover::before {
      opacity: 1;
    }
    .pillar:hover::after {
      filter: brightness(1.5);
    }
    .pillar:hover .card-glow {
      filter: brightness(1.4) saturate(1.15);
      transform: scale(1.04);
    }
  }
  @media (min-width: 761px) and (max-width: 1279px) {
    .what-we-do {
      padding: 64px var(--page-gutter);
    }
    .pillars-layout {
      grid-template-columns: 1fr 32px 1fr;
      grid-template-rows: auto 172px auto;
    }
    .pillar {
      width: 100%;
      max-width: 391px;
    }
    .pillar-04 {
      justify-self: end;
    }
    .pillar-copy {
      width: calc(100% - 40px);
    }
    h3 {
      font-size: clamp(20px, 2.2vw, 26px);
      line-height: 1.3;
    }
    p {
      font-size: 15px;
    }
    .section-heading {
      margin-inline: 0;
    }
    h2 {
      font-size: clamp(38px, 4vw, 56px);
      line-height: 1.2;
    }
    h2 > .line {
      height: auto;
    }
    h2 > .line > span {
      white-space: normal;
    }
  }
  @media (max-width: 760px) {
    .what-we-do {
      padding: 64px var(--page-gutter);
    }
    .pillars-layout {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
    .section-heading {
      margin: 0 0 16px;
      width: 100%;
    }
    h2 {
      font-size: clamp(28px, 6.5vw, 44px);
      line-height: 1.2;
    }
    h2 > .line {
      height: auto;
    }
    h2 > .line > span {
      white-space: normal;
    }
    .pillar {
      width: min(100%, 391px);
    }
    .pillar-copy {
      width: calc(100% - 36px);
    }
    h3 {
      font-size: clamp(20px, 5.6vw, 24px);
      line-height: 1.3;
    }
    p {
      font-size: 15px;
    }
  }
  @media (max-width: 767px), (pointer: coarse) {
    .what-we-do::before,
    .what-we-do::after,
    .pillars-layout::after {
      animation: none;
    }
    .what-we-do:not(.is-idle)::before,
    .what-we-do:not(.is-idle)::after,
    .what-we-do:not(.is-idle) .pillars-layout::after {
      will-change: auto;
    }
    .what-we-do::after,
    .pillars-layout::after {
      inset: 0;
    }
  }
</style>
