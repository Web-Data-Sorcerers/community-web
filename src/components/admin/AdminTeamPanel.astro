---
// AdminTeamPanel — markup existing dari /admin/team/ page, dipindah apa adanya
---
<section data-panel="team" id="panel-team" hidden>
  <header>
    <img
      class="brand-logo"
      src="/images/logo.png"
      alt="Data Sorcerers"
      width="48"
      height="52"
    />
    <p class="brand">Data Sorcerers &middot; Editor</p>
    <h1>Kelola Team</h1>
    <p>
      Pilih anggota, ubah isinya, lalu simpan. Situs diperbarui setelah
      proses penerbitan selesai.
    </p>
    <div class="auth-actions">
      <form id="login-form" class="login-form" hidden>
        <label>
          Email
          <input
            id="login-email"
            type="email"
            autocomplete="username"
            required
          />
        </label>
        <label>
          Kata sandi
          <input
            id="login-password"
            type="password"
            autocomplete="current-password"
            required
          />
        </label>
        <button class="primary" id="login-submit" type="submit">
          Masuk
        </button>
      </form>
      <button id="login" type="button" class="login-link" hidden>
        Masuk
      </button>
      <button id="logout" type="button" hidden>
        Keluar
      </button>
      <a href="/">Kembali ke situs</a>
    </div>
  </header>
  <p id="status" role="status" aria-live="polite">
    Memeriksa akses&hellip;
  </p>
  <button id="retry" type="button" hidden>
    Coba terbitkan lagi
  </button>
  <button id="reload" type="button" hidden>
    Muat ulang Team
  </button>
  <div class="layout" id="workspace" hidden>
    <nav aria-label="Daftar anggota">
      <h2>Team</h2>
      <button id="add" type="button">
        Tambah anggota
      </button>
      <div id="project-list"></div>
    </nav>
    <section class="editor" aria-labelledby="editor-title">
      <h2 id="editor-title">Isi anggota</h2>
      <form id="project-form">
        <fieldset
          id="fields"
          style="
            border: 0;
            padding: 0;
            margin: 0;
            min-width: 0;
            display: grid;
            gap: 16px;
          "
        >
          <label>
            Grup<select id="group" required></select>
          </label>
          <label>
            Nama anggota
            <input id="name" required maxlength="80" />
          </label>
          <label>
            Peran
            <input id="role" required maxlength="80" />
          </label>
          <label>
            Posisi dalam grup
            <input
              id="order"
              type="number"
              min="1"
              max="8"
              step="1"
              required
            />
          </label>
          <p class="hint">
            Posisi baru menggeser anggota lain dalam grup. Setiap grup
            memuat 1&ndash;8 anggota. Nama dan peran panjang disingkat pada kartu
            situs.
          </p>
          <label>
            Foto anggota<select id="image" required></select>
          </label>
          <label>
            Upload foto
            <input
              id="image-upload"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              aria-describedby="image-hint"
            />
          </label>
          <p class="hint" id="image-hint">
            Pilih JPG, PNG atau WebP, maksimal 2 MB. Gambar terbit setelah
            anggota disimpan.
          </p>
          <img
            id="image-preview"
            alt="Preview foto anggota"
            hidden
            style="width: 100%; max-height: 240px; object-fit: contain;"
          />
          <div class="actions">
            <button class="primary" id="save" type="submit">
              Simpan dan terbitkan
            </button>
            <button id="delete" type="button">
              Hapus anggota
            </button>
          </div>
        </fieldset>
      </form>
    </section>
  </div>
</section>
