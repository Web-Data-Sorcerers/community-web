---
// AdminProjectsPanel — markup existing dari /admin/ page, dipindah apa adanya
---

<section data-panel="projects" id="panel-projects" hidden>
  <div
    id="projects-toast-container"
    class="admin-toast-container"
    aria-live="polite"
  ></div>
  <header>
    <img
      class="brand-logo"
      src="/images/logo.png"
      alt="Data Sorcerers"
      width="48"
      height="52"
    />
    <p class="brand">Data Sorcerers &middot; Editor</p>
    <h1>Kelola projects</h1>
    <p>
      Pilih project, ubah isinya, lalu simpan. Situs diperbarui setelah proses
      penerbitan selesai.
    </p>
    <div class="auth-actions">
      <form id="login-form" class="login-form" hidden>
        <label>
          Email
          <input
            id="login-email"
            type="email"
            autocomplete="username"
            required
          />
        </label>
        <label>
          Kata sandi
          <input
            id="login-password"
            type="password"
            autocomplete="current-password"
            required
          />
        </label>
        <button class="primary" id="login-submit" type="submit">
          Masuk
        </button>
      </form>
      <button id="login" type="button" class="login-link" hidden>
        Masuk
      </button>
      <button id="logout" type="button" hidden>
        Keluar
      </button>
      <a href="/">Kembali ke situs</a>
    </div>
  </header>
  <p id="status" role="status" aria-live="polite">
    Memeriksa akses&hellip;
  </p>
  <button id="retry" type="button" hidden>
    Coba terbitkan lagi
  </button>
  <button id="reload" type="button" hidden>
    Muat ulang projects
  </button>
  <div class="layout" id="workspace" hidden>
    <nav aria-label="Daftar project">
      <h2>Projects</h2>
      <button id="add" type="button">
        Tambah project
      </button>
      <div id="project-list"></div>
    </nav>
    <section class="editor" aria-labelledby="editor-title">
      <h2 id="editor-title">Isi project</h2>
      <form id="project-form">
        <fieldset
          id="fields"
          style="
            border: 0;
            padding: 0;
            margin: 0;
            min-width: 0;
            display: grid;
            gap: 16px;
          "
        >
          <label>
            Judul project
            <input id="title" required maxlength="20000" />
          </label>
          <label>
            Deskripsi
            <textarea id="description" required maxlength="20000"></textarea>
          </label>
          <p class="hint">
            Gunakan judul dan deskripsi singkat agar nyaman dibaca di kartu
            situs.
          </p>
          <div class="tags">
            <label>
              Kategori pertama
              <input id="tag-one" required maxlength="20000" />
            </label>
            <label>
              Kategori kedua
              <input id="tag-two" required maxlength="20000" />
            </label>
          </div>
          <label>
            Gambar project<select id="image" required></select>
          </label>
          <label>
            Upload gambar
            <input
              id="image-upload"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              aria-describedby="image-hint"
            />
          </label>
          <p class="hint" id="image-hint">
            Pilih JPG, PNG atau WebP, maksimal 2 MB. Gambar terbit setelah
            project disimpan.
          </p>
          <img
            id="image-preview"
            alt="Preview gambar project"
            hidden
            style="width: 100%; max-height: 240px; object-fit: contain;"
          />
          <div class="actions">
            <button class="primary" id="save" type="submit">
              Simpan dan terbitkan
            </button>
            <button id="delete" type="button">
              Hapus project
            </button>
          </div>
        </fieldset>
      </form>
    </section>
  </div>
</section>

<style is:global>
  header {
    background: linear-gradient(
      180deg,
      rgba(20, 17, 34, 0.8) 0%,
      rgba(13, 11, 22, 0.5) 100%
    );
    border: 1px solid var(--border-glass);
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 32px;
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  h1 {
    margin: 0 0 12px;
    font: 700 36px/1.2 var(--font-display);
    color: #ffffff;
    letter-spacing: 0.5px;
    text-shadow: 0 0 24px rgba(155, 123, 255, 0.2);
  }
  h2 {
    margin: 0 0 16px;
    font: 700 22px/1.25 var(--font-display);
    color: #ffffff;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  header p:not(.brand) {
    max-width: 700px;
    line-height: 1.6;
    color: #b5b0c4;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: #c4b5fd;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(0, 2.4fr);
    gap: 32px;
    align-items: start;
  }
  nav[aria-label='Daftar project'] {
    background: linear-gradient(180deg, #131020 0%, #0d0b16 100%);
    border: 1px solid var(--border-glass);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .editor {
    padding: 32px;
    background: linear-gradient(180deg, #151124 0%, #0e0c18 100%);
    border: 1px solid var(--border-glass);
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  #add {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(155, 123, 255, 0.1);
    border: 1px dashed rgba(155, 123, 255, 0.4);
    color: #c4b5fd;
    border-radius: 10px;
    padding: 12px;
    font-weight: 600;
    margin-bottom: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  #add:hover:not(:disabled) {
    background: rgba(155, 123, 255, 0.2);
    border-color: #9b7bff;
    color: #ffffff;
    box-shadow: 0 0 16px rgba(155, 123, 255, 0.25);
  }
  #project-list {
    display: grid;
    gap: 8px;
  }
  button,
  input,
  textarea,
  select {
    font: inherit;
  }
  button {
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 10px;
    padding: 10px 18px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  button:hover:not(:disabled) {
    background: rgba(155, 123, 255, 0.12);
    border-color: rgba(155, 123, 255, 0.4);
    color: #ffffff;
  }
  button:disabled {
    cursor: wait;
    opacity: 0.55;
  }
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .project-choice {
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(10, 8, 16, 0.6);
    color: #bcb7cb;
    font-size: 14px;
    font-weight: 500;
    overflow-wrap: anywhere;
    transition: all 0.2s ease;
  }
  .project-choice:hover:not(:disabled) {
    background: rgba(155, 123, 255, 0.08);
    border-color: rgba(155, 123, 255, 0.24);
    color: #ffffff;
  }
  .project-choice[aria-current='true'] {
    border-color: var(--accent);
    background: linear-gradient(
      135deg,
      rgba(155, 123, 255, 0.22) 0%,
      rgba(124, 92, 252, 0.12) 100%
    );
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 0 16px rgba(155, 123, 255, 0.2);
  }
  .primary {
    background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
    color: #ffffff;
    border: 1px solid rgba(155, 123, 255, 0.4);
    font-weight: 700;
    padding: 12px 24px;
    box-shadow: 0 4px 18px rgba(155, 123, 255, 0.35);
    border-radius: 10px;
  }
  .primary:hover:not(:disabled) {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(155, 123, 255, 0.45);
    color: #ffffff;
  }
  .primary:active:not(:disabled) {
    transform: translateY(0);
  }
  form {
    display: grid;
    gap: 20px;
  }
  label {
    display: grid;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #c4b5fd;
    letter-spacing: 0.3px;
  }
  input,
  textarea,
  select {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 10px;
    padding: 12px 16px;
    color: var(--text);
    background: #08060f;
    transition: all 0.2s ease;
  }
  input:focus,
  textarea:focus,
  select:focus {
    border-color: var(--accent);
    outline: none;
    box-shadow: 0 0 0 3px rgba(155, 123, 255, 0.22);
    background: #0d0a17;
  }
  textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.6;
  }
  .tags {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  #delete {
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fda4af;
    background: rgba(244, 63, 94, 0.06);
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 600;
  }
  #delete:hover:not(:disabled) {
    background: rgba(244, 63, 94, 0.16);
    border-color: #f43f5e;
    color: #ffffff;
  }
  #status {
    padding: 14px 20px;
    background: rgba(155, 123, 255, 0.08);
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 12px;
    color: #ddd6fe;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }
  #status[data-error='true'] {
    background: rgba(244, 63, 94, 0.1);
    border-color: rgba(244, 63, 94, 0.3);
    color: #fecdd3;
  }
  #retry,
  #reload {
    margin-top: 0;
    margin-bottom: 16px;
    padding: 10px 18px;
    border-radius: 10px;
    background: rgba(155, 123, 255, 0.1);
    border: 1px solid rgba(155, 123, 255, 0.3);
    color: #c4b5fd;
    font-weight: 600;
  }
  #retry:hover:not(:disabled),
  #reload:hover:not(:disabled) {
    background: rgba(155, 123, 255, 0.2);
    color: #ffffff;
  }
  .hint {
    font-size: 13px;
    color: #8e889f;
    line-height: 1.5;
  }
  #image-upload {
    padding: 10px;
    background: rgba(155, 123, 255, 0.04);
    border: 1px dashed rgba(155, 123, 255, 0.3);
    cursor: pointer;
  }
  #image-upload:hover {
    border-color: var(--accent);
    background: rgba(155, 123, 255, 0.08);
  }
  #image-preview {
    border-radius: 12px;
    border: 1px solid rgba(155, 123, 255, 0.2);
    background: #07050b;
    padding: 8px;
  }
  [hidden] {
    display: none !important;
  }
  .auth-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .login-link {
    display: inline-block;
    padding: 10px 20px;
    background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
    color: #ffffff;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(155, 123, 255, 0.35);
  }
  .login-form {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    flex-wrap: wrap;
    padding: 16px 20px;
    background: rgba(10, 8, 16, 0.85);
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 14px;
  }
  .login-form label {
    font-size: 12px;
    font-weight: 600;
    color: #bcb7cb;
    gap: 6px;
  }
  .login-form input {
    padding: 8px 12px;
    min-height: 40px;
    border-radius: 8px;
    background: #050408;
  }
  .login-form .primary {
    min-height: 40px;
    padding: 8px 20px;
    justify-self: start;
  }
  #logout {
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fda4af;
    background: rgba(244, 63, 94, 0.06);
    border-radius: 8px;
    padding: 8px 16px;
  }
  #logout:hover {
    background: rgba(244, 63, 94, 0.16);
    border-color: #f43f5e;
    color: #ffffff;
  }
  .auth-actions a {
    color: #a8a3b8;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  .auth-actions a:hover {
    color: #ffffff;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .brand-logo {
    width: 48px;
    height: auto;
    margin-bottom: 16px;
    filter: drop-shadow(0 0 12px rgba(155, 123, 255, 0.4));
  }
  @media (max-width: 768px) {
    main {
      padding: 16px 12px;
    }
    header {
      padding: 20px 16px;
      border-radius: 14px;
    }
    h1 {
      font-size: 28px;
    }
    .layout {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .editor {
      padding: 20px 16px;
      border-radius: 14px;
    }
    .tags {
      grid-template-columns: 1fr;
    }
    .login-form {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* --- Button Loading Spinner --- */
  .btn-spinner {
    display: inline-block;
    width: 13px;
    height: 13px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spinArcane 0.7s linear infinite;
    vertical-align: middle;
    margin-right: 6px;
  }
  @keyframes spinArcane {
    to {
      transform: rotate(360deg);
    }
  }
  button.is-loading {
    opacity: 0.85;
    cursor: wait !important;
    pointer-events: none;
  }

  /* --- Toast Notification System --- */
  .admin-toast-container {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
    max-width: calc(100vw - 32px);
    width: 360px;
    box-sizing: border-box;
  }
  .admin-toast {
    box-sizing: border-box;
    max-width: 100%;
    pointer-events: auto;
    padding: 12px 16px;
    border-radius: 14px;
    background: rgba(18, 14, 30, 0.94);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(155, 123, 255, 0.25);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #e2dff0;
    font-size: 13px;
    line-height: 1.5;
    animation: toastSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .admin-toast.toast-closing {
    opacity: 0;
    transform: translateX(30px);
  }
  @keyframes toastSlideIn {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .toast-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
  }
  .admin-toast.toast-success .toast-dot {
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }
  .admin-toast.toast-error .toast-dot {
    background: #f43f5e;
    box-shadow: 0 0 8px #f43f5e;
  }
  .admin-toast.toast-warning .toast-dot {
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
  }
  .admin-toast.toast-info .toast-dot {
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }
  .toast-content {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .toast-title {
    font-weight: 700;
    font-size: 13px;
    color: #ffffff;
    margin-bottom: 2px;
  }
  .toast-desc {
    color: #bcb7cb;
    font-size: 12px;
    line-height: 1.4;
  }
  .toast-close {
    background: none;
    border: 0;
    color: #948fa3;
    padding: 2px 4px;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    border-radius: 4px;
    transition: color 0.15s;
    flex-shrink: 0;
  }
  .toast-close:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }
  .admin-toast.toast-success {
    border-color: rgba(16, 185, 129, 0.45);
    box-shadow: 0 4px 24px rgba(16, 185, 129, 0.2);
  }
  .admin-toast.toast-success .toast-title {
    color: #34d399;
  }
  .admin-toast.toast-error {
    border-color: rgba(244, 63, 94, 0.45);
    box-shadow: 0 4px 24px rgba(244, 63, 94, 0.2);
  }
  .admin-toast.toast-error .toast-title {
    color: #fb7185;
  }
  .admin-toast.toast-warning {
    border-color: rgba(245, 158, 11, 0.45);
    box-shadow: 0 4px 24px rgba(245, 158, 11, 0.2);
  }
  .admin-toast.toast-warning .toast-title {
    color: #fbbf24;
  }
  .admin-toast.toast-info {
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 4px 24px rgba(56, 189, 248, 0.2);
  }
  .admin-toast.toast-info .toast-title {
    color: #38bdf8;
  }
</style>
