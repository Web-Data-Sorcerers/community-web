---
// AdminRecruitmentPanel — markup existing dari /admin/recruitment/ page, dipindah apa adanya
---

<section data-panel="recruitment" id="panel-recruitment" hidden>
  <div
    id="recruitment-toast-container"
    class="admin-toast-container"
    aria-live="polite"
  ></div>
  <header>
    <p class="brand">Data Sorcerers &middot; Admin</p>
    <h1>Pendaftaran</h1>
    <p>
      Tinjau pendaftar recruitment, filter berdasarkan domain atau kata kunci.
    </p>
    <div class="auth-links">
      <form id="login-form" class="login-form" hidden>
        <label>
          Email
          <input
            id="login-email"
            type="email"
            name="email"
            autocomplete="username"
            required
          />
        </label>
        <label>
          Password
          <input
            id="login-password"
            type="password"
            name="password"
            autocomplete="current-password"
            required
          />
        </label>
        <button id="login-submit" class="primary" type="submit">
          Masuk
        </button>
      </form>
      <button id="logout" type="button" hidden>
        Keluar
      </button>
      <a href="/">Kembali ke situs</a>
    </div>
  </header>
  <p id="status" role="status" aria-live="polite">
    Memeriksa akses&hellip;
  </p>
  <div id="workspace" hidden>
    <p id="intake-status" style="margin-bottom: 24px" role="status">
      Memeriksa status pendaftaran&hellip;
    </p>
    <div class="stats-overview-wrapper">
      <div class="stats-grid" id="stats"></div>
      <div id="analytics-visuals" class="analytics-visuals" hidden>
        <div class="analytics-card" id="card-domain-distribution">
          <div class="analytics-card-header">
            <div class="analytics-title-group">
              <svg
                class="analytics-badge-icon"
                viewBox="0 0 20 20"
                fill="none"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <path
                  d="M3 17V10M8 17V4M13 17V7M18 17V13"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                ></path>
              </svg>
              <h3>Distribusi Domain</h3>
            </div>
            <span class="analytics-count-badge" id="domain-stats-total">
              0 pendaftar
            </span>
          </div>
          <div class="domain-chart-layout">
            <div class="domain-donut-container" id="domain-donut"></div>
            <div class="domain-bars-container" id="domain-bars"></div>
          </div>
        </div>
        <div class="analytics-card" id="card-funnel-pipeline">
          <div class="analytics-card-header">
            <div class="analytics-title-group">
              <svg
                class="analytics-badge-icon"
                viewBox="0 0 20 20"
                fill="none"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <path
                  d="M2 4H18L12 11V16L8 14V11L2 4Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              <h3>Pipeline Alur Seleksi</h3>
            </div>
            <span class="analytics-count-badge" id="pipeline-stats-conversion">
              Tahapan
            </span>
          </div>
          <div class="pipeline-chart-layout">
            <div class="pipeline-chart-container" id="pipeline-chart"></div>
            <div class="pipeline-funnel-container" id="pipeline-funnel"></div>
          </div>
        </div>
      </div>
    </div>
    <form id="filter-form" class="search-bar">
      <label>
        Nama atau email
        <input
          id="search"
          type="search"
          maxlength="400"
          placeholder="Cari nama atau email&hellip;"
        />
      </label>
      <label>
        Domain
        <select id="filter-hods">
          <option value="">Semua domain</option>
        </select>
      </label>
      <label>
        Status
        <select id="filter-status">
          <option value="">Semua status</option>
        </select>
      </label>
      <label>
        Tanggal mulai (WIB)
        <input id="filter-since" type="date" />
      </label>
      <label>
        Tanggal akhir (WIB)
        <input id="filter-until" type="date" />
      </label>
      <label>
        Urutan
        <select id="filter-sort">
          <option value="received_at_desc">Terbaru</option>
          <option value="received_at_asc">Terlama</option>
        </select>
      </label>
      <div class="actions">
        <button id="filter-btn" class="primary" type="submit">
          Cari
        </button>
        <button id="reset-filter" type="button">
          Reset filter
        </button>
        <button id="reload-list" type="button">
          Muat ulang daftar
        </button>
      </div>
    </form>
    <p id="stats-scope">
      Ringkasan status dan domain mengikuti filter. Tanggal menggunakan WIB.
    </p>
    <p id="list-error" role="status" aria-live="polite"></p>
    <div
      id="table-wrapper"
      tabindex="0"
      role="region"
      aria-label="Daftar pendaftar, geser untuk melihat seluruh kolom"
    >
      <table>
        <thead>
          <tr>
            <th>Nama</th>
            <th>Email</th>
            <th>Domain</th>
            <th>Tanggal</th>
            <th>Status</th>
            <th>Catatan</th>
            <th class="col-action">Aksi</th>
          </tr>
        </thead>
        <tbody id="applications-body"></tbody>
      </table>
    </div>
    <div class="pagination" id="pagination" hidden>
      <button id="prev-page" type="button">
        &larr; Sebelumnya
      </button>
      <span id="page-info"></span>
      <button id="next-page" type="button">
        Selanjutnya &rarr;
      </button>
    </div>
    <div id="detail-area" hidden>
      <div class="detail-header-bar">
        <button id="back-list-top" class="btn-back-top" type="button">
          &larr; Kembali ke daftar
        </button>
        <h2 id="detail-heading" tabindex="-1">
          Detail pendaftar
        </h2>
      </div>
      <div id="detail-summary" class="review-block"></div>
      <div class="detail-workspace-layout">
        <aside class="detail-sidebar">
          <section class="review-block" aria-labelledby="selection-heading">
            <h2 id="selection-heading">Seleksi internal</h2>
            <p>Status ini tidak mengirim pesan atau menambah anggota Team.</p>
            <p id="review-meta"></p>
            <form id="status-form">
              <label>
                Status tujuan<select id="review-status" required></select>
              </label>
              <label>
                Alasan
                <textarea
                  id="review-reason"
                  rows="3"
                  aria-describedby="reason-help"
                ></textarea>
              </label>
              <p id="reason-help">
                Maksimum 500 karakter. Keputusan akhir dan pembukaan kembali
                wajib alasan minimal 10 karakter.
              </p>
              <label id="decision-confirm" hidden>
                <input id="confirm-status" type="checkbox" />
                <span id="confirm-label"></span>
              </label>
              <button id="save-status" type="submit" class="primary">
                Simpan status
              </button>
            </form>
          </section>
          <p
            id="review-feedback"
            role="status"
            aria-live="polite"
            tabindex="-1"
          ></p>
          <div class="actions">
            <button id="retry-mutation" type="button" hidden>
              Coba kiriman yang sama
            </button>
            <button id="reload-detail" type="button">
              Muat detail terbaru
            </button>
          </div>
          <section class="review-block" aria-labelledby="notes-heading">
            <h2 id="notes-heading">Catatan internal</h2>
            <p>
              Koreksi ditulis sebagai catatan baru. Catatan yang tersimpan tidak
              dapat diedit atau dihapus.
            </p>
            <form id="note-form">
              <label>
                Catatan
                <textarea
                  id="review-note"
                  rows="5"
                  aria-describedby="note-help"
                  required
                ></textarea>
              </label>
              <p id="note-help">1&ndash;4000 karakter, maksimum 16 KiB.</p>
              <button id="save-note" type="submit" class="primary">
                Tambah catatan
              </button>
            </form>
            <div id="notes-list" class="detail-panel"></div>
            <div class="actions">
              <button id="notes-prev" type="button">
                Catatan sebelumnya
              </button>
              <span id="notes-page"></span>
              <button id="notes-next" type="button">
                Catatan selanjutnya
              </button>
            </div>
          </section>
          <section class="review-block" aria-labelledby="history-heading">
            <h2 id="history-heading">Aktivitas</h2>
            <div id="history-list" class="detail-panel"></div>
            <div class="actions">
              <button id="history-prev" type="button">
                Aktivitas sebelumnya
              </button>
              <span id="history-page"></span>
              <button id="history-next" type="button">
                Aktivitas selanjutnya
              </button>
            </div>
          </section>
        </aside>
        <main class="detail-main-pane">
          <div class="form-answers-header">
            <h2>Jawaban formulir</h2>
          </div>
          <div id="detail-panel" class="detail-panel"></div>
        </main>
      </div>
      <button id="back-list" type="button">
        Kembali ke daftar
      </button>
    </div>
  </div>
</section>

<style is:global>
  header {
    background: linear-gradient(
      180deg,
      rgba(20, 17, 34, 0.8) 0%,
      rgba(13, 11, 22, 0.5) 100%
    );
    border: 1px solid var(--border-glass);
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 32px;
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  h1 {
    margin: 0 0 12px;
    font: 700 36px/1.2 var(--font-display);
    color: #ffffff;
    letter-spacing: 0.5px;
    text-shadow: 0 0 24px rgba(155, 123, 255, 0.2);
  }
  h2 {
    margin: 0 0 16px;
    font: 700 22px/1.25 var(--font-display);
    color: #ffffff;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  header p:not(.brand) {
    max-width: 700px;
    line-height: 1.6;
    color: #b5b0c4;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: #c4b5fd;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  button,
  input,
  select,
  textarea {
    font: inherit;
  }
  button {
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 10px;
    padding: 10px 18px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  button:hover:not(:disabled) {
    background: rgba(155, 123, 255, 0.12);
    border-color: rgba(155, 123, 255, 0.4);
    color: #ffffff;
  }
  button:disabled {
    opacity: 0.55;
    cursor: default;
  }
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .primary {
    background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
    color: #ffffff;
    border: 1px solid rgba(155, 123, 255, 0.4);
    font-weight: 700;
    padding: 12px 24px;
    box-shadow: 0 4px 18px rgba(155, 123, 255, 0.35);
    border-radius: 10px;
  }
  .primary:hover:not(:disabled) {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(155, 123, 255, 0.45);
    color: #ffffff;
  }
  .primary:active:not(:disabled) {
    transform: translateY(0);
  }
  .auth-links {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .login-link {
    display: inline-block;
    padding: 10px 20px;
    background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
    color: #ffffff;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(155, 123, 255, 0.35);
  }
  .login-form {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    flex-wrap: wrap;
    padding: 16px 20px;
    background: rgba(10, 8, 16, 0.85);
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 14px;
  }
  .login-form label {
    display: grid;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #bcb7cb;
  }
  .login-form input {
    padding: 8px 12px;
    min-height: 40px;
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 8px;
    background: #050408;
    color: var(--text);
  }
  .login-form .primary {
    min-height: 40px;
    padding: 8px 20px;
  }
  #logout {
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fda4af;
    background: rgba(244, 63, 94, 0.06);
    border-radius: 8px;
    padding: 8px 16px;
  }
  #logout:hover {
    background: rgba(244, 63, 94, 0.16);
    border-color: #f43f5e;
    color: #ffffff;
  }
  .auth-links a {
    color: #a8a3b8;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  .auth-links a:hover {
    color: #ffffff;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #status {
    padding: 14px 20px;
    background: rgba(155, 123, 255, 0.08);
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 12px;
    color: #ddd6fe;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }
  #status[data-error='true'] {
    background: rgba(244, 63, 94, 0.1);
    border-color: rgba(244, 63, 94, 0.3);
    color: #fecdd3;
  }
  [hidden] {
    display: none !important;
  }

  #intake-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(155, 123, 255, 0.08);
    border: 1px solid rgba(155, 123, 255, 0.2);
    color: #c4b5fd;
    margin-bottom: 24px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .stat-card {
    padding: 18px 16px;
    background: linear-gradient(180deg, #161224 0%, #0e0c18 100%);
    border: 1px solid var(--border-glass);
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.2s,
      border-color 0.2s;
  }
  .stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(155, 123, 255, 0.35);
  }
  .stat-card .number {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    text-shadow: 0 0 16px rgba(155, 123, 255, 0.4);
    display: block;
    font-family: 'Bluu Next', serif;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .stat-card .label {
    color: #a8a3b8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .search-bar {
    background: linear-gradient(180deg, #131020 0%, #0d0b16 100%);
    border: 1px solid var(--border-glass);
    border-radius: 18px;
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .search-bar label {
    display: grid;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #c4b5fd;
    min-width: 0;
  }
  .search-bar input,
  .search-bar select {
    padding: 10px 14px;
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 10px;
    background: #08060f;
    color: var(--text);
    min-width: 0;
    transition: all 0.2s ease;
  }
  .search-bar input:focus,
  .search-bar select:focus {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 3px rgba(155, 123, 255, 0.22);
  }
  .search-bar .actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  #stats-scope {
    font-size: 13px;
    color: #8e889f;
    margin-bottom: 16px;
  }
  #list-error {
    margin: 16px 0;
    color: #fda4af;
    font-size: 14px;
  }

  #table-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border-glass);
    border-radius: 16px;
    background: #0d0b16;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 800px;
  }
  th,
  td {
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    text-align: left;
    overflow-wrap: anywhere;
  }
  th {
    background: #171329;
    color: #c4b5fd;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border-bottom: 1px solid rgba(155, 123, 255, 0.2);
    white-space: nowrap;
  }
  tr:hover td {
    background: rgba(155, 123, 255, 0.08);
  }
  .applicant-detail {
    border: 0;
    padding: 0;
    text-align: left;
    background: none;
    color: #c4b5fd;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition:
      color 0.2s,
      text-shadow 0.2s;
  }
  .applicant-detail:hover {
    color: #ffffff;
    text-shadow: 0 0 8px rgba(155, 123, 255, 0.6);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    white-space: nowrap;
  }
  .status-pill::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }
  .status-pill.status-new {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.28);
  }
  .status-pill.status-reviewing {
    background: rgba(155, 123, 255, 0.15);
    color: #c4b5fd;
    border: 1px solid rgba(155, 123, 255, 0.35);
  }
  .status-pill.status-shortlisted {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .status-pill.status-interview {
    background: rgba(168, 85, 247, 0.14);
    color: #d8b4fe;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }
  .status-pill.status-accepted {
    background: rgba(16, 185, 129, 0.14);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
  }
  .status-pill.status-rejected {
    background: rgba(244, 63, 94, 0.12);
    color: #fb7185;
    border: 1px solid rgba(244, 63, 94, 0.3);
  }
  .status-pill.status-waitlisted {
    background: rgba(234, 179, 8, 0.12);
    color: #fde047;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .status-pill.status-withdrawn {
    background: rgba(148, 163, 184, 0.12);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0;
  }
  #page-info {
    padding: 8px 16px;
    background: rgba(155, 123, 255, 0.1);
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #c4b5fd;
  }

  #detail-area {
    margin-top: 32px;
  }
  #detail-heading {
    font: 700 30px/1.2 var(--font-display);
    color: #ffffff;
    margin-bottom: 20px;
  }
  .review-block {
    display: grid;
    gap: 16px;
    padding: 24px;
    margin: 20px 0;
    border: 1px solid var(--border-glass);
    border-radius: 16px;
    background: linear-gradient(180deg, #141122 0%, #0d0b16 100%);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .review-block h2 {
    font: 700 20px/1.3 var(--font-display);
    color: #ffffff;
    margin: 0 0 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 10px;
  }
  #detail-summary {
    background: linear-gradient(180deg, #161226 0%, #0e0c18 100%);
    border: 1px solid rgba(155, 123, 255, 0.24);
    font-size: 14px;
    line-height: 1.6;
    color: #e2dff0;
  }
  .detail-panel {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  .detail-panel .field {
    padding: 12px 16px;
    background: #08060f;
    border: 1px solid rgba(155, 123, 255, 0.12);
    border-radius: 10px;
    color: #e2dff0;
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
