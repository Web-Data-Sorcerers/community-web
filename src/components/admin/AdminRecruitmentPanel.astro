      flex-direction: row;
      align-items: center;
      gap: 20px;
    }
  }
  .domain-donut-container {
    width: 140px;
    height: 140px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .domain-donut-svg {
    width: 140px;
    height: 140px;
    display: block;
  }
  .domain-bars-container {
    flex: 1;
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .domain-bar-item {
    display: grid;
    gap: 4px;
  }
  .domain-bar-label-row {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
    color: #d1cddf;
  }
  .domain-bar-track {
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }
  .domain-bar-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Pipeline Chart Layout */
  .pipeline-chart-layout {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  .pipeline-chart-container {
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }
  .pipeline-chart-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .pipeline-funnel-container {
