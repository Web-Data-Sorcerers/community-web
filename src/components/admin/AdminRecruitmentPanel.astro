    color: #a8a3b8;
  }
  .terminal-pill strong {
    color: #ffffff;
    margin-left: 2px;
  }

  /* --- Detail Split Workspace --- */
  .detail-header-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .btn-back-top {
