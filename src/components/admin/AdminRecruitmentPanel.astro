---
// AdminRecruitmentPanel — markup existing dari /admin/recruitment/ page, dipindah apa adanya
---

<section data-panel="recruitment" id="panel-recruitment" hidden>
  <div
    id="recruitment-toast-container"
    class="admin-toast-container"
    aria-live="polite"
  ></div>
  <header>
    <p class="brand">Data Sorcerers &middot; Admin</p>
    <h1>Pendaftaran</h1>
    <p>
      Tinjau pendaftar recruitment, filter berdasarkan domain atau kata kunci.
    </p>
    <div class="auth-links">
      <form id="login-form" class="login-form" hidden>
        <label>
          Email
          <input
            id="login-email"
            type="email"
            name="email"
            autocomplete="username"
            required
          />
        </label>
        <label>
          Password
          <input
            id="login-password"
            type="password"
            name="password"
            autocomplete="current-password"
            required
          />
        </label>
        <button id="login-submit" class="primary" type="submit">
          Masuk
        </button>
      </form>
      <button id="logout" type="button" hidden>
        Keluar
      </button>
      <a href="/">Kembali ke situs</a>
    </div>
  </header>
  <p
    id="status"
    role="status"
    aria-live="polite"
    class="is-loading"
    data-loading="true"
  >
    Memeriksa akses&hellip;
  </p>
  <div id="workspace-skeleton" class="workspace-skeleton" aria-hidden="true">
    <div class="skeleton-stats-grid">
      <div class="skeleton-stat-card"></div>
      <div class="skeleton-stat-card"></div>
      <div class="skeleton-stat-card"></div>
      <div class="skeleton-stat-card"></div>
    </div>
    <div class="skeleton-table-card">
      <div class="skeleton-table-header"></div>
      <div class="skeleton-table-row"></div>
      <div class="skeleton-table-row"></div>
      <div class="skeleton-table-row"></div>
    </div>
  </div>
  <div id="workspace" hidden>
    <p id="intake-status" style="margin-bottom: 24px" role="status">
      Memeriksa status pendaftaran&hellip;
    </p>
    <div class="stats-overview-wrapper">
      <div class="stats-grid" id="stats"></div>
      <div id="analytics-visuals" class="analytics-visuals" hidden>
        <div class="analytics-card" id="card-domain-distribution">
          <div class="analytics-card-header">
            <div class="analytics-title-group">
              <svg
                class="analytics-badge-icon"
                viewBox="0 0 20 20"
                fill="none"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <path
                  d="M3 17V10M8 17V4M13 17V7M18 17V13"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                ></path>
              </svg>
              <h3>Distribusi Domain</h3>
            </div>
            <span class="analytics-count-badge" id="domain-stats-total">
              0 pendaftar
            </span>
          </div>
          <div class="domain-chart-layout">
            <div class="domain-donut-container" id="domain-donut"></div>
            <div class="domain-bars-container" id="domain-bars"></div>
          </div>
        </div>
        <div class="analytics-card" id="card-funnel-pipeline">
          <div class="analytics-card-header">
            <div class="analytics-title-group">
              <svg
                class="analytics-badge-icon"
                viewBox="0 0 20 20"
                fill="none"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <path
                  d="M2 4H18L12 11V16L8 14V11L2 4Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              <h3>Pipeline Alur Seleksi</h3>
            </div>
            <span class="analytics-count-badge" id="pipeline-stats-conversion">
              Tahapan
            </span>
          </div>
          <div class="pipeline-chart-layout">
            <div class="pipeline-chart-container" id="pipeline-chart"></div>
            <div class="pipeline-funnel-container" id="pipeline-funnel"></div>
          </div>
        </div>
      </div>
    </div>
    <form id="filter-form" class="search-bar">
      <label>
        Nama atau email
        <input
          id="search"
          type="search"
          maxlength="400"
          placeholder="Cari nama atau email&hellip;"
        />
      </label>
      <label>
        Domain
        <select id="filter-hods">
          <option value="">Semua domain</option>
        </select>
      </label>
      <label>
        Status
        <select id="filter-status">
          <option value="">Semua status</option>
        </select>
      </label>
      <label>
        Tanggal mulai (WIB)
        <input id="filter-since" type="date" />
      </label>
      <label>
        Tanggal akhir (WIB)
        <input id="filter-until" type="date" />
      </label>
      <label>
        Urutan
        <select id="filter-sort">
          <option value="received_at_desc">Terbaru</option>
          <option value="received_at_asc">Terlama</option>
        </select>
      </label>
      <div class="actions">
        <button id="filter-btn" class="primary" type="submit">
          Cari
        </button>
        <button id="reset-filter" type="button">
          Reset filter
        </button>
        <button id="reload-list" type="button">
          Muat ulang daftar
        </button>
        <button id="btn-backup-database" class="btn-backup" type="button" title="Unduh seluruh database pendaftar dalam format JSON">
          Backup JSON
        </button>
        <button id="btn-export-excel" class="btn-excel" type="button" title="Unduh seluruh database pendaftar dalam format Excel / CSV (Full Detail)">
          Export Excel (CSV)
        </button>
      </div>
    </form>
    <p id="stats-scope">
      Ringkasan status dan domain mengikuti filter. Tanggal menggunakan WIB.
    </p>
    <p id="list-error" role="status" aria-live="polite"></p>
    <div
      id="table-wrapper"
      tabindex="0"
      role="region"
      aria-label="Daftar pendaftar, geser untuk melihat seluruh kolom"
    >
      <table>
        <thead>
          <tr>
            <th>Nama</th>
            <th>Email</th>
            <th>Domain</th>
            <th>Tanggal</th>
            <th>Status</th>
            <th>Catatan</th>
            <th class="col-action">Aksi</th>
          </tr>
        </thead>
        <tbody id="applications-body"></tbody>
      </table>
    </div>
    <div class="pagination" id="pagination" hidden>
      <button id="prev-page" type="button">
        &larr; Sebelumnya
      </button>
      <span id="page-info"></span>
      <button id="next-page" type="button">
        Selanjutnya &rarr;
      </button>
    </div>
    <div id="detail-area" hidden>
      <div class="detail-header-bar">
        <button id="back-list-top" class="btn-back-top" type="button">
          &larr; Kembali ke daftar
        </button>
        <div class="detail-header-actions">
          <button id="btn-edit-applicant" class="btn-edit" type="button">
            Edit Data Pendaftar
          </button>
          <button id="btn-delete-applicant" class="btn-delete-danger" type="button">
            Hapus Pendaftar
          </button>
        </div>
        <h2 id="detail-heading" tabindex="-1">
          Detail pendaftar
        </h2>
      </div>
      <div id="detail-summary" class="review-block"></div>
      <div class="detail-workspace-layout">
        <section
          class="detail-main-pane"
          aria-labelledby="form-answers-heading"
        >
          <div class="form-answers-header">
            <h2 id="form-answers-heading">Jawaban formulir</h2>
          </div>
          <div id="detail-panel" class="detail-panel"></div>
        </section>
        <aside class="detail-sidebar">
          <section class="review-block" aria-labelledby="selection-heading">
            <h2 id="selection-heading">Seleksi internal</h2>
            <p>Status ini tidak mengirim pesan atau menambah anggota Team.</p>
            <p id="review-meta"></p>
            <form id="status-form">
              <label>
                Status tujuan<select id="review-status" required></select>
              </label>
              <label>
                Alasan
                <textarea
                  id="review-reason"
                  rows="3"
                  aria-describedby="reason-help"
                ></textarea>
              </label>
              <p id="reason-help">
                Maksimum 500 karakter. Keputusan akhir dan pembukaan kembali
                wajib alasan minimal 10 karakter.
              </p>
              <label id="decision-confirm" hidden>
                <input id="confirm-status" type="checkbox" />
                <span id="confirm-label"></span>
              </label>
              <button id="save-status" type="submit" class="primary">
                Simpan status
              </button>
            </form>
          </section>
          <p
            id="review-feedback"
            role="status"
            aria-live="polite"
            tabindex="-1"
          ></p>
          <div class="actions">
            <button id="retry-mutation" type="button" hidden>
              Coba kiriman yang sama
            </button>
            <button id="reload-detail" type="button">
              Muat detail terbaru
            </button>
          </div>
          <section class="review-block" aria-labelledby="notes-heading">
            <h2 id="notes-heading">Catatan internal</h2>
            <p>
              Koreksi ditulis sebagai catatan baru. Catatan yang tersimpan tidak
              dapat diedit atau dihapus.
            </p>
            <form id="note-form">
              <label>
                Catatan
                <textarea
                  id="review-note"
                  rows="5"
                  aria-describedby="note-help"
                  required
                ></textarea>
              </label>
              <p id="note-help">1&ndash;4000 karakter, maksimum 16 KiB.</p>
              <button id="save-note" type="submit" class="primary">
                Tambah catatan
              </button>
            </form>
            <div id="notes-list" class="detail-panel"></div>
            <div class="actions">
              <button id="notes-prev" type="button">
                Catatan sebelumnya
              </button>
              <span id="notes-page"></span>
              <button id="notes-next" type="button">
                Catatan selanjutnya
              </button>
            </div>
          </section>
          <section class="review-block" aria-labelledby="history-heading">
            <h2 id="history-heading">Aktivitas</h2>
            <div id="history-list" class="detail-panel"></div>
            <div class="actions">
              <button id="history-prev" type="button">
                Aktivitas sebelumnya
              </button>
              <span id="history-page"></span>
              <button id="history-next" type="button">
                Aktivitas selanjutnya
              </button>
            </div>
          </section>
        </aside>
      </div>
      <button id="back-list" type="button">
        Kembali ke daftar
      </button>
    </div>
  </div>

  <!-- Modal Edit Data Pendaftar -->
  <div id="modal-edit-applicant" class="admin-modal-backdrop" hidden>
    <div
      class="admin-modal-card"
      role="dialog"
      aria-labelledby="modal-edit-title"
      aria-modal="true"
    >
      <header class="admin-modal-header">
        <h3 id="modal-edit-title">Edit Data Pendaftar</h3>
        <button
          type="button"
          class="admin-modal-close"
          id="modal-edit-close"
          aria-label="Tutup"
        >&times;</button>
      </header>
      <form id="form-edit-applicant" class="admin-modal-form">
        <div class="admin-modal-body">
          <div class="form-grid">
            <label>
              <span>Nama Lengkap *</span>
              <input type="text" id="edit-full-name" required maxlength="200" />
            </label>
            <label>
              <span>Nama Panggilan</span>
              <input type="text" id="edit-preferred-name" maxlength="100" />
            </label>
            <label>
              <span>Email *</span>
              <input type="email" id="edit-email" required maxlength="200" />
            </label>
            <label>
              <span>WhatsApp *</span>
              <input type="text" id="edit-whatsapp" required maxlength="50" />
            </label>
            <label>
              <span>Institusi / Universitas</span>
              <input type="text" id="edit-institution" maxlength="200" />
            </label>
            <label>
              <span>Kota / Wilayah</span>
              <input type="text" id="edit-city" maxlength="100" />
            </label>
            <label>
              <span>Domain HoDS Utama *</span>
              <select id="edit-primary-hods" required>
                <option value="data">Data Intelligence</option>
                <option value="core">Core AI & Engineering</option>
                <option value="language">Language & Reasoning</option>
                <option value="vision">Vision & Multimodal</option>
                <option value="product">Product & Software</option>
                <option value="growth">Growth & Community</option>
              </select>
            </label>
            <label>
              <span>Sub-Area Spesifik</span>
              <input type="text" id="edit-specific-area" maxlength="200" />
            </label>
            <label class="col-span-2">
              <span>Tautan Portofolio / CV / GitHub</span>
              <input type="url" id="edit-portfolio-link" maxlength="500" />
            </label>
          </div>
          <p
            id="edit-feedback"
            class="admin-modal-feedback"
            role="status"
            aria-live="polite"
          ></p>
        </div>
        <footer class="admin-modal-footer">
          <button type="button" id="modal-edit-cancel" class="btn-secondary">
            Batal
          </button>
          <button type="submit" id="modal-edit-submit" class="primary">
            Simpan Perubahan
          </button>
        </footer>
      </form>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus dengan Backup Safety -->
  <div id="modal-delete-applicant" class="admin-modal-backdrop" hidden>
    <div
      class="admin-modal-card modal-card-danger"
      role="dialog"
      aria-labelledby="modal-delete-title"
      aria-modal="true"
    >
      <header class="admin-modal-header danger-header">
        <div class="danger-header-title">
          <div class="danger-header-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              <line x1="10" y1="11" x2="10" y2="17"></line>
              <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
          </div>
          <div>
            <h3 id="modal-delete-title">Hapus Data Pendaftar</h3>
            <p class="danger-header-subtitle">Konfirmasi penghapusan data pendaftar dari sistem seleksi aktif.</p>
          </div>
        </div>
        <button
          type="button"
          class="admin-modal-close"
          id="modal-delete-close"
          aria-label="Tutup"
        >&times;</button>
      </header>

      <div class="admin-modal-body">
        <!-- Banner Peringatan -->
        <div class="danger-warning-banner">
          <div class="danger-banner-icon-badge" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div class="danger-banner-content">
            <strong>Tindakan ini akan menghapus data dari tabel aktif</strong>
            <p>
              Sistem akan otomatis mengarsipkan snapshot lengkap pendaftar ke tabel cadangan permanen sebelum penghapusan.
            </p>
          </div>
        </div>

        <!-- Kartu Identitas Pendaftar yang Akan Dihapus -->
        <div class="applicant-delete-card">
          <div class="delete-card-header">
            <span class="delete-card-badge">Data Pendaftar</span>
          </div>
          <div class="delete-card-grid">
            <div class="delete-card-row">
              <span class="delete-card-label">Nama Lengkap</span>
              <span id="delete-applicant-name" class="delete-card-val highlight">—</span>
            </div>
            <div class="delete-card-row">
              <span class="delete-card-label">Email</span>
              <span id="delete-applicant-email" class="delete-card-val">—</span>
            </div>
            <div class="delete-card-row">
              <span class="delete-card-label">ID Resi</span>
              <code id="delete-applicant-receipt" class="delete-card-code">—</code>
            </div>
          </div>
        </div>

        <!-- Kartu Unduh Cadangan JSON Lokal -->
        <div class="safety-download-card">
          <div class="safety-card-info">
            <div class="safety-icon-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
            <div class="safety-card-texts">
              <strong>Unduh Cadangan Lokal</strong>
              <p>Simpan salinan data pendaftar ini (.json) ke perangkat Anda sebelum dihapus.</p>
            </div>
          </div>
          <button
            type="button"
            id="btn-download-single-backup"
            class="btn-download-backup"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Unduh Cadangan (.json)</span>
          </button>
        </div>

        <!-- Input Alasan Opsional -->
        <div class="reason-group">
          <label for="delete-reason" class="reason-title">
            <span>Alasan penghapusan (opsional):</span>
          </label>
          <input
            type="text"
            id="delete-reason"
            class="reason-input"
            placeholder="Contoh: Data uji coba / Spam / Permintaan pendaftar"
            maxlength="200"
          />
        </div>

        <!-- Checkbox Konfirmasi Interaktif -->
        <label class="confirm-checkbox-card" for="delete-confirm-check">
          <input type="checkbox" id="delete-confirm-check" class="delete-checkbox-input" />
          <span class="confirm-checkbox-text">
            Saya memahami bahwa pendaftar ini akan dihapus dari tabel pendaftaran aktif.
          </span>
        </label>

        <!-- Pesan Status / Feedback -->
        <p
          id="delete-feedback"
          class="admin-modal-feedback"
          role="status"
          aria-live="polite"
        ></p>
      </div>

      <footer class="admin-modal-footer">
        <button type="button" id="modal-delete-cancel" class="btn-cancel">
          Batal
        </button>
        <button
          type="button"
          id="btn-confirm-delete"
          class="btn-danger-confirm"
          disabled
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Hapus Pendaftar</span>
        </button>
      </footer>
    </div>
  </div>
</section>

<style is:global>
  header {
    background: linear-gradient(
      180deg,
      rgba(20, 17, 34, 0.8) 0%,
      rgba(13, 11, 22, 0.5) 100%
    );
    border: 1px solid var(--border-glass);
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 32px;
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  h1 {
    margin: 0 0 12px;
    font: 700 36px/1.2 var(--font-display);
    color: #ffffff;
    letter-spacing: 0.5px;
    text-shadow: 0 0 24px rgba(155, 123, 255, 0.2);
  }
  h2 {
    margin: 0 0 16px;
    font: 700 22px/1.25 var(--font-display);
    color: #ffffff;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  header p:not(.brand) {
    max-width: 700px;
    line-height: 1.6;
    color: #b5b0c4;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: #c4b5fd;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  button,
  input,
  select,
  textarea {
    font: inherit;
  }
  button {
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 10px;
    padding: 10px 18px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  button:hover:not(:disabled) {
    background: rgba(155, 123, 255, 0.12);
    border-color: rgba(155, 123, 255, 0.4);
    color: #ffffff;
  }
  button:disabled {
    opacity: 0.55;
    cursor: default;
  }
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .primary {
    background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
    color: #ffffff;
    border: 1px solid rgba(155, 123, 255, 0.4);
    font-weight: 700;
    padding: 12px 24px;
    box-shadow: 0 4px 18px rgba(155, 123, 255, 0.35);
    border-radius: 10px;
  }
  .primary:hover:not(:disabled) {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(155, 123, 255, 0.45);
    color: #ffffff;
  }
  .primary:active:not(:disabled) {
    transform: translateY(0);
  }
  .auth-links {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .login-link {
    display: inline-block;
    padding: 10px 20px;
    background: linear-gradient(135deg, #9b7bff 0%, #7c5cfc 100%);
    color: #ffffff;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(155, 123, 255, 0.35);
  }
  .login-form {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    flex-wrap: wrap;
    padding: 16px 20px;
    background: rgba(10, 8, 16, 0.85);
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 14px;
  }
  .login-form label {
    display: grid;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #bcb7cb;
  }
  .login-form input {
    padding: 8px 12px;
    min-height: 40px;
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 8px;
    background: #050408;
    color: var(--text);
  }
  .login-form .primary {
    min-height: 40px;
    padding: 8px 20px;
  }
  #logout {
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fda4af;
    background: rgba(244, 63, 94, 0.06);
    border-radius: 8px;
    padding: 8px 16px;
  }
  #logout:hover {
    background: rgba(244, 63, 94, 0.16);
    border-color: #f43f5e;
    color: #ffffff;
  }
  .auth-links a {
    color: #a8a3b8;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  .auth-links a:hover {
    color: #ffffff;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #status {
    padding: 14px 20px;
    background: rgba(155, 123, 255, 0.08);
    border: 1px solid rgba(155, 123, 255, 0.24);
    border-radius: 12px;
    color: #ddd6fe;
    margin-bottom: 24px;
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.25s ease;
  }
  #status.is-loading,
  #status[data-loading='true'] {
    border-color: rgba(155, 123, 255, 0.45);
    background: linear-gradient(
      90deg,
      rgba(155, 123, 255, 0.12) 0%,
      rgba(124, 92, 252, 0.06) 50%,
      rgba(155, 123, 255, 0.12) 100%
    );
    background-size: 200% 100%;
    animation: statusArcaneShimmer 2.5s ease infinite;
    box-shadow: 0 0 20px rgba(155, 123, 255, 0.16);
  }
  #status.is-loading::before,
  #status[data-loading='true']::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #c4b5fd;
    border-radius: 50%;
    animation: spinArcane 0.7s linear infinite;
  }
  #status[data-error='true'] {
    background: rgba(244, 63, 94, 0.1);
    border-color: rgba(244, 63, 94, 0.3);
    color: #fecdd3;
    animation: none;
  }
  #status[data-error='true']::before {
    display: none;
  }

  /* --- Workspace Loading Skeleton --- */
  .workspace-skeleton {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 16px;
  }
  .skeleton-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
  }
  .skeleton-stat-card {
    height: 96px;
    border-radius: 16px;
    background: linear-gradient(
      90deg,
      rgba(155, 123, 255, 0.06) 25%,
      rgba(155, 123, 255, 0.15) 50%,
      rgba(155, 123, 255, 0.06) 75%
    );
    background-size: 200% 100%;
    animation: arcaneShimmer 1.8s infinite;
    border: 1px solid rgba(155, 123, 255, 0.16);
  }
  .skeleton-table-card {
    border-radius: 16px;
    padding: 24px;
    background: #0d0b16;
    border: 1px solid rgba(155, 123, 255, 0.16);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .skeleton-table-header {
    height: 40px;
    border-radius: 8px;
    background: rgba(155, 123, 255, 0.12);
  }
  .skeleton-table-row {
    height: 48px;
    border-radius: 8px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.02) 25%,
      rgba(155, 123, 255, 0.08) 50%,
      rgba(255, 255, 255, 0.02) 75%
    );
    background-size: 200% 100%;
    animation: arcaneShimmer 1.8s infinite;
  }
  [hidden] {
    display: none !important;
  }

  #intake-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(155, 123, 255, 0.08);
    border: 1px solid rgba(155, 123, 255, 0.2);
    color: #c4b5fd;
    margin-bottom: 24px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .stat-card {
    padding: 18px 16px;
    background: linear-gradient(180deg, #161224 0%, #0e0c18 100%);
    border: 1px solid var(--border-glass);
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.2s,
      border-color 0.2s;
  }
  .stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(155, 123, 255, 0.35);
  }
  .stat-card .number {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    text-shadow: 0 0 16px rgba(155, 123, 255, 0.4);
    display: block;
    font-family: 'Bluu Next', serif;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .stat-card .label {
    color: #a8a3b8;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .search-bar {
    background: linear-gradient(180deg, #131020 0%, #0d0b16 100%);
    border: 1px solid var(--border-glass);
    border-radius: 18px;
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .search-bar label {
    display: grid;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #c4b5fd;
    min-width: 0;
  }
  .search-bar input,
  .search-bar select {
    padding: 10px 14px;
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 10px;
    background: #08060f;
    color: var(--text);
    min-width: 0;
    transition: all 0.2s ease;
  }
  .search-bar input:focus,
  .search-bar select:focus {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 3px rgba(155, 123, 255, 0.22);
  }
  .search-bar .actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  #stats-scope {
    font-size: 13px;
    color: #8e889f;
    margin-bottom: 16px;
  }
  #list-error {
    margin: 16px 0;
    color: #fda4af;
    font-size: 14px;
  }

  #table-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border-glass);
    border-radius: 16px;
    background: #0d0b16;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 800px;
  }
  th,
  td {
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    text-align: left;
    overflow-wrap: anywhere;
  }
  th {
    background: #171329;
    color: #c4b5fd;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border-bottom: 1px solid rgba(155, 123, 255, 0.2);
    white-space: nowrap;
  }
  tr:hover td {
    background: rgba(155, 123, 255, 0.08);
  }
  .applicant-detail {
    border: 0;
    padding: 0;
    text-align: left;
    background: none;
    color: #c4b5fd;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition:
      color 0.2s,
      text-shadow 0.2s;
  }
  .applicant-detail:hover {
    color: #ffffff;
    text-shadow: 0 0 8px rgba(155, 123, 255, 0.6);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    white-space: nowrap;
  }
  .status-pill::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }
  .status-pill.status-new {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.28);
  }
  .status-pill.status-reviewing {
    background: rgba(155, 123, 255, 0.15);
    color: #c4b5fd;
    border: 1px solid rgba(155, 123, 255, 0.35);
  }
  .status-pill.status-shortlisted {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .status-pill.status-interview {
    background: rgba(168, 85, 247, 0.14);
    color: #d8b4fe;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }
  .status-pill.status-accepted {
    background: rgba(16, 185, 129, 0.14);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
  }
  .status-pill.status-rejected {
    background: rgba(244, 63, 94, 0.12);
    color: #fb7185;
    border: 1px solid rgba(244, 63, 94, 0.3);
  }
  .status-pill.status-waitlisted {
    background: rgba(234, 179, 8, 0.12);
    color: #fde047;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }
  .status-pill.status-withdrawn {
    background: rgba(148, 163, 184, 0.12);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0;
  }
  #page-info {
    padding: 8px 16px;
    background: rgba(155, 123, 255, 0.1);
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #c4b5fd;
  }

  #detail-area {
    margin-top: 32px;
  }
  #detail-heading {
    font: 700 30px/1.2 var(--font-display);
    color: #ffffff;
    margin-bottom: 20px;
  }
  .review-block {
    display: grid;
    gap: 16px;
    padding: 24px;
    margin: 20px 0;
    border: 1px solid var(--border-glass);
    border-radius: 16px;
    background: linear-gradient(180deg, #141122 0%, #0d0b16 100%);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }
  .review-block h2 {
    font: 700 20px/1.3 var(--font-display);
    color: #ffffff;
    margin: 0 0 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 10px;
  }
  #detail-summary {
    background: linear-gradient(180deg, #161226 0%, #0e0c18 100%);
    border: 1px solid rgba(155, 123, 255, 0.24);
    font-size: 14px;
    line-height: 1.6;
    color: #e2dff0;
  }
  .detail-panel {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  .detail-panel .field {
    padding: 12px 16px;
    background: #08060f;
    border: 1px solid rgba(155, 123, 255, 0.12);
    border-radius: 10px;
    color: #e2dff0;
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .detail-panel .field-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #9b7bff;
    letter-spacing: 0.8px;
    margin-bottom: 4px;
    display: block;
  }
  #decision-confirm {
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: rgba(155, 123, 255, 0.08);
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 10px;
  }
  #confirm-status {
    width: 20px;
    height: 20px;
    accent-color: var(--accent);
  }
  #review-feedback {
    margin: 16px 0;
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(155, 123, 255, 0.1);
    border: 1px solid rgba(155, 123, 255, 0.24);
    color: #c4b5fd;
    font-size: 14px;
  }
  textarea {
    width: 100%;
    resize: vertical;
    padding: 12px 16px;
    border: 1px solid rgba(155, 123, 255, 0.2);
    border-radius: 10px;
    background: #08060f;
    color: var(--text);
    line-height: 1.6;
    transition: all 0.2s;
  }
  textarea:focus {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 3px rgba(155, 123, 255, 0.22);
  }
  #back-list {
    margin-top: 24px;
    padding: 12px 24px;
    border-radius: 10px;
    font-weight: 600;
    background: rgba(155, 123, 255, 0.12);
    border: 1px solid rgba(155, 123, 255, 0.3);
    color: #c4b5fd;
    cursor: pointer;
    transition: all 0.2s;
  }
  #back-list:hover {
    background: rgba(155, 123, 255, 0.25);
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .search-bar {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 768px) {
    main {
      padding: 16px 12px;
    }
    header {
      padding: 20px 16px;
      border-radius: 14px;
    }
    h1 {
      font-size: 28px;
    }
    .search-bar {
      grid-template-columns: 1fr;
      padding: 16px;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .stat-card {
      padding: 14px 10px;
    }
    .stat-card .number {
      font-size: 24px;
    }
    .review-block {
      padding: 16px;
      border-radius: 14px;
    }
    .login-form {
      flex-direction: column;
      align-items: stretch;
    }
    th,
    td {
      padding: 10px 12px;
      font-size: 13px;
    }
  }

  /* --- Action Column & Review Button --- */
  .col-action {
    text-align: right;
    width: 140px;
  }
  .btn-review-action {
    background: linear-gradient(
      135deg,
      rgba(155, 123, 255, 0.15) 0%,
      rgba(124, 92, 252, 0.08) 100%
    );
    border: 1px solid rgba(155, 123, 255, 0.35);
    color: #e2dff0;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .btn-review-action:hover {
    background: linear-gradient(
      135deg,
      rgba(155, 123, 255, 0.35) 0%,
      rgba(124, 92, 252, 0.25) 100%
    );
    border-color: #9b7bff;
    color: #ffffff;
    box-shadow: 0 0 14px rgba(155, 123, 255, 0.45);
    transform: translateY(-1px);
  }

  /* --- Skeleton Shimmer Loading --- */
  @keyframes arcaneShimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
  .skeleton-row td {
    padding: 14px 18px;
  }
  .skeleton-pill,
  .skeleton-badge,
  .skeleton-btn {
    height: 16px;
    border-radius: 6px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.03) 0%,
      rgba(155, 123, 255, 0.12) 50%,
      rgba(255, 255, 255, 0.03) 100%
    );
    background-size: 200% 100%;
    animation: arcaneShimmer 1.8s infinite ease-in-out;
  }
  .w-40 {
    width: 40px;
  }
  .w-80 {
    width: 80px;
  }
  .w-120 {
    width: 120px;
  }
  .w-140 {
    width: 140px;
  }
  .w-180 {
    width: 180px;
  }
  .skeleton-badge {
    width: 70px;
    height: 22px;
    border-radius: 20px;
  }
  .skeleton-btn {
    width: 110px;
    height: 28px;
    border-radius: 8px;
  }

  /* --- Button Loading Spinner --- */
  .btn-spinner {
    display: inline-block;
    width: 13px;
    height: 13px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spinArcane 0.7s linear infinite;
    vertical-align: middle;
    margin-right: 6px;
  }
  @keyframes spinArcane {
    to {
      transform: rotate(360deg);
    }
  }
  button.is-loading {
    opacity: 0.85;
    cursor: wait !important;
    pointer-events: none;
  }

  /* --- Toast Notification System --- */
  .admin-toast-container {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
    max-width: calc(100vw - 32px);
    width: 360px;
    box-sizing: border-box;
  }
  .admin-toast {
    box-sizing: border-box;
    max-width: 100%;
    pointer-events: auto;
    padding: 12px 16px;
    border-radius: 14px;
    backdrop-filter: blur(20px);
    background: rgba(14, 11, 23, 0.95);
    border: 1px solid var(--border-glass);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #e2dff0;
    font-size: 13px;
    line-height: 1.5;
    animation: toastSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .admin-toast.toast-closing {
    opacity: 0;
    transform: translateX(30px);
  }
  @keyframes toastSlideIn {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .toast-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
  }
  .admin-toast.toast-success .toast-dot {
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }
  .admin-toast.toast-error .toast-dot {
    background: #f43f5e;
    box-shadow: 0 0 8px #f43f5e;
  }
  .admin-toast.toast-warning .toast-dot {
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
  }
  .admin-toast.toast-info .toast-dot {
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }
  .toast-content {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .toast-title {
    font-weight: 700;
    font-size: 13px;
    color: #ffffff;
    margin-bottom: 2px;
  }
  .toast-close {
    background: none;
    border: 0;
    color: #948fa3;
    padding: 2px 4px;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    border-radius: 4px;
    transition: color 0.15s;
    flex-shrink: 0;
  }
  .toast-close:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }
  .admin-toast.toast-success {
    border-color: rgba(16, 185, 129, 0.45);
    box-shadow: 0 4px 24px rgba(16, 185, 129, 0.2);
  }
  .admin-toast.toast-success .toast-title {
    color: #34d399;
  }
  .admin-toast.toast-error {
    border-color: rgba(244, 63, 94, 0.45);
    box-shadow: 0 4px 24px rgba(244, 63, 94, 0.2);
  }
  .admin-toast.toast-error .toast-title {
    color: #fb7185;
  }
  .admin-toast.toast-warning {
    border-color: rgba(245, 158, 11, 0.45);
    box-shadow: 0 4px 24px rgba(245, 158, 11, 0.2);
  }
  .admin-toast.toast-warning .toast-title {
    color: #fbbf24;
  }
  .admin-toast.toast-info {
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 4px 24px rgba(56, 189, 248, 0.2);
  }
  .admin-toast.toast-info .toast-title {
    color: #38bdf8;
  }

  /* --- Analytics & Visualization Dashboard --- */
  .stats-overview-wrapper {
    margin-bottom: 24px;
    width: 100%;
    min-width: 0;
  }
  .analytics-visuals {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 18px;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .analytics-visuals {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .analytics-card {
    padding: 18px 20px;
    background: linear-gradient(180deg, #151125 0%, #0d0b17 100%);
    border: 1px solid var(--border-glass);
