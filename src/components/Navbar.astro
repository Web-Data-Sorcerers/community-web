---
import { canNavigateToTarget } from '../data/site-visibility-registry.mjs';
const canVisit = (page: string, section?: string) =>
  !Astro.locals.visibility ||
  canNavigateToTarget(Astro.locals.visibility, page, section);
import Button from './Button.astro';
interface Props {
  active?: string;
}
const { active = 'Home' } = Astro.props;
const links = [
  'Home',
  'About Us',
  'Recruitment',
  'Hall of Frames',
  'Partners',
  'Contact',
];
// Only pages that exist get a real destination; the rest stay unavailable.
const destinations: Record<string, string> = {
  Home: '/',
  'About Us': '/about',
  Recruitment: '/recruitment',
  'Hall of Frames': '/hall-of-frames',
  Partners: '/partners',
  Contact: '/contact',
};
---

<header class="navbar">
  <div class="navbar-inner">
    <a
      class="brand"
      href="/"
      aria-label="Data Sorcerers home"
      data-sfx="select"
      data-sfx-hover="hover"
      data-astro-prefetch="false"
    >
      <img src="/images/logo.png" width="54" height="59" alt="Data Sorcerers" />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {links.map((label, i) =>
        destinations[label] ? (
          <a
            class:list={['nav-link', { active: label === active }]}
            href={destinations[label]}
            aria-current={label === active ? 'page' : undefined}
            style={`--i:${i + 1}`}
            data-sfx="select"
            data-sfx-hover="hover"
            data-astro-prefetch="false"
          >
            <span class="nav-label">{label}</span>
            <span class="nav-underline" aria-hidden="true" />
          </a>
        ) : (
          <span
            class:list={['nav-link', { active: label === active }]}
            aria-disabled="true"
            style={`--i:${i + 1}`}
          >
            <span class="nav-label">{label}</span>
            <span class="nav-underline" aria-hidden="true" />
          </span>
        ),
      )}
    </nav>
    <div class="desktop-cta">
      {canVisit('recruitment') && (
        <Button variant="community" href="/recruitment">
          Join Us
        </Button>
      )}
    </div>
    <details class="mobile-menu">
      <summary aria-label="Toggle navigation" data-sfx-hover="hover">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {links.map((label, i) =>
          destinations[label] ? (
            <a
              class:list={['nav-link', { active: label === active }]}
              href={destinations[label]}
              aria-current={label === active ? 'page' : undefined}
              style={`--i:${i + 1}`}
              data-sfx="select"
              data-sfx-hover="hover"
              data-astro-prefetch="false"
            >
              <span class="nav-label">{label}</span>
              <span class="nav-underline" aria-hidden="true" />
            </a>
          ) : (
            <span
              class:list={['nav-link', { active: label === active }]}
              aria-disabled="true"
              style={`--i:${i + 1}`}
            >
              <span class="nav-label">{label}</span>
              <span class="nav-underline" aria-hidden="true" />
            </span>
          ),
        )}
        {canVisit('recruitment') && (
          <Button variant="community" href="/recruitment">
            Join Us
          </Button>
        )}
      </nav>
    </details>
  </div>
</header>
<style>
  /* Matches Figma node 755:15178 (component set 530:13894): 1440-wide bar,
       padding 24px 80px, space-between across Logo (54px), Menu (743px), CTA (172px).
       Active tab = 1px gradient underline, inactive tabs #707070. Reference: assets/Navbar.png. */
  .navbar {
    --nb-h: 106.8px;
    /* Lift the bar clear of the status bar / notch on installed PWAs. */
    --nb-safe: env(safe-area-inset-top, 0px);
    --nb-frame: 1440px;
    --nb-gutter: clamp(24px, 5.5556vw, 80px);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: transparent;
  }
  /* Figma's own fill + progressive background blur (node 530:13894):
       faint violet wash with 20px blur at top tapering smoothly to 0 at bottom. */
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(108, 59, 255, 0.12) 0%,
      rgba(11, 7, 18, 0) 100.19%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      transparent 100%
    );
    transition: opacity 0.3s ease;
  }
  /* Translucent frosted glass on scroll: luminous, light violet-tinted glass */
  .navbar::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(108, 59, 255, 0.16) 0%,
      rgba(18, 12, 34, 0.48) 100%
    );
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.22);
    transition: opacity 0.3s ease;
  }
  .navbar.is-scrolled::before {
    opacity: 0;
  }
  .navbar.is-scrolled::after {
    opacity: 1;
  }
  .navbar-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--nb-frame);
    height: var(--nb-h);
    margin-top: var(--nb-safe);
    margin-inline: auto;
    padding: 24px var(--nb-gutter);
  }
  .brand {
    position: relative;
    display: block;
    flex: none;
    order: 0;
  }
  .brand img {
    display: block;
    width: 54px;
    height: 58.8px;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.11vw, 16px);
    flex: none;
    order: 1;
  }
  .desktop-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    order: 2;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px clamp(8px, 0.9722vw, 14px);
    color: #c5bad4;
    font-size: clamp(15px, 1.25vw, 18px);
    font-weight: 500;
    line-height: 27px;
    white-space: nowrap;
    transition:
      color 0.25s ease,
      text-shadow 0.25s ease;
  }
  .nav-label {
    display: block;
  }
  /* The underline is the state indicator: the active tab keeps it, and hover
       previews it on any tab (fade in) so the active tab still reacts too. */
  .nav-underline {
    display: block;
    align-self: stretch;
    height: 1px;
    background: linear-gradient(90deg, #9b7bff 0%, #ede8ff 50%, #9b7bff 100%);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      box-shadow 0.25s ease;
  }
  .nav-link.active .nav-underline {
    opacity: 1;
    box-shadow: 0 0 10px rgb(155 123 255 / 70%);
  }
  .nav-link[aria-disabled='true'] {
    cursor: default;
  }
  a.nav-link:hover,
  a.nav-link:focus-visible {
    color: #fff;
    text-shadow: 0 0 12px rgba(155, 123, 255, 0.45);
  }
  a.nav-link:hover .nav-underline,
  a.nav-link:focus-visible .nav-underline {
    opacity: 0.6;
  }
  .nav-link.active {
    color: #fff;
    font-weight: 600;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.35);
  }
  a.nav-link.active:hover .nav-underline,
  a.nav-link.active:focus-visible .nav-underline {
    opacity: 1;
    box-shadow: 0 0 14px rgb(155 123 255 / 95%);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-underline {
      transition: none;
    }
  }
  .mobile-menu {
    display: none;
  }
  /* Desktop >=1301px locks the exact Figma tab widths (component set 530:13894)
       so the menu is 743px wide and nobody depends on font rasterisation. */
  @media (min-width: 1301px) {
    .desktop-nav {
      gap: 16px;
      width: 743px;
    }
    /* Figma "Join Us" CTA is a 93x43 primary pill (node 1430:2051). */
    .desktop-cta {
      width: 93px;
    }
    :global(.navbar .desktop-cta .button) {
      width: 100%;
    }
    .nav-link {
      padding: 8px 14px;
      font-size: 18px;
    }
    .desktop-nav > .nav-link:nth-child(1) {
      width: 78px;
    }
    .desktop-nav > .nav-link:nth-child(2) {
      width: 106px;
    }
    .desktop-nav > .nav-link:nth-child(3) {
      width: 134px;
    }
    .desktop-nav > .nav-link:nth-child(4) {
      width: 146px;
    }
    .desktop-nav > .nav-link:nth-child(5) {
      width: 101px;
    }
    .desktop-nav > .nav-link:nth-child(6) {
      width: 98px;
    }
  }
  @media (max-width: 1050px) {
    .navbar {
      --nb-h: 94px;
      --nb-gutter: var(--page-gutter);
    }
    .navbar-inner {
      height: var(--nb-h);
      padding: 18px var(--nb-gutter);
    }
    .desktop-nav,
    .desktop-cta {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    summary {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 44px;
      height: 44px;
      padding: 10px;
      cursor: pointer;
      background: none;
      border: 1px solid transparent;
      border-radius: 14px;
      list-style: none;
      transition:
        background-color 0.3s ease,
        border-color 0.3s ease;
    }
    /* Once the bar is backed, the burger reads as its own glass button. */
    .navbar.is-scrolled summary {
      background: rgb(255 255 255 / 8%);
      border-color: rgb(255 255 255 / 12%);
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary span {
      display: block;
      height: 2px;
      width: 22px;
      border-radius: 2px;
      background: white;
      filter: drop-shadow(0 1px 2px rgb(0 0 0 / 65%));
      transition:
        transform 0.4s cubic-bezier(0.68, -0.6, 0.32, 1.6),
        opacity 0.2s ease;
    }
    summary span:nth-child(2) {
      width: 14px;
    }
    .mobile-menu[open] summary span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .mobile-menu[open] summary span:nth-child(2) {
      opacity: 0;
    }
    .mobile-menu[open] summary span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
    .mobile-menu nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      opacity: 1;
      transform: none;
      padding: calc(94px + 32px + env(safe-area-inset-top, 0px))
        var(--page-gutter) max(32px, env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: rgb(5 5 7 / 94%);
      border: 0;
      border-radius: 0;
      box-shadow: none;
      transition:
        opacity 0.32s ease,
        transform 0.32s ease;
    }
    .mobile-menu:not([open]) nav {
      display: none;
    }
    .mobile-menu.is-closing nav {
      opacity: 0;
      transform: translateY(-10px);
    }
    @starting-style {
      .mobile-menu[open] nav {
        opacity: 0;
        transform: translateY(-10px);
      }
    }
    .mobile-menu .nav-link {
      display: flex;
      flex-direction: row;
      gap: 0;
      padding: 16px 14px;
      font-size: 20px;
      line-height: 30px;
      color: #c5bad4;
      border-radius: 14px;
    }
    /* Mobile state cue = violet fill; the desktop underline would be a stray line. */
    .mobile-menu .nav-underline {
      display: none;
    }
    .mobile-menu .nav-link:not(.active):hover,
    .mobile-menu .nav-link:not(.active):focus-visible {
      color: #fff;
      background: rgb(255 255 255 / 8%);
    }
    .mobile-menu .nav-link.active {
      color: #fff;
      background: linear-gradient(
        90deg,
        rgb(108 59 255 / 30%),
        rgb(108 59 255 / 0%)
      );
    }
    .mobile-menu nav :global(.button) {
      width: 100%;
      margin-top: 32px;
    }
  }
  @media (max-width: 760px) {
    .mobile-menu nav {
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.nav-warm)) .navbar.is-ready .brand,
    :global(html:not(.nav-warm)) .navbar.is-ready .desktop-nav .nav-link,
    :global(html:not(.nav-warm))
      .navbar.is-ready
      .desktop-cta
      :global(.button) {
      animation: nav-in 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-delay: calc(var(--i, 0) * 55ms + 80ms);
    }
    :global(html:not(.nav-warm))
      .navbar.is-ready
      .desktop-cta
      :global(.button) {
      animation-delay: 0.5s;
    }
  }
  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    summary span,
    .nav-link,
    .mobile-menu nav,
    .navbar,
    .navbar-inner,
    .brand,
    summary,
    .navbar::before,
    .navbar::after {
      transition: none;
    }
  }
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
<script>
  // Re-initialised after every client-side navigation: the navbar element is
  // replaced by the swap, and the `window`/`document` listeners must not pile up.
  let navController: AbortController | undefined;
  const initNavbar = () => {
    navController?.abort();
    navController = new AbortController();
    const { signal } = navController;

    const navbar = document.querySelector<HTMLElement>('.navbar');

    const syncScroll = () => {
      if (!navbar) return;
      const y = window.scrollY;
      // Small hysteresis so sitting on the threshold does not flicker the backing.
      const wasScrolled = navbar.classList.contains('is-scrolled');
      navbar.classList.toggle('is-scrolled', wasScrolled ? y > 6 : y > 10);
    };

    syncScroll();
    let scrollRaf = 0;
    addEventListener(
      'scroll',
      () => {
        if (scrollRaf) return;
        scrollRaf = requestAnimationFrame(() => {
          scrollRaf = 0;
          syncScroll();
        });
      },
      { passive: true, signal },
    );
    addEventListener('resize', syncScroll, { signal });

    const armNav = () => navbar?.classList.add('is-ready');
    if (document.documentElement.classList.contains('splash-done')) {
      armNav();
    } else {
      addEventListener('ds:splash-done', armNav, { once: true });
      setTimeout(armNav, 7000);
    }

    const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    const nav = menu?.querySelector<HTMLElement>('nav');
    const summary = menu?.querySelector<HTMLElement>('summary');
    const reduceMotion = () =>
      matchMedia('(prefers-reduced-motion: reduce)').matches;

    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    const openMenu = () => {
      if (!menu) return;
      clearTimeout(closeTimer);
      menu.classList.remove('is-closing');
      menu.open = true;
      window.dispatchEvent(
        new CustomEvent('ds:sfx', { detail: { cue: 'open' } }),
      );
      nav?.querySelector<HTMLElement>('a')?.focus();
    };

    const closeMenu = () => {
      if (!menu?.open) return;
      window.dispatchEvent(
        new CustomEvent('ds:sfx', { detail: { cue: 'close' } }),
      );
      if (reduceMotion() || !nav) {
        menu.classList.remove('is-closing');
        menu.open = false;
        return;
      }
      if (menu.classList.contains('is-closing')) return;
      menu.classList.add('is-closing');
      const finish = (event?: Event) => {
        if (event && event.target !== nav) return;
        nav.removeEventListener('transitionend', finish);
        clearTimeout(closeTimer);
        menu.classList.remove('is-closing');
        menu.open = false;
      };
      nav.addEventListener('transitionend', finish);
      closeTimer = setTimeout(finish, 450);
    };

    summary?.addEventListener('click', (event) => {
      event.preventDefault();
      if (menu?.open) closeMenu();
      else openMenu();
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && menu?.open) {
          closeMenu();
          summary?.focus();
        }
      },
      { signal },
    );
    document.addEventListener(
      'click',
      (event) => {
        if (
          menu?.open &&
          event.target instanceof Node &&
          !menu.contains(event.target)
        )
          closeMenu();
      },
      { signal },
    );

    // Keep the obscured page out of the tab order while the full-screen menu is
    // open, so keyboard focus cannot leak behind the overlay.
    const background = [
      document.querySelector('main'),
      document.querySelector('.footer'),
      document.querySelector('.skip-link'),
    ].filter((el): el is HTMLElement => el instanceof HTMLElement);
    const syncLock = () => {
      const open = !!menu?.open;
      document.body.classList.toggle('menu-open', open);
      for (const el of background) el.toggleAttribute('inert', open);
    };
    menu?.addEventListener('toggle', syncLock);
    addEventListener(
      'resize',
      () => {
        if (menu?.open && innerWidth > 1050) {
          clearTimeout(closeTimer);
          menu.classList.remove('is-closing');
          menu.open = false;
        }
      },
      { signal },
    );
  };

  document.addEventListener('astro:page-load', initNavbar);
</script>
