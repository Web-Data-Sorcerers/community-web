---
import Button from './Button.astro';
import type { RoleDetail } from '../data/roles';
interface Props {
  role: RoleDetail;
}
const { role } = Astro.props;
const waNumber = role.whatsapp ?? '6285171516704';
const waMessage = encodeURIComponent(
  `Halo Kak ${role.contact}, saya ingin bertanya mengenai recruitment role ${role.title} di Data Sorcerers.`,
);
---

<main class="role-detail">
  <span class="detail-wave" aria-hidden="true" />
  <div class:list={['role-detail-inner', { centered: role.centered }]}>
    <div class:list={['role-head', { tight: role.tight }]}>
      <a
        class="back"
        href="/recruitment#available-roles"
        data-sfx="select"
        data-sfx-hover="hover"
      >
        <img src="/images/hods/arrow.svg" width="24" height="24" alt="" />
        <span>Back to Open Roles</span>
      </a>

      <div class="role-card">
        <img
          class="role-art"
          src={role.cardImage}
          srcset={`/images/roles/role-${role.id}-1280.webp 1280w, /images/roles/role-${role.id}-2560.webp 2560w`}
          sizes="1280px"
          width="1280"
          height="279"
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="role-card-row">
          <div class="role-card-left">
            <h1>{role.title}</h1>
            <div class="chips">
              {role.chips.map((chip, index) => (
                <span class="chip">
                  {index > 0 && <span class="dot" aria-hidden="true" />}
                  <span class="chip-label">{chip}</span>
                </span>
              ))}
            </div>
            <div class="deadline">
              <img src="/images/roles/date.svg" width="28" height="28" alt="" />
              <span>{role.deadline}</span>
            </div>
          </div>
          <Button variant="apply" href={`/recruitment/apply?role=${role.id}`}>
            Apply Now
          </Button>
        </div>
      </div>
    </div>

    <div class="role-sections">
      <section class="block">
        <h2>ABOUT THIS ROLE</h2>
        <p class="body">{role.about}</p>
      </section>
      <section class="block">
        <h2>REQUIREMENT</h2>
        <ul class="bullets">
          {role.requirements.map((item) => (
            <li>
              <span class="dot" aria-hidden="true" />
              <span class="bullet-text">{item}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <a
      class="contact"
      href={`https://wa.me/${waNumber}?text=${waMessage}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Hubungi Contact Person ${role.contact} via WhatsApp`}
      data-sfx="click"
      data-sfx-hover="hover"
    >
      <h2>CONTACT PERSON</h2>
      <div class="contact-person">
        <img src="/images/roles/whatsapp.svg" width="24" height="24" alt="" />
        <span>{role.contact}</span>
      </div>
    </a>
  </div>
</main>
<style>
  /* The gradient is full-bleed; the content stays on the 1440 grid. */
  .role-detail {
    position: relative;
    width: 100%;
    background: linear-gradient(-9deg, rgb(108 59 255 / 50%) 0%, #050507 19%);
  }
  /* One-way glow wave along the bottom edge: the same oversized glow.svg sweep
     as the CTA, so there is no tiling seam. Hidden under reduced motion so the
     static page stays pixel-identical to the reference. */
  .detail-wave {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 0;
    height: 150px;
    overflow: hidden;
    pointer-events: none;
  }
  .detail-wave::before {
    content: '';
    position: absolute;
    left: -6%;
    bottom: -330px;
    width: 112%;
    height: 480px;
    background: url('/images/recruitment/glow.svg') center bottom / 100% 100%
      no-repeat;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .detail-wave::before {
      animation: detail-wave-drift 12s linear infinite;
    }
  }
  @keyframes detail-wave-drift {
    0% {
      translate: -60px 0;
      opacity: 0.35;
    }
    50% {
      opacity: 0.6;
    }
    100% {
      translate: 60px 0;
      opacity: 0.35;
    }
  }
  .role-detail-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 56px;
    width: 100%;
    max-width: 1440px;
    min-height: 1280px;
    margin-inline: auto;
    padding: 80px;
  }
  .role-detail-inner.centered {
    justify-content: center;
  }
  .role-head {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .role-head.tight {
    gap: 28px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    align-self: flex-start;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }
  .back img {
    display: block;
    width: 24px;
    height: 24px;
  }
  .role-card {
    position: relative;
    isolation: isolate;
    width: 1280px;
    max-width: 100%;
    height: 279px;
    border-radius: 20px;
  }
  .role-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(136deg, #e0dcff 2%, #2e276c 51%, #cbc5ff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .role-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }
  .role-card-row {
    position: absolute;
    left: 42px;
    top: 58px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    width: 1196px;
    max-width: calc(100% - 84px);
  }
  .role-card-left {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    line-height: 57.6px;
    background: linear-gradient(270deg, #fff, #ede8ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 14px;
  }
  /* Each separator travels with the label it precedes, so wrapping never
     strands a lone dot at the start or end of a line. */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .chip-label {
    font-size: 18px;
    font-weight: 500;
    line-height: 39px;
    color: #fff;
    white-space: nowrap;
  }
  .deadline {
    display: flex;
    align-items: center;
    gap: 16px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    line-height: 39px;
  }
  .deadline img {
    display: block;
    width: 28px;
    height: 28px;
  }
  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6c3bff 17%, #ede8ff 50%, #6c3bff 83%);
  }
  .role-sections {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    line-height: 39px;
    color: #fff;
  }
  .body {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #ede8ff;
  }
  .bullets {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    display: flex;
    align-items: center;
    gap: 23px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }
  .bullet-text {
    white-space: pre-line;
  }
  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 347px;
    height: 134px;
    border-radius: 20px;
    background: rgb(98 80 255 / 10%);
    box-shadow: inset 0 0 0 1px transparent;
    position: relative;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .contact::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(136deg, #e0dcff 2%, #2e276c 51%, #cbc5ff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .contact-person {
    display: flex;
    align-items: center;
    gap: 16px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    line-height: 39px;
  }
  .contact-person img {
    display: block;
    width: 24px;
    height: 24px;
  }
  .contact:focus-visible {
    outline: 2px solid #9b7bff;
    outline-offset: 4px;
  }
  .contact:is(:hover, :focus-visible) {
    background: rgb(98 80 255 / 20%);
    box-shadow: 0 8px 24px -4px rgb(108 59 255 / 40%);
  }
  .contact:is(:hover, :focus-visible)::after {
    background: linear-gradient(136deg, #ffffff 0%, #9b7bff 50%, #ffffff 100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact {
      transition:
        background 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .contact:is(:hover, :focus-visible) {
      transform: translateY(-2px);
    }
    .contact-person img {
      transition: transform 0.25s ease;
    }
    .contact:is(:hover, :focus-visible) .contact-person img {
      transform: scale(1.12);
    }
  }
  @media (max-width: 900px) {
    /* Fill the viewport so the gradient never leaves a body-coloured gap below it when the content is shorter than the screen (phones with the browser chrome hidden). Desktop keeps the exact 1280px reference frame. */
    .role-detail {
      min-height: 100vh;
      min-height: 100lvh;
    }
    .role-detail-inner {
      min-height: 0;
      gap: 40px;
      padding: calc(40px + env(safe-area-inset-top, 0px)) 24px 40px;
    }
    .role-card {
      height: auto;
      min-height: 220px;
    }
    .role-card-row {
      position: relative;
      left: 0;
      top: 0;
      flex-direction: column;
      align-items: flex-start;
      width: auto;
      max-width: none;
      padding: 24px;
    }
    h1 {
      font-size: 32px;
    }
    .chips {
      gap: 8px 12px;
    }
    .chip {
      gap: 12px;
    }
    .deadline {
      gap: 10px;
    }
    .chip-label,
    .deadline,
    .contact-person {
      font-size: 16px;
      line-height: 27px;
    }
    h2 {
      font-size: 22px;
      line-height: 33px;
    }
    .body,
    .bullets li {
      font-size: 16px;
      line-height: 24px;
    }
    .contact {
      width: 100%;
      max-width: 347px;
      height: auto;
      padding: 24px;
    }
  }
</style>
