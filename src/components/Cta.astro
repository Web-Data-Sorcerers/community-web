---
import { canNavigateToTarget } from '../data/site-visibility-registry.mjs';
const canVisit = (page: string, section?: string) =>
  !Astro.locals.visibility ||
  canNavigateToTarget(Astro.locals.visibility, page, section);
import Button from './Button.astro';
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-panel">
    <div class="cta-copy">
      <h2 id="cta-title">Ready to Become a Sorcery?</h2>
      <p>
        Join a community where your learning can become experimentation, your
        ideas can become projects, and your work can create real impact.
      </p>
    </div>
    <div class="cta-actions">
      {canVisit('recruitment') && (
        <Button variant="community" href="/recruitment">
          Join the Community
        </Button>
      )}
    </div>
    <div class="glow-frame" aria-hidden="true">
      <div class="glow-art">
        <img src="/images/recruitment/glow.svg" alt="" loading="lazy" />
      </div>
    </div>
  </div>
</section>
<style>
  .cta {
    padding: 80px;
    background: #050507;
  }
  .cta-panel {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 48px;
    width: 100%;
    max-width: 1280px;
    height: 360px;
    margin-inline: auto;
    padding: 64px 80px;
    border-radius: 20px;
    background: rgb(98 80 255 / 10%);
    overflow: hidden;
  }
  .cta-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(110deg, #e0dcff 0%, #2e276c 50%, #e0dcff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .cta-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 100%;
    text-align: center;
  }
  h2 {
    margin: 0;
    font: 700 56px/67.2px var(--font-display);
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  p {
    margin: 0;
    width: 586px;
    max-width: 100%;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.011em;
    color: #fff;
  }
  /* Same glow treatment as the homepage CTA (the rotated, oversized glow.svg). */
  .glow-frame {
    position: absolute;
    z-index: -1;
    left: 269.83px;
    top: 271px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1000.331px;
    height: 271.502px;
    pointer-events: none;
  }
  .glow-art {
    position: relative;
    flex: none;
    width: 992px;
    height: 233px;
    transform: rotate(-2.23deg);
  }
  .glow-art img {
    position: absolute;
    left: -81.8%;
    top: -33.43%;
    width: 200.33%;
    height: 229.49%;
    max-width: none;
  }
  /* Same one-way sweep as the homepage/recruitment CTA, so both glows read as one direction. */
  @media (prefers-reduced-motion: no-preference) {
    .glow-art {
      animation: cta-glow-sweep 6.5s linear infinite;
    }
    .cta.is-idle .glow-art {
      animation-play-state: paused;
    }
  }
  @keyframes cta-glow-sweep {
    0% {
      translate: -150px 0;
      scale: 1;
      opacity: 0.5;
    }
    25% {
      opacity: 1;
    }
    50% {
      scale: 1.04;
    }
    75% {
      opacity: 1;
    }
    100% {
      translate: 150px 0;
      scale: 1;
      opacity: 0.5;
    }
  }
  @media (max-width: 1199px) {
    .cta-panel {
      height: auto;
      justify-content: flex-start;
      padding-inline: 40px;
    }
    .glow-frame {
      left: calc(100% - 1010px);
      top: auto;
      bottom: -125px;
    }
  }
  @media (max-width: 760px) {
    .cta {
      padding: 40px 24px;
    }
    .cta-panel {
      gap: 32px;
      padding: 48px 24px;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.214286;
    }
  }
</style>
