<script>
  const mobile = matchMedia('(max-width: 767px), (pointer: coarse)');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let cleanup: (() => void) | undefined;
  let generation = 0;
  let fallback: number | undefined;
  const stop = () => {
    generation++;
    window.clearTimeout(fallback);
    fallback = undefined;
    cleanup?.();
    cleanup = undefined;
  };
  const start = async () => {
    stop();
    if (reduce.matches) return;
    if (!document.documentElement.classList.contains('splash-done')) {
      fallback = window.setTimeout(load, 7000);
      return;
    }
    await load();
  };
  const load = async () => {
    const current = generation;
    if (mobile.matches) {
      const { initMobileMotion } = await import('../scripts/motion-mobile');
      if (current === generation) cleanup = initMobileMotion();
    } else {
      const { initMotion, destroyMotion } = await import('../scripts/motion');
      if (current === generation) {
        initMotion();
        cleanup = destroyMotion;
      }
    }
  };

  document.addEventListener('astro:page-load', start);
  window.addEventListener('ds:splash-done', start);
  document.addEventListener('astro:before-swap', stop);
  mobile.addEventListener('change', start);
  reduce.addEventListener('change', start);
</script>
