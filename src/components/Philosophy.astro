---
interface Props {
  variant?: 'home' | 'about';
}
const { variant = 'home' } = Astro.props;

const principles = [
  {
    icon: 'learn',
    title: 'LEARN',
    description: 'Build Knowledge',
    width: 63,
    height: 64,
  },
  {
    icon: 'ship',
    title: 'SHIP',
    description: 'Release',
    width: 59,
    height: 60,
  },
  {
    icon: 'experiment',
    title: 'EXPERIMENT',
    description: 'Test Ideas',
    width: 63,
    height: 64,
  },
  {
    icon: 'impact',
    title: 'IMPACT',
    description: 'Change',
    width: 63,
    height: 64,
  },
  {
    icon: 'research',
    title: 'RESEARCH / BUILD',
    description: 'Discover / Create',
    width: 59,
    height: 60,
  },
];
---

<section
  id="our-philosophy"
  class:list={['philosophy', { 'is-about': variant === 'about' }]}
  aria-labelledby="philosophy-title"
>
  <div class="canvas">
    <div class="illustration" aria-hidden="true">
      <picture>
        <source
          srcset="/images/philosophy/sorcerer-1x.avif 861w, /images/philosophy/sorcerer-2x.avif 1290w"
          sizes="(max-width: 760px) 100vw, 861px"
          type="image/avif"
        />
        <source
          srcset="/images/philosophy/sorcerer-1x.webp 861w, /images/philosophy/sorcerer-2x.webp 1290w"
          sizes="(max-width: 760px) 100vw, 861px"
          type="image/webp"
        />
        <img
          src="/images/philosophy/sorcerer-1x.webp"
          width="861"
          height="770"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
      <span class="fx">
        <span class="aura"></span>
        <span class="pulse"></span>
        <span class="spark spark-a"></span>
        <span class="spark spark-b"></span>
        <span class="spark spark-c"></span>
        <span class="spark spark-d"></span>
        <span class="spark spark-e"></span>
        <span class="spark spark-f"></span>
        <span class="spark spark-g"></span>
        <span class="spark spark-h"></span>
        <span class="spark spark-i"></span>
        <span class="spark spark-j"></span>
        <span class="spark spark-k"></span>
        <span class="spark spark-l"></span>
        <span class="spark spark-m"></span>
        <span class="spark spark-n"></span>
        <span class="spark spark-o"></span>
        <span class="spark spark-p"></span>
        <span class="spark spark-q"></span>
        <span class="spark spark-r"></span>
      </span>
    </div>
    <div class="content">
      <div class="heading">
        <span class="eyebrow">Our Philosphy</span>
        <h2 id="philosophy-title">
          <span>We Don't&nbsp; Just Learn AI</span>
          <span>We Build With It</span>
        </h2>
      </div>
      <ul class="principles" aria-label="Our principles">
        {principles.map(({ icon, title, description, width, height }) => (
          <li>
            <img
              src={`/images/philosophy/${icon}.webp`}
              width={width}
              height={height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <div class="principle-copy">
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .philosophy {
    position: relative;
    container-type: inline-size;
    isolation: isolate;
    overflow: clip;
    background: var(--color-background);
  }
  /* Home variant fills one viewport; the About variant keeps its Figma height and is migrated in a later pass. */
  .philosophy:not(.is-about) {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  .philosophy:not(.is-about) > .canvas {
    width: 100%;
  }
  .philosophy.is-about {
    /* Gradient fill (Figma handles p0(0.553,0.545) -> p1(0.798,1.681), stops #050507 -> #6c3bff) fitted from the node PNG; painted on the section (not the canvas) so it blends continuously into the Our Ecosystem gradient below at every viewport width. The canvas is NOT zoomed — artwork anchors to the section edge via cqw, content stays at Figma 1440 proportions. */
    background: linear-gradient(159.7deg, #050507 54.82%, #6c3bff 133.76%);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  .philosophy.is-about > .canvas {
    width: 100%;
  }

  /* The home node has a standalone bottom-right glow ellipse (1430:2053); the About node (1439:4219) does not, so hide the home glow on the About variant. */
  .philosophy.is-about .canvas::before {
    display: none;
  }
  .canvas {
    position: relative;
    min-height: 837px;
    max-width: 1440px;
    margin-inline: auto;
  }
  /* About variant deliberately does NOT zoom the canvas — the gradient stays section-level (full-bleed) and the artwork anchors to the section edge via the cqw formula below, matching the Home variant behaviour. */
  /* The exported blur extends 350px beyond each side of the 280px ellipse. */
  .canvas::before {
    content: '';
    position: absolute;
    left: 845px;
    top: 298px;
    width: 980px;
    height: 980px;
    background: url('/images/philosophy/glow.webp') center / contain no-repeat;
    pointer-events: none;
  }
  .illustration {
    position: absolute;
    left: 0;
    top: 12px;
    width: 861px;
    height: 770px;
    pointer-events: none;
  }
  .illustration picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .illustration img {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Crystal-centered FX. Hidden unless motion is allowed so the reduced-motion
     render stays pixel-identical to the reference export. */
  .fx {
    --crystal-x: 57%;
    --crystal-y: 52%;
    --u: 1;
    position: absolute;
    inset: 0;
    contain: paint;
    opacity: 0;
    pointer-events: none;
  }
  .fx .aura,
  .fx .pulse,
  .fx .spark {
    position: absolute;
    left: var(--crystal-x);
    top: var(--crystal-y);
    mix-blend-mode: screen;
  }
  .aura {
    width: 56%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgb(155 123 255 / 20%) 45deg,
      transparent 110deg,
      transparent 190deg,
      rgb(108 59 255 / 16%) 235deg,
      transparent 300deg
    );
    -webkit-mask: radial-gradient(
      circle closest-side,
      transparent 32%,
      #000 54%,
      transparent 92%
    );
    mask: radial-gradient(
      circle closest-side,
      transparent 32%,
      #000 54%,
      transparent 92%
    );
  }
  .pulse {
    width: 38%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      circle closest-side,
      rgb(160 130 255 / 18%),
      transparent 82%
    );
  }
  .spark {
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    border-radius: 50%;
    background: #d8ccff;
    box-shadow: 0 0 10px 2px rgb(139 92 246 / 75%);
  }
  .spark-a {
    --s: 5px;
    --r: 150px;
    --a: 0deg;
    --dur: 11s;
    --tw: 3.1s;
  }
  .spark-b {
    --s: 6px;
    --r: 205px;
    --a: 140deg;
    --dur: 16s;
    --tw: 4.3s;
  }
  .spark-c {
    --s: 4px;
    --r: 118px;
    --a: 250deg;
    --dur: 8.5s;
    --tw: 2.6s;
  }
  .spark-d {
    --s: 4px;
    --r: 168px;
    --a: 60deg;
    --dur: 13s;
    --tw: 3.7s;
  }
  .spark-e {
    --s: 7px;
    --r: 236px;
    --a: 195deg;
    --dur: 19s;
    --tw: 4.9s;
  }
  .spark-f {
    --s: 3px;
    --r: 96px;
    --a: 300deg;
    --dur: 9.5s;
    --tw: 2.2s;
  }
  .spark-g {
    --s: 5px;
    --r: 128px;
    --a: 20deg;
    --dur: 12s;
    --tw: 3.4s;
  }
  .spark-h {
    --s: 2px;
    --r: 68px;
    --a: 70deg;
    --dur: 7.5s;
    --tw: 2s;
  }
  .spark-i {
    --s: 3px;
    --r: 92px;
    --a: 110deg;
    --dur: 10s;
    --tw: 2.8s;
  }
  .spark-j {
    --s: 2px;
    --r: 138px;
    --a: 160deg;
    --dur: 9s;
    --tw: 2.4s;
  }
  .spark-k {
    --s: 4px;
    --r: 178px;
    --a: 40deg;
    --dur: 14s;
    --tw: 3.9s;
  }
  .spark-l {
    --s: 3px;
    --r: 200px;
    --a: 225deg;
    --dur: 12.5s;
    --tw: 3.2s;
  }
  .spark-m {
    --s: 5px;
    --r: 220px;
    --a: 280deg;
    --dur: 17s;
    --tw: 4.4s;
  }
  .spark-n {
    --s: 2px;
    --r: 80px;
    --a: 330deg;
    --dur: 8s;
    --tw: 2.1s;
  }
  .spark-o {
    --s: 4px;
    --r: 155px;
    --a: 15deg;
    --dur: 11.5s;
    --tw: 3s;
  }
  .spark-p {
    --s: 3px;
    --r: 185px;
    --a: 95deg;
    --dur: 13.5s;
    --tw: 3.6s;
  }
  .spark-q {
    --s: 2px;
    --r: 125px;
    --a: 205deg;
    --dur: 9.8s;
    --tw: 2.5s;
  }
  .spark-r {
    --s: 4px;
    --r: 246px;
    --a: 250deg;
    --dur: 18.5s;
    --tw: 4.7s;
  }
  @media (min-width: 1441px) {
    .illustration {
      /* Anchor the artwork to the section edge outside the centered canvas. */
      left: calc((1440px - 100cqw) / 2);
    }
  }
  .content {
    position: relative;
    margin-left: 855px;
    padding-top: 150px;
    width: 471px;
    display: flex;
    flex-direction: column;
    gap: 74px;
  }
  .heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    width: 471px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    height: 26px;
    padding: 4px 8px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    white-space: nowrap;
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 40%);
  }
  h2 {
    margin: 0;
    width: 471px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 68px;
    background: linear-gradient(270deg, #fff, #ede8ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .philosophy h2 {
    font-family: var(--font-display);
    font-weight: 700;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  h2 span {
    display: block;
    white-space: nowrap;
  }
  .philosophy h2 span {
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px 92px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }
  .philosophy li {
    gap: 24px;
  }
  @media (min-width: 1400px) {
    .philosophy .content {
      position: absolute;
      left: 766px;
      top: 205px;
      margin-left: 0;
      padding-top: 0;
      width: 591px;
      gap: 48px;
    }
    .philosophy .heading {
      gap: 8px;
      width: 591px;
    }
    .philosophy h2 {
      width: 591px;
      font-size: 56px;
      line-height: 67px;
      letter-spacing: 0;
    }
    .philosophy h2 span {
      white-space: nowrap;
    }
    .philosophy .principles {
      width: 591px;
      height: 248px;
    }
  }
  li img {
    display: block;
    flex-shrink: 0;
    object-fit: contain;
  }
  .principle-copy {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3,
  p {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-body);
  }
  h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 27px;
    color: #fff;
  }
  p {
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    color: #fff;
  }
  .principles li h3 {
    transition: color 0.35s ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fx {
      opacity: 1;
    }
    .aura {
      animation: phil-aura 18s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }
    .pulse {
      animation: phil-pulse 5.5s ease-in-out infinite;
    }
    .spark {
      animation:
        phil-orbit var(--dur) cubic-bezier(0.5, 0, 0.5, 1) infinite,
        phil-twinkle var(--tw) ease-in-out infinite;
    }
    .illustration picture,
    .illustration .fx {
      animation: phil-float 3.5s cubic-bezier(0.37, 0, 0.63, 1) infinite
        alternate;
    }
    .philosophy:not(.is-idle) .illustration picture,
    .philosophy:not(.is-idle) .illustration .fx {
      will-change: transform;
    }
    /* Park the aura/pulse/sparks/float while the section is off-screen. */
    .philosophy.is-idle .aura,
    .philosophy.is-idle .pulse,
    .philosophy.is-idle .spark,
    .philosophy.is-idle .illustration picture,
    .philosophy.is-idle .fx {
      animation-play-state: paused;
    }
    .principles li {
      transition: transform 0.35s ease;
    }
    .principles li:hover {
      transform: translateY(-3px);
    }
    .principles li img {
      transition:
        transform 0.35s ease,
        filter 0.35s ease;
    }
    .principles li:hover img {
      transform: scale(1.1);
      filter: drop-shadow(0 0 12px rgb(108 59 255 / 85%)) brightness(1.15);
    }
    .principles li:hover h3 {
      color: #c9b8ff;
    }
  }
  @keyframes phil-aura {
    0% {
      transform: rotate(0deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    30% {
      transform: rotate(152deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    54% {
      transform: rotate(176deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    82% {
      transform: rotate(332deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @keyframes phil-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.94);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.08);
    }
  }
  @keyframes phil-orbit {
    0% {
      transform: rotate(var(--a)) translateX(calc(var(--r) * var(--u)));
      animation-timing-function: cubic-bezier(0.55, 0, 0.45, 1);
    }
    30% {
      transform: rotate(calc(var(--a) + 158deg))
        translateX(calc(var(--r) * var(--u)));
      animation-timing-function: cubic-bezier(0.55, 0, 0.45, 1);
    }
    52% {
      transform: rotate(calc(var(--a) + 182deg))
        translateX(calc(var(--r) * var(--u)));
      animation-timing-function: cubic-bezier(0.55, 0, 0.45, 1);
    }
    80% {
      transform: rotate(calc(var(--a) + 334deg))
        translateX(calc(var(--r) * var(--u)));
    }
    100% {
      transform: rotate(calc(var(--a) + 360deg))
        translateX(calc(var(--r) * var(--u)));
    }
  }
  @keyframes phil-twinkle {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes phil-float {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -10px, 0);
    }
  }
  @media (min-width: 761px) and (max-width: 1399px) {
    .fx {
      --u: 0.62;
    }
    .canvas {
      min-height: 760px;
    }
    .illustration {
      width: 60%;
      height: auto;
      aspect-ratio: 861 / 770;
      top: 100px;
    }
    .content {
      position: relative;
      left: auto;
      top: auto;
      margin-left: 54%;
      padding-top: 120px;
      width: calc(46% - var(--page-gutter));
      gap: 56px;
    }
    .heading,
    h2,
    .principles {
      width: 100%;
    }
    h2 {
      font-size: clamp(24px, 3.5vw, 54px);
      line-height: 1.214286;
    }
    h2 span {
      white-space: normal;
    }
    .principles {
      height: auto;
      column-gap: 24px;
    }
    li {
      gap: 16px;
    }
    li img {
      width: 42px;
      height: 44px;
    }
    h3 {
      font-size: 13px;
      line-height: 21px;
    }
    p {
      font-size: 11px;
      line-height: 18px;
    }
    .canvas::before {
      left: calc(80% - 350px);
    }
  }
  @media (max-width: 760px) {
    .fx {
      --u: 0.42;
    }
    .canvas {
      min-height: 0;
      display: flex;
      flex-direction: column;
      padding: 64px var(--page-gutter) 0;
    }
    .content {
      position: relative;
      left: auto;
      top: auto;
      margin-left: 0;
      padding-top: 0;
      width: 100%;
      gap: 40px;
    }
    .heading,
    h2,
    .principles {
      width: 100%;
    }
    h2 {
      font-size: clamp(22px, 6.5vw, 42px);
      line-height: 1.2;
    }
    h2 span {
      white-space: normal;
    }
    .principles {
      height: auto;
      column-gap: 20px;
      row-gap: 26px;
    }
    li {
      gap: 16px;
    }
    li img {
      width: 42px;
      height: 44px;
    }
    h3 {
      font-size: 13px;
      line-height: 21px;
    }
    p {
      font-size: 11px;
      line-height: 18px;
    }
    .principle-copy {
      gap: 4px;
    }
    .philosophy.is-about {
      min-height: 0;
      background: linear-gradient(
        180deg,
        #050507 0%,
        #180d38 35%,
        #050507 90%,
        #050507 100%
      );
    }
    .illustration {
      position: relative;
      order: 1;
      left: calc(-1 * var(--page-gutter));
      top: auto;
      width: calc(100% + 2 * var(--page-gutter));
      height: auto;
      aspect-ratio: 861 / 770;
      margin-top: 24px;
      -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
    }
    .canvas::before {
      left: calc(65% - 350px);
      top: -90px;
      opacity: 0.5;
    }
  }
  @media (max-width: 360px) {
    .principles {
      grid-template-columns: 1fr;
    }
    li img {
      width: 50px;
      height: 52px;
    }
    h3 {
      font-size: 15px;
    }
    p {
      font-size: 13px;
    }
  }
</style>
