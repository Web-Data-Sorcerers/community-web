---
import Starfield from './Starfield.astro';
import { faqItems as items } from '../data/faq';
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <Starfield />
  <h2 id="faq-title">FAQ</h2>

  <div class="faq-list">
    {items.map((item) => (
      <details class="faq-item">
        <summary data-sfx-hover="hover">
          <span class="faq-q">{item.q}</span>
          <img
            class="faq-arrow"
            src="/images/recruitment/chevron-down.svg"
            width="24"
            height="24"
            alt=""
            loading="lazy"
          />
        </summary>
        <div class="faq-a-wrap">
          <p class="faq-a">{item.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>
<style>
  .faq {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 56px;
    /* Full-screen standard (#9): one section = one screen, content centred. */
    min-height: 100vh;
    min-height: 100svh;
    padding: 80px;
    /* Living star sky, same as the home "Four Pillars of Innovation" section. */
    position: relative;
    isolation: isolate;
    background-color: #000;
  }
  h2 {
    margin: 0;
    width: 100%;
    max-width: 1280px;
    font: 700 56px/67.2px var(--font-display);
    text-transform: uppercase;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
    max-width: 1280px;
  }
  .faq-item {
    position: relative;
    border-radius: 20px;
    background: rgb(255 255 255 / 15%);
  }
  .faq-item::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    /* Figma stroke maps the gradient horizontally (ref top/bottom rims match per x). */
    background: linear-gradient(90deg, #ede8ff 0%, #2e276c 50%, #ede8ff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 19px 32px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-size: 26px;
    font-weight: 500;
    line-height: 39px;
    color: #fff;
    white-space: pre-line;
  }
  .faq-arrow {
    flex: none;
    display: block;
    width: 24px;
    height: 24px;
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Closed = chevron-down, open = chevron-up. */
  .faq-item.is-open .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-a-wrap {
    height: 0;
    overflow: hidden;
    transition: height 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Fallback when JS is unavailable (native <details> toggle). */
  .faq-item.is-open .faq-a-wrap,
  .faq-item[open] .faq-a-wrap {
    height: auto;
  }
  .faq-a {
    margin: 24px 0 0;
    padding: 0 32px 19px;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #fff;
    white-space: pre-line;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-arrow,
    .faq-a-wrap {
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .faq {
      gap: 40px;
      padding: 64px 24px;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.214286;
    }
    .faq-list {
      gap: 16px;
    }
    summary {
      gap: 14px;
      padding: 14px 20px;
    }
    .faq-q {
      font-size: 18px;
      line-height: 27px;
    }
    .faq-a {
      margin-top: 16px;
      padding: 0 20px 14px;
      font-size: 15px;
      line-height: 24px;
    }
  }
</style>

<script>
  // Smoothly animates the native <details>/<summary> accordion: the panel is
  // measured and then transitioned between 0 and its natural height, so the
  // expansion never snaps. Under prefers-reduced-motion the toggle is instant.
  const DURATION = 320;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const initFaq = () => {
    document
      .querySelectorAll<HTMLDetailsElement>('details.faq-item')
      .forEach((details) => {
        const summary = details.querySelector('summary');
        const panel = details.querySelector<HTMLElement>('.faq-a-wrap');
        if (!summary || !panel) return;

        let version = 0;

        summary.addEventListener('click', (event) => {
          event.preventDefault();

          const opening = !details.open;
          const token = ++version;
          details.classList.toggle('is-open', opening);
          window.dispatchEvent(
            new CustomEvent('ds:sfx', {
              detail: { cue: opening ? 'open' : 'close' },
            }),
          );

          if (reduceMotion.matches) {
            details.open = opening;
            panel.style.height = '';
            return;
          }

          const settle = () => {
            if (token !== version) return;
            panel.style.height = '';
            if (!opening) details.open = false;
          };

          if (opening) {
            details.open = true;
            const target = panel.scrollHeight;
            panel.style.height = '0px';
            void panel.offsetHeight;
            panel.style.height = `${target}px`;
          } else {
            panel.style.height = `${panel.scrollHeight}px`;
            void panel.offsetHeight;
            panel.style.height = '0px';
          }

          panel.addEventListener('transitionend', settle, { once: true });
          setTimeout(settle, DURATION + 80);
        });
      });
  };

  document.addEventListener('astro:page-load', initFaq);
</script>
