// Reference loading.png: 1672×941; center (836,348); sampled ring radii.
const rings = [182, 206, 216, 245, 250, 259];
const polar = (r: number, a: number) => [
  836 + r * Math.cos(a),
  348 + r * Math.sin(a),
];
const ticks = Array.from({ length: 120 }, (_, i) => {
  const a = (i * Math.PI) / 60;
  const [x1, y1] = polar(229, a);
  const [x2, y2] = polar(i % 5 ? 232 : 237, a);
  return { x1, y1, x2, y2 };
});
const glyphs = [
  'M-7 -10 L7 10 M7 -10 L-7 10 M0 -17 V17 M-9 0 H9',
  'M-9 9 L0 -12 L9 9 Z M0 -17 V16 M-9 14 H9',
  'M-9 -7 L9 7 M-9 7 L9 -7 M0 -16 V16 M-5 -12 H5',
  'M-8 -12 V12 L8 0 Z M-12 0 H12 M3 -14 V14',
  'M-7 -13 L7 -6 L-7 3 L7 12 M0 -16 V16',
  'M-9 -9 L9 9 M-9 9 L9 -9 M-13 0 H13 M0 -14 V14',
];
const runes = Array.from({ length: 12 }, (_, i) => {
  const angle = (i * Math.PI) / 6 - Math.PI / 2;
  const [x, y] = polar(194, angle);
  return { x, y, angle: i * 30, path: glyphs[i % glyphs.length] };
});
const diamonds = [0, 90, 180, 270].map((a) => {
  const [x, y] = polar(259, (a * Math.PI) / 180);
  return { x, y };
});
const polygon = (n: number, r: number, offset: number) =>
  Array.from({ length: n }, (_, i) =>
    polar(r, offset + (i * Math.PI * 2) / n).join(','),
  ).join(' ');
---

<style is:inline>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    overflow: hidden;
    background: #020205;
    opacity: 1;
  }
  html.splash-armed .splash {
    display: block;
  }
  .splash-scene {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: max(100vw, 177.6833svh);
    aspect-ratio: 1672/941;
    container-type: inline-size;
  }
  .splash-atmosphere,
  .splash-seal,
  .splash-progress-shell {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .splash-seal {
    overflow: visible;
    fill: none;
    stroke: #d7b78e;
    stroke-width: 1;
  }
  .seal-halo {
    position: absolute;
    left: 50%;
    top: 36.98%;
    width: 38%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse,
      #6029a022 0%,
      #6c28c018 35%,
      #4212820a 62%,
      transparent 72%
    );
  }
  .seal-core {
    position: absolute;
    left: 50%;
    top: 36.98%;
    width: 15%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse,
      #aa64ff55,
      #733ac51c 44%,
      transparent 70%
    );
  }
  .seal-outer {
    opacity: 0.9;
  }
  .seal-ticks {
    opacity: 0.8;
  }
  .seal-runes {
    stroke: #cca4f2;
    stroke-width: 1.35;
  }
  .seal-runes circle {
    stroke-width: 0.8;
  }
  .seal-geometry {
    stroke: #d7b185;
    stroke-width: 1.15;
    opacity: 0.9;
  }
  .seal-geometry-secondary {
    stroke: #b283db;
    opacity: 0.3;
  }
  .seal-cardinal {
    stroke: #f6d9ad;
    stroke-width: 1.5;
    filter: drop-shadow(0 0 5px #d484ce);
  }
  .seal-arcs {
    stroke: #bd81ff;
    stroke-width: 4;
    stroke-linecap: round;
    filter: drop-shadow(0 0 5px #a14aff);
  }
  .seal-arcs circle {
    stroke-dasharray: 36 270 20 460 40 750;
  }
  .splash-progress {
    fill: none;
    stroke: #f4ddbb;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform: rotate(-90deg);
    transform-origin: 836px 348px;
    filter: drop-shadow(0 0 4px #d087ff);
  }
  .splash-logo {
    position: absolute;
    left: 50%;
    top: 36.98%;
    width: 9%;
    height: auto;
    transform: translate(-50%, -50%);
    filter: saturate(0.6) brightness(1.08) drop-shadow(0 0 10px #a265d970);
  }
  .seal-floor {
    stroke: #cea9c9;
    stroke-width: 1.4;
    opacity: 0.65;
  }
  .floor-inner {
    stroke: #d7b385;
  }
  .splash-copy {
    position: absolute;
    top: 67.16%;
    left: 50%;
    width: 39%;
    transform: translateX(-50%);
    text-align: center;
    color: #eee4fa;
  }
  .splash-word {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 2.15cqw;
    line-height: 1.22;
    letter-spacing: 0.25em;
    text-indent: 0.25em;
    white-space: nowrap;
  }
  .splash-sub {
    margin: 0.65cqw 0 0;
    font-family: var(--font-body);
    font-size: 0.92cqw;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: #b6a8c6;
    white-space: nowrap;
  }
  .splash.is-leaving {
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .seal-turn,
  .seal-counter,
  .seal-geometry,
  .seal-arcs {
    transform-origin: 836px 348px;
  }
  @media (max-aspect-ratio: 1/1) {
    .splash-scene {
      width: max(175vw, 105svh);
    }
    .splash-copy {
      width: 42%;
    }
    .splash-word {
      font-size: 2.6cqw;
      letter-spacing: 0.18em;
    }
    .splash-sub {
      font-size: 1.25cqw;
      letter-spacing: 0.08em;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .seal-turn {
      animation: seal-orbit 42s linear infinite;
    }
    .seal-counter {
      animation: seal-orbit 60s linear infinite reverse;
    }
    .seal-geometry {
      animation: seal-orbit 90s linear infinite;
    }
    .seal-arcs {
      animation: seal-orbit 12s linear infinite reverse;
    }
    .seal-rune {
      animation: rune-ignite 3.4s ease-in-out infinite;
      animation-delay: calc(var(--rune) * -0.28s);
    }
    .seal-core {
      animation: core-breathe 3s ease-in-out infinite alternate;
    }
    .seal-floor {
      animation: floor-breathe 4s ease-in-out infinite alternate;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .splash,
    .splash * {
      animation: none !important;
      transition: none !important;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @media (max-width: 767px), (pointer: coarse) {
      /* Mobile rotates one HTML arc while the detailed SVG stays static. */
      .seal-turn,
      .seal-counter,
      .seal-geometry,
      .seal-arcs,
      .seal-rune,
      .seal-core,
      .seal-floor {
        animation: none;
      }
      .seal-halo::after {
        content: '';
        position: absolute;
        inset: 13%;
        border-radius: 50%;
        background: conic-gradient(transparent 320deg, #bd81ff 345deg, #f4ddbb);
        mask-image: radial-gradient(
          farthest-side,
          transparent calc(100% - 2px),
          #000 calc(100% - 1px)
        );
        animation: seal-orbit 12s linear infinite reverse;
        will-change: transform;
      }
      .splash-progress {
        filter: none;
      }
    }
  }
  @keyframes seal-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes rune-ignite {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes core-breathe {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes floor-breathe {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 0.85;
    }
  }
</style>

<div
  id="splash"
  class="splash"
  role="status"
  aria-label="Loading Data Sorcerers"
>
  <div class="splash-scene" aria-hidden="true">
    <div class="seal-halo"></div>
    <div class="seal-core"></div>
    <canvas class="splash-atmosphere"></canvas>
    <svg class="splash-seal" viewBox="0 0 1672 941">
      <defs>
        <radialGradient id="ritual-floor-light">
          <stop stop-color="#c28cff" stop-opacity=".28" />
          <stop offset="1" stop-color="#7f43be" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="ritual-beam" x2="0" y2="1">
          <stop stop-color="#ab73ee" stop-opacity="0" />
          <stop offset="1" stop-color="#e5c5ff" stop-opacity=".6" />
        </linearGradient>
      </defs>
      <ellipse
        cx="836"
        cy="826"
        rx="420"
        ry="90"
        fill="url(#ritual-floor-light)"
        stroke="none"
      />
      <path d="M836 0 V84" stroke="url(#ritual-beam)" stroke-width="3" />
      <g class="seal-outer">
        {rings.map((r) => (
          <circle cx="836" cy="348" r={r} />
        ))}
      </g>
      <g class="seal-turn seal-ticks">
        {ticks.map((tick) => (
          <line {...tick} />
        ))}
      </g>
      <g class="seal-counter seal-runes">
        {runes.map((r, i) => (
          <g
            class="seal-rune"
            style={`--rune:${i}`}
            transform={`translate(${r.x} ${r.y}) rotate(${r.angle})`}
          >
            {i % 3 === 0 && <circle r="11" />}
            <path d={r.path} />
          </g>
        ))}
      </g>
      <g class="seal-geometry">
        <polygon points={polygon(3, 163, -Math.PI / 2)} />
        <polygon points={polygon(3, 163, Math.PI / 2)} />
        <polygon
          class="seal-geometry-secondary"
          points={polygon(4, 145, Math.PI / 4)}
        />
        <circle cx="836" cy="348" r="114" stroke-dasharray="1 9" />
      </g>
      <g class="seal-arcs">
        <circle cx="836" cy="348" r="250" />
      </g>
      <g class="seal-cardinal">
        {diamonds.map(({ x, y }) => (
          <g transform={`translate(${x} ${y})`}>
            <path d="M0 -16 L10 0 L0 16 L-10 0 Z M0 -7 L4 0 L0 7 L-4 0 Z M-27 0 H-13 M13 0 H27 M0 -27 V-18 M0 18 V27" />
          </g>
        ))}
      </g>

      <g class="seal-floor" transform="translate(836 826) scale(1 .13)">
        {[180, 220, 280, 360, 430].map((r) => (
          <circle r={r} />
        ))}
        <g class="floor-inner">
          {Array.from({ length: 48 }, (_, i) => (
            <path
              transform={`rotate(${i * 7.5})`}
              d="M300 0 H322 M340 -5 L350 0 L340 5"
            />
          ))}
        </g>
      </g>
      <g class="seal-cardinal" transform="translate(836 742)">
        <path d="M0 -10 L6 0 L0 10 L-6 0 Z M-68 0 H-12 M12 0 H68" />
      </g>
    </svg>
    <svg class="splash-progress-shell" viewBox="0 0 1672 941">
      <circle
        class="splash-progress"
        cx="836"
        cy="348"
        r="251"
        pathLength="100"
      />
    </svg>
    <img
      class="splash-logo"
      src="/images/logo.png"
      width="192"
      height="210"
      alt=""
    />
    <div class="splash-copy">
      <p class="splash-word">DATA SORCERERS</p>
      <p class="splash-sub">Sorcery in Data · Magic in AI</p>
    </div>
  </div>
</div>

<script>
  import { animateSplash } from '../scripts/splash-atmosphere';
  const canvas =
    document.querySelector<HTMLCanvasElement>('.splash-atmosphere');
  if (canvas && document.documentElement.classList.contains('splash-armed'))
    animateSplash(canvas);
</script>
<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('splash');
    var markDone = function () {
      root.classList.add('splash-done');
    };
    var announce = function () {
      markDone();
      // Hand history scroll restoration back to the browser now that the splash
      // is gone, so Back/Forward returns to the section the user left.
      try {
        if (
          'scrollRestoration' in history &&
          history.scrollRestoration === 'manual'
        ) {
          history.scrollRestoration = 'auto';
        }
      } catch (e) {}
      try {
        window.dispatchEvent(new Event('ds:splash-done'));
      } catch (e) {}
    };
    if (!el) {
      announce();
      return;
    }
    if (!root.classList.contains('splash-armed')) {
      if (el.parentNode) el.parentNode.removeChild(el);
      announce();
      return;
    }
    try {
      sessionStorage.setItem('ds:splash', '1');
    } catch (e) {}
    // Lock scrolling while the overlay is up without shifting the layout: the
    // hidden scrollbar is compensated by a matching right padding, so the hero
    // is measured at the exact width it will have once the splash is gone.
    var sbw = window.innerWidth - root.clientWidth;
    if (sbw > 0) root.style.paddingRight = sbw + 'px';
    root.style.overflow = 'hidden';

    var bar = el.querySelector('.splash-progress');
    var compactMotion = window.matchMedia(
      '(max-width: 767px), (pointer: coarse)',
    ).matches;
    var lastProgressPaint = 0;
    var shown = 0;

    // The splash acts as a real loading screen: it stays until the page has
    // loaded *and* the heavy assets reported through `window.__dsPreload`
    // (three.js chunk, background video) plus fonts are settled. MIN keeps it
    // visible long enough to read; MAX caps the wait on slow connections.
    var done = false;
    var MIN = 3000;
    var MAX = 6000;
    var start = performance.now();
    var loadFired = false;
    var assetsReady = false;
    var skipRequested = false;

    function remove() {
      if (el.parentNode) el.parentNode.removeChild(el);
      root.classList.remove('splash-armed');
      root.style.overflow = '';
      root.style.paddingRight = '';
    }
    function finish() {
      if (done) return;
      done = true;
      render(true);
      announce();
      window.dispatchEvent(
        new CustomEvent('ds:sfx', {
          detail: { cue: 'success', source: 'splash' },
        }),
      );
      el.classList.add('is-leaving');
      window.setTimeout(remove, 800);
    }
    function markAssets() {
      if (assetsReady) return;
      assetsReady = true;
      render();
      check();
    }
    // The seal arc fills once and never loops. It tracks the real deadline: while
    // assets stream it fills across MAX; once everything is ready it closes on
    // MIN, so the fill always completes right as the overlay lifts.
    function render(force) {
      var now = performance.now();
      if (compactMotion && !force && now - lastProgressPaint < 60) return;
      lastProgressPaint = now;
      var elapsed = now - start;
      var ready = loadFired && assetsReady;
      var denom = ready || skipRequested ? MIN : MAX;
      var target = force ? 1 : Math.min(elapsed / denom, 0.985);
      if (target < shown) target = shown;
      if (target > 0.985 && !force) target = 0.985;
      shown = target;
      if (bar) bar.style.strokeDashoffset = String(100 * (1 - shown));
    }
    function tick() {
      if (done) return;
      render();
      window.requestAnimationFrame(tick);
    }
    // Poll instead of relying on a single timer so a late asset can still let
    // the splash go early, while MAX always releases it.
    function check() {
      if (done) return;
      render();
      var elapsed = performance.now() - start;
      if (loadFired && assetsReady) {
        if (elapsed >= MIN) finish();
        else window.setTimeout(check, MIN - elapsed);
      } else if (skipRequested || elapsed >= MAX) {
        if (elapsed >= MIN) finish();
        else window.setTimeout(check, MIN - elapsed);
      } else {
        window.setTimeout(check, 120);
      }
    }
    function whenLoaded() {
      loadFired = true;
      var pending = (window.__dsPreload || []).slice();
      if (document.fonts && document.fonts.ready)
        pending.push(document.fonts.ready);
      var total = pending.length;
      render();
      if (!total) {
        markAssets();
      } else {
        var settled = 0;
        pending.forEach(function (p) {
          Promise.resolve(p)
            .catch(function () {})
            .then(function () {
              if (++settled === total) markAssets();
            });
        });
        // Never hold the splash on a promise that misbehaves.
        window.setTimeout(markAssets, MAX);
      }
      check();
    }
    if (document.readyState === 'complete') whenLoaded();
    else window.addEventListener('load', whenLoaded, { once: true });
    // A tap/scroll may dismiss the overlay, but only after MIN so the preload
    // still gets a guaranteed head start.
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (type) {
      window.addEventListener(
        type,
        function () {
          if (performance.now() - start >= MIN) {
            skipRequested = true;
            check();
          }
        },
        { passive: true },
      );
    });
    tick();
    check();
  })();
</script>
