---
import Button from './Button.astro';
---

<section class="recruitment-hero" aria-labelledby="recruitment-hero-title">
  <div class="artwork" aria-hidden="true">
    <img
      class="art-bg"
      src="/images/recruitment/hero-bg.webp"
      srcset="
        /images/recruitment/hero-bg.webp     1440w,
        /images/recruitment/hero-bg-2x.webp 2880w,
        /images/recruitment/hero-bg-3x.webp 4320w
      "
      sizes="100vw"
      width="1440"
      height="866"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-content">
    <div class="hero-header-group">
      <h1 id="recruitment-hero-title">
        <span>Your Next Chapter</span>
        <span>Start here</span>
      </h1>
      <p>
        Join Data Sorcerers and turn your curiosity into capability,
        experiments, research, and real-world projects.
      </p>
    </div>
    <Button variant="apply" href="#available-roles">
      Apply Now
    </Button>
  </div>
</section>

<style>
  /* Matches Figma node 1436:3506 (1440 × 866), page 1436:3505. Full-screen
     migration (#9): the hero background is now the supplied art
     (`assets/hero gambar/Gambar Hero recruitment.png` → hero-bg.webp) and the
     section is one screen tall (100svh) with the content centred; the video,
     particle canvas and plate tweens were removed. Copy geometry is unchanged. */
  .recruitment-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    padding: 80px var(--page-gutter);
    overflow: clip;
    text-align: center;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    width: 1280px;
    max-width: 100%;
  }
  .hero-header-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }
  /* Keep the CTA above the artwork and match Figma 120px hug width. */
  .hero-content :global(.button) {
    position: relative;
    z-index: 1;
    width: 120px;
  }
  h1 {
    margin: 0;
    width: 900px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 700;
    line-height: 86px;
    letter-spacing: 0;
    text-align: center;
  }
  h1 span {
    display: block;
    height: 86px;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  p {
    margin: 0;
    width: 900px;
    max-width: 100%;
    color: #ede8ff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
    .artwork img {
      object-position: center bottom;
    }
  }
  @media (max-width: 1100px) {
    .recruitment-hero {
      min-height: 100vh;
      min-height: 100svh;
      padding: 120px var(--page-gutter) 60px;
    }
    .hero-content {
      gap: 32px;
    }
    .hero-header-group {
      gap: 16px;
    }
    h1 {
      font-size: clamp(40px, 6vw, 72px);
      line-height: 1.225;
    }
    h1 span {
      height: auto;
    }
  }
  @media (max-width: 600px) {
    .recruitment-hero {
      min-height: 100vh;
      min-height: 100dvh;
      justify-content: center;
      padding-top: clamp(90px, 12dvh, 120px);
      padding-bottom: clamp(48px, 8dvh, 72px);
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 70%, #050507 100%);
      pointer-events: none;
    }
    .hero-content {
      gap: clamp(24px, 6vw, 36px);
    }
    .hero-header-group {
      gap: clamp(12px, 3.5vw, 16px);
    }
    h1 {
      font-size: clamp(23px, 6.7vw, 40px);
      line-height: 1.2;
    }
    h1 span {
      height: auto;
    }
    p {
      font-size: clamp(15px, 3.9vw, 18px);
      line-height: 1.5;
    }
  }
</style>
