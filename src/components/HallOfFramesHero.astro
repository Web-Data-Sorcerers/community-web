---
---

<section class="hof-hero" aria-labelledby="hof-hero-title">
  <div class="artwork" aria-hidden="true">
    <img
      class="art-bg"
      src="/images/hof/hero-bg.webp"
      srcset="
        /images/hof/hero-bg.webp     1440w,
        /images/hof/hero-bg-2x.webp 2880w,
        /images/hof/hero-bg-3x.webp 4320w
      "
      sizes="100vw"
      width="1440"
      height="903"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-content">
    <h1 id="hof-hero-title">
      <span>Where Knowledge </span>
      <span>Turns Into Legacy</span>
    </h1>
    <p>
      A curated gallery of people, achievements, research, projects, and
      milestones created within the Data Sorcerers ecosystem.
    </p>
  </div>
</section>

<style>
  /* Matches Figma node 1439:4507 (1440 x 903).
     Centered content frame (800px) at gap 24: title Bluu Next Bold 80/102 with
     the shared "Gradient Heading" fill, subtitle Manrope Medium 18/27 #EDE8FF
     (758px). Full-screen migration (#9): the hero art is the supplied
     `assets/hero gambar/Hero Section - HoF.png` → hero-bg.webp
     (npm run assets:heroes); the video was removed and the section is one
     screen tall (100svh). */
  .hof-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 80px var(--page-gutter);
    overflow: clip;
    text-align: center;
  }

  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .artwork .art-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    width: 800px;
    max-width: 100%;
  }

  h1 {
    margin: 0;
    width: 100%;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 102px;
    background: linear-gradient(181deg, #fff 15%, #999 42%, #fff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-align: center;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  h1 span {
    display: block;
  }

  p {
    margin: 0;
    width: 758px;
    max-width: 100%;
    color: #ede8ff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    text-align: center;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
  }

  @media (max-width: 1100px) {
    h1 {
      font-size: clamp(40px, 5.5vw, 68px);
      line-height: 1.18;
    }
    p {
      font-size: clamp(16px, 1.8vw, 18px);
      line-height: 1.5;
    }
  }

  @media (max-width: 760px) {
    h1 span {
      display: inline;
    }
    h1 span:not(:last-child)::after {
      content: ' ';
    }
  }

  @media (max-width: 600px) {
    .hof-hero {
      min-height: 100vh;
      min-height: 100dvh;
      justify-content: center;
      padding-top: clamp(90px, 13dvh, 120px);
      padding-bottom: clamp(40px, 8dvh, 60px);
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 70%, #050507 100%);
      pointer-events: none;
    }
    .hero-content {
      gap: 16px;
    }
    h1 {
      font-size: clamp(26px, 7.5vw, 40px);
      line-height: 1.2;
    }
    p {
      font-size: clamp(14px, 3.8vw, 16px);
      line-height: 1.55;
    }
  }
</style>
