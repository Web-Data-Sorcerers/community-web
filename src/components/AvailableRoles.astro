---
import { canNavigateToTarget } from '../data/site-visibility-registry.mjs';
const canVisit = (page: string, section?: string) =>
  !Astro.locals.visibility ||
  canNavigateToTarget(Astro.locals.visibility, page, section);
import { roles } from '../data/roles';
import { domains } from '../data/domains';

const domainTitle = Object.fromEntries(domains.map((d) => [d.id, d.title]));
---

<section
  id="available-roles"
  class="available-roles"
  aria-labelledby="available-roles-title"
>
  <header>
    <h2 id="available-roles-title">Available Roles</h2>
    <p>Select a role to view full details, requirements, and apply.</p>
  </header>
  <div class="role-list">
    {roles
      .filter((role) => canVisit('role-' + role.id))
      .map((role) => (
        <a
          class="role-row"
          href={`/recruitment/roles/${role.id}`}
          data-sfx="open"
          data-sfx-hover="hover"
        >
          <div class="role-card">
            <span class="role-glow" aria-hidden="true" />
            <div class="role-head">
              <h3 class="role-name">{domainTitle[role.id] ?? role.title}</h3>
              <p class="role-summary">{role.tagline}</p>
            </div>
            <div class="role-foot">
              <span class="role-divider" aria-hidden="true" />
              <span class="role-link">
                View Details
                <svg
                  class="role-link-icon"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M11.2248 7.10967C11.1144 6.99119 11.0543 6.83449 11.0572 6.67257C11.06 6.51065 11.1256 6.35616 11.2402 6.24165C11.3547 6.12714 11.5092 6.06155 11.6711 6.05869C11.833 6.05583 11.9897 6.11594 12.1082 6.22634L15.4415 9.55967C15.5585 9.67686 15.6243 9.83571 15.6243 10.0013C15.6243 10.167 15.5585 10.3258 15.4415 10.443L12.1082 13.7763C12.051 13.8377 11.982 13.887 11.9053 13.9212C11.8286 13.9553 11.7459 13.9737 11.6619 13.9752C11.578 13.9766 11.4947 13.9612 11.4168 13.9298C11.339 13.8983 11.2683 13.8516 11.209 13.7922C11.1496 13.7329 11.1028 13.6622 11.0714 13.5843C11.04 13.5065 11.0245 13.4232 11.026 13.3392C11.0275 13.2553 11.0459 13.1726 11.08 13.0959C11.1142 13.0192 11.1634 12.9502 11.2248 12.893L13.4915 10.6263H5.4165C5.25074 10.6263 5.09177 10.5605 4.97456 10.4433C4.85735 10.3261 4.7915 10.1671 4.7915 10.0013C4.7915 9.83558 4.85735 9.67661 4.97456 9.5594C5.09177 9.44219 5.25074 9.37634 5.4165 9.37634H13.4915L11.2248 7.10967Z"
                    fill="currentColor"
                  />
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
  </div>
</section>
<style>
  .available-roles {
    scroll-margin-top: 110px;
    /* Full-screen standard (#9): one section = one screen, content centred. */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px var(--page-gutter);
    background: #050507;
  }
  header,
  .role-list {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  header {
    margin-bottom: 58px;
  }
  h2 {
    margin: 0;
    font: 700 56px/67px var(--font-display);
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 0;
  }
  header p {
    margin: 21px 0 0;
    font: 500 18px/27px var(--font-body);
    color: #ffffff;
    letter-spacing: 0;
  }
  /* 3 x 413.33px cards + 2 x 20px gutters = 1280px, matching the Figma grid. */
  .role-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 20px;
  }
  /* Proportional card: the container drives every inner size via cqw so the
     layout tracks the 413x235 reference at any column width. */
  .role-row {
    position: relative;
    display: block;
    align-self: start;
    aspect-ratio: 413 / 235;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    container-type: inline-size;
  }
  .role-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* cqw resolves against .role-row (the container) here, not the viewport. */
    border-radius: 4.843cqw;
    padding: 4.358cqw 6.78cqw;
    /* rgba(255,255,255,0.15) over the #050507 section resolves to #2a2a2c. */
    background: #2a2a2c;
  }
  /* Violet glow on its own layer so it can drift (see the wave below). */
  .role-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: url('/images/recruitment/role-glow.webp') center / 100% 100%
      no-repeat;
    opacity: 0.85;
    pointer-events: none;
  }
  /* Soft violet pool that follows the pointer; invisible until hover. */
  .role-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 50%),
      rgb(155 123 255 / 38%) 0%,
      rgb(108 59 255 / 14%) 45%,
      transparent 72%
    );
    opacity: 0;
    pointer-events: none;
  }
  /* 1px gradient ring (135deg) drawn on the card edge. */
  .role-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: max(1px, 0.242cqw);
    background: linear-gradient(135deg, #ede8ff 0%, #2e276c 50%, #ede8ff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .role-head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3.874cqw;
  }
  .role-name {
    margin: 0;
    color: #fff;
    font-size: 6.295cqw;
    font-weight: 700;
    line-height: 9.443cqw;
  }
  .role-summary {
    margin: 0;
    color: #ede8ff;
    font-size: 3.874cqw;
    line-height: 5.811cqw;
  }
  .role-foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* Figma foot1436:3608: static divider, 14px gap, then the action. */
    gap: 3.39cqw;
    margin-top: auto;
    /* Measured 1px ring inset gives the foot its 355px content width. */
    margin-inline: 0.242cqw;
    margin-bottom: 0.242cqw;
  }
  .role-divider {
    display: block;
    flex: none;
    /* Preserve the exported fade while keeping the hairline visible at 1x. */
    height: max(1px, 0.121cqw);
    background: url('/images/recruitment/role-divider.svg') left center / 100%
      100% no-repeat;
    pointer-events: none;
  }
  .role-link {
    position: relative;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 1.937cqw;
    color: #fff;
    font-size: 3.874cqw;
    font-weight: 500;
    line-height: 7.748cqw;
  }
  /* Figma1218:1346: only the content-width action gains an underline. */
  .role-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    /* Keep the transformed hairline visible on 1x browser rasterization. */
    height: max(1px, 0.121cqw);
    background: linear-gradient(to right, #fff 50%, rgb(255 255 255 / 0) 100%);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }
  .role-row:focus-visible .role-link::after {
    transform: scaleX(1);
  }
  @media (hover: hover) {
    .role-row:hover .role-link::after {
      transform: scaleX(1);
    }
  }
  .role-link-icon {
    flex: none;
    width: 4.843cqw;
    height: 4.843cqw;
  }
  .role-row:is(:hover, :focus-visible) .role-card::after {
    background: linear-gradient(135deg, #fff 0%, #6c3bff 50%, #fff 100%);
  }
  .role-row:focus-visible {
    outline: 2px solid #9b7bff;
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .role-link-icon {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .role-row:is(:hover, :focus-visible) .role-link-icon {
      transform: translateX(6px);
    }
    .role-link::after {
      transition: transform 180ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    /* Slow bottom wave; scaled from bottom-centre it overfills so no edge shows. */
    .role-glow {
      transform-origin: 50% 100%;
      animation: role-glow-wave 9s ease-in-out infinite alternate;
      transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    /* The ember leans toward the pointer (--gx/--gy come from the script). */
    .role-row:is(:hover, :focus-visible) .role-glow {
      transform: translate(var(--gx, 0px), var(--gy, 0px)) scale(1.06);
    }
    /* Pointer pool ignites on hover and tracks --mx/--my. */
    .role-card::before {
      transition: opacity 0.35s ease;
    }
    .role-row:is(:hover, :focus-visible) .role-card::before {
      opacity: 1;
    }
    /* Stagger the columns so the glow flows across the row. */
    .role-row:nth-child(3n + 2) .role-glow {
      animation-delay: -3s;
    }
    .role-row:nth-child(3n + 3) .role-glow {
      animation-delay: -6s;
    }
    .available-roles:not(.is-idle) .role-glow {
      will-change: transform, opacity;
    }
    /* Park the wave while the section is off-screen (motion.ts toggles this). */
    .available-roles.is-idle .role-glow {
      animation-play-state: paused;
    }
  }
  @keyframes role-glow-wave {
    0% {
      scale: 1;
      opacity: 0.85;
    }
    100% {
      scale: 1.04;
      opacity: 1;
    }
  }
  @media (max-width: 1100px) {
    .role-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .available-roles {
      padding-block: 64px;
    }
    header {
      margin-bottom: 32px;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.22;
    }
    .role-list {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
<script>
  // Pointer-only, motion-on: the card's ember leans toward the cursor by
  // publishing a small --gx/--gy offset the CSS reads. Skipped entirely for
  // touch and reduced motion, so those stay static. Re-run after each
  // client-side navigation because the cards are replaced by the swap.
  const initAvailableRoles = () => {
    const rows = document.querySelectorAll<HTMLElement>(
      '.available-roles .role-row',
    );
    const enabled =
      window.matchMedia('(pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!enabled) return;

    const reset = (row: HTMLElement) => {
      row.style.removeProperty('--gx');
      row.style.removeProperty('--gy');
    };
    rows.forEach((row) => {
      row.addEventListener('pointermove', (event) => {
        const rect = row.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width;
        const py = (event.clientY - rect.top) / rect.height;
        row.style.setProperty('--gx', `${((px - 0.5) * 22).toFixed(2)}px`);
        row.style.setProperty('--gy', `${((py - 0.5) * 16).toFixed(2)}px`);
        row.style.setProperty('--mx', `${(px * 100).toFixed(2)}%`);
        row.style.setProperty('--my', `${(py * 100).toFixed(2)}%`);
      });
      row.addEventListener('pointerleave', () => reset(row));
      row.addEventListener('blur', () => reset(row));
    });
  };

  document.addEventListener('astro:page-load', initAvailableRoles);
</script>
