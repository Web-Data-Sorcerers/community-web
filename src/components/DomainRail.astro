---
import { canNavigateToTarget } from '../data/site-visibility-registry.mjs';
const canVisit = (page: string, section?: string) =>
  !Astro.locals.visibility ||
  canNavigateToTarget(Astro.locals.visibility, page, section);
import DomainCard from './DomainCard.astro';
import { domains } from '../data/domains';
interface Props {
  base?: string;
  suffix?: string;
}
const visibleDomains = domains.filter((domain) =>
  canVisit('hods-' + domain.id),
);
const { base = '/hods', suffix = '' } = Astro.props;
---

<div class="domain-carousel">
  <button
    class="rail-arrow prev"
    type="button"
    aria-label="Previous domains"
    data-dir="-1"
    data-sfx="select"
    data-sfx-hover="hover"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>
  <div
    class="domain-rail"
    tabindex="0"
    role="region"
    aria-label={
      visibleDomains.length === 6
        ? 'Domains — scroll horizontally to explore all six'
        : 'Domains — scroll horizontally to explore available domains'
    }
  >
    {visibleDomains.map((domain) => (
      <DomainCard domain={domain} href={`${base}/${domain.id}${suffix}`} />
    ))}
  </div>
  <button
    class="rail-arrow next"
    type="button"
    aria-label="Next domains"
    data-dir="1"
    data-sfx="select"
    data-sfx-hover="hover"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</div>
<script>
  // Re-initialised on every client-side navigation; the previous page's global
  // listeners, observers and attract-mode timers are torn down first.
  let railCleanups: (() => void)[] = [];
  // Keyboard navigation moves the rail without a pointer, so it never reaches
  // the delegated hover/click wiring — ask the sound system for the same
  // "select" cue the arrow buttons use (Sound.astro ignores it under reduce).
  const keyCue = () =>
    window.dispatchEvent(
      new CustomEvent('ds:sfx', { detail: { cue: 'select' } }),
    );
  const initDomainRails = () => {
    railCleanups.forEach((fn) => fn());
    railCleanups = [];
    const ac = new AbortController();
    const { signal } = ac;
    railCleanups.push(() => ac.abort());

    document.querySelectorAll<HTMLElement>('.domain-rail').forEach((rail) => {
      const carousel = rail.closest('.domain-carousel');
      const arrows = carousel
        ? [...carousel.querySelectorAll<HTMLButtonElement>('.rail-arrow')]
        : [];
      const step = () =>
        (rail.querySelector('.domain-card')?.getBoundingClientRect().width ??
          405) + (parseFloat(getComputedStyle(rail).columnGap) || 0);

      arrows.forEach((arrow) =>
        arrow.addEventListener('click', () => {
          rail.scrollBy({
            left: Number(arrow.dataset.dir) * step(),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth',
          });
        }),
      );

      // Cached card stride so the edge-clip test in `sync` stays cheap on every
      // scroll frame.
      let cardWidth = 0;
      let cardStride = 0;
      const measure = () => {
        cardWidth =
          rail.querySelector('.domain-card')?.getBoundingClientRect().width ??
          405;
        cardStride =
          cardWidth + (parseFloat(getComputedStyle(rail).columnGap) || 0);
      };

      const sync = () => {
        const max = rail.scrollWidth - rail.clientWidth;
        if (arrows[0]) arrows[0].disabled = rail.scrollLeft <= 1;
        if (arrows[1]) arrows[1].disabled = rail.scrollLeft >= max - 1;
        // Fade an edge only when it actually lands inside a card (a partial card
        // is visible there). Full cards are never dimmed, and the mask also
        // covers a partial that stays visible while the rail rests.
        if (!cardStride) measure();
        const partial = (edge: number) => {
          const offset = ((edge % cardStride) + cardStride) % cardStride;
          return offset > 1 && offset < cardWidth - 1;
        };
        rail.classList.toggle('is-clip-left', partial(rail.scrollLeft));
        rail.classList.toggle(
          'is-clip-right',
          partial(rail.scrollLeft + rail.clientWidth),
        );
      };
      measure();
      rail.addEventListener('scroll', sync, { passive: true, signal });
      sync();
      const resizeObserver = new ResizeObserver(() => {
        measure();
        sync();
      });
      resizeObserver.observe(rail);
      railCleanups.push(() => resizeObserver.disconnect());

      // Touch already scrolls natively; add click-drag for mouse users.
      let dragging = false;
      let pressed = false;
      let suppressClick = false;
      let startX = 0;
      let startLeft = 0;
      rail.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        pressed = true;
        dragging = false;
        suppressClick = false;
        startX = event.clientX;
        startLeft = rail.scrollLeft;
      });
      rail.addEventListener('pointermove', (event) => {
        if (!pressed) return;
        if (!dragging && Math.abs(event.clientX - startX) < 6) return;
        if (!dragging) {
          dragging = true;
          suppressClick = true;
          rail.classList.add('is-dragging');
          rail.setPointerCapture(event.pointerId);
        }
        rail.scrollLeft = startLeft - (event.clientX - startX);
      });
      const endDrag = (event: PointerEvent) => {
        pressed = false;
        dragging = false;
        rail.classList.remove('is-dragging');
        if (rail.hasPointerCapture(event.pointerId))
          rail.releasePointerCapture(event.pointerId);
      };
      rail.addEventListener('pointerup', endDrag);
      rail.addEventListener('pointercancel', endDrag);
      rail.addEventListener('pointerleave', (event) => {
        if (!dragging) endDrag(event);
      });
      rail.addEventListener('dragstart', (event) => event.preventDefault());
      rail.addEventListener(
        'click',
        (event) => {
          if (suppressClick && event.detail !== 0) {
            event.preventDefault();
            event.stopPropagation();
            suppressClick = false;
          }
        },
        true,
      );

      rail.addEventListener('keydown', (event) => {
        const positions: Record<string, number> = {
          ArrowLeft: rail.scrollLeft - step(),
          ArrowRight: rail.scrollLeft + step(),
          Home: 0,
          End: rail.scrollWidth - rail.clientWidth,
        };
        if (event.key in positions) {
          event.preventDefault();
          keyCue();
          rail.scrollTo({ left: positions[event.key], behavior: 'auto' });
        }
      });

      // Arrow keys also drive the rail when its section is the one at the
      // viewport centre, without needing to focus it first.
      const section = rail.closest('section') ?? rail;
      addEventListener(
        'keydown',
        (event) => {
          if (event.defaultPrevented) return;
          const target = event.target as HTMLElement | null;
          if (
            target?.closest('input, textarea, select, [contenteditable="true"]')
          )
            return;
          const rect = section.getBoundingClientRect();
          const center = innerHeight / 2;
          if (rect.top > center || rect.bottom < center) return;
          const behavior: ScrollBehavior = matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches
            ? 'auto'
            : 'smooth';
          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            keyCue();
            rail.scrollBy({ left: -step(), behavior });
          } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            keyCue();
            rail.scrollBy({ left: step(), behavior });
          }
        },
        { signal },
      );

      // Attract mode: once the section sits at the viewport centre and the visitor
      // has been still for a few seconds, the rail advances one card at a time
      // (smooth-scrolled onto the snap points, ping-ponging at the ends) so it
      // never reads as a frozen strip. Any interaction — hover, drag, wheel,
      // touch, keyboard, focus — takes over instantly. Desktop-only (hover + fine
      // pointer, where an auto-advancing rail reads as alive rather than fighting
      // a thumb), and parked for reduced motion, hidden tabs or an off-centre
      // section. Stepping (not a rAF drift) lands on snap points, so there is no
      // snap-jump when the visitor takes over.
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let hovering = false;
        let focused = false;
        let visible = false;
        let dir = 1;
        let timer = 0;
        const IDLE_MS = 3500;
        const STEP_MS = 2800;

        const reduced = () =>
          matchMedia('(prefers-reduced-motion: reduce)').matches;
        const free = () =>
          visible && !hovering && !focused && !document.hidden && !reduced();

        const stop = () => {
          clearTimeout(timer);
          timer = 0;
          rail.classList.remove('is-gliding');
        };
        railCleanups.push(stop);

        const advance = () => {
          if (!free()) {
            stop();
            return;
          }
          const card = rail.querySelector('.domain-card');
          const s =
            (card?.getBoundingClientRect().width ?? 405) +
            (parseFloat(getComputedStyle(rail).columnGap) || 0);
          const maxIndex = Math.max(
            0,
            Math.round((rail.scrollWidth - rail.clientWidth) / s),
          );
          if (!s || maxIndex <= 0) {
            stop();
            return;
          }
          let next = Math.round(rail.scrollLeft / s) + dir;
          if (next > maxIndex) {
            dir = -1;
            next = maxIndex - 1;
          } else if (next < 0) {
            dir = 1;
            next = 1;
          }
          rail.classList.add('is-gliding');
          rail.scrollTo({ left: next * s, behavior: 'smooth' });
          timer = window.setTimeout(advance, STEP_MS);
        };

        const reset = () => {
          stop();
          if (free()) timer = window.setTimeout(advance, IDLE_MS);
        };

        // The section is "centred" while it overlaps the middle 10% band of the
        // viewport — an observer instead of a polling getBoundingClientRect.
        const attractObserver = new IntersectionObserver(
          ([entry]) => {
            visible = entry.isIntersecting;
            if (visible) reset();
            else stop();
          },
          { rootMargin: '-45% 0px -45% 0px' },
        );
        attractObserver.observe(section);
        railCleanups.push(() => attractObserver.disconnect());

        rail.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'mouse') return;
          hovering = true;
          reset();
        });
        rail.addEventListener('pointerleave', (event) => {
          if (event.pointerType !== 'mouse') return;
          hovering = false;
          reset();
        });
        ['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((type) =>
          rail.addEventListener(type, reset, { passive: true }),
        );
        rail.addEventListener('focusin', () => {
          focused = true;
          reset();
        });
        rail.addEventListener('focusout', () => {
          focused = false;
          reset();
        });
        document.addEventListener('visibilitychange', reset, { signal });
        matchMedia('(prefers-reduced-motion: reduce)').addEventListener(
          'change',
          reset,
          { signal },
        );
      }
    });
  };

  document.addEventListener('astro:page-load', initDomainRails);
  document.addEventListener('astro:before-swap', () => {
    railCleanups.forEach((fn) => fn());
    railCleanups = [];
  });
</script>
<style>
  .domain-carousel {
    position: relative;
    display: flow-root;
    margin: 74px auto 0;
    width: min(1280px, calc(100% - 2 * var(--page-gutter)));
  }
  .domain-rail {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* Scroll containers clip on both axes; padding gives the hover lift vertical room and the equal negative margin keeps section geometry identical. */
    padding-block: 26px;
    margin-block: -26px;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    scrollbar-width: none;
    cursor: grab;
  }
  .domain-rail :global(.domain-card) {
    flex: 0 0 405px;
    width: 405px;
    scroll-snap-align: start;
  }
  .domain-rail.is-dragging {
    scroll-snap-type: none;
    user-select: none;
    cursor: grabbing;
  }
  .domain-rail.is-gliding {
    cursor: default;
  }
  /* Edge fade only when a partial card is actually at that edge (classes toggled in JS `sync`), so full cards are never dimmed and reduced motion never applies it. */
  @media (prefers-reduced-motion: no-preference) {
    .domain-rail.is-clip-left.is-clip-right {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 120px,
        #000 calc(100% - 120px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 120px,
        #000 calc(100% - 120px),
        transparent 100%
      );
    }
    .domain-rail.is-clip-left {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 120px,
        #000 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 120px,
        #000 100%
      );
    }
    .domain-rail.is-clip-right {
      -webkit-mask-image: linear-gradient(
        to right,
        #000 0,
        #000 calc(100% - 120px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        #000 0,
        #000 calc(100% - 120px),
        transparent 100%
      );
    }
  }
  .domain-rail::-webkit-scrollbar {
    display: none;
  }
  .domain-rail:focus-visible {
    outline: 2px solid #bba7ff;
    outline-offset: 6px;
  }
  .rail-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    transform: translateY(-50%);
    border: 1px solid rgb(203 197 255 / 60%);
    border-radius: 50%;
    background: rgb(16 9 35 / 85%);
    backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .rail-arrow svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rail-arrow.prev {
    left: -64px;
  }
  .rail-arrow.next {
    right: -64px;
  }
  .rail-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 1200px) {
    .domain-carousel {
      margin-bottom: 66px;
    }
    .domain-rail :global(.domain-card) {
      flex: 0 0 calc((100% - 32px) / 2);
      width: calc((100% - 32px) / 2);
    }
    .rail-arrow {
      top: auto;
      bottom: -66px;
      transform: none;
    }
    .rail-arrow.prev {
      left: 0;
    }
    .rail-arrow.next {
      right: 0;
    }
  }
  @media (max-width: 760px) {
    .domain-rail :global(.domain-card) {
      flex-basis: 100%;
      max-width: none;
    }
    .domain-rail {
      padding-inline: 0;
      gap: 24px;
    }
    .rail-arrow {
      top: auto;
      bottom: -52px;
      width: 40px;
      height: 40px;
      transform: none;
    }
    .rail-arrow svg {
      width: 20px;
      height: 20px;
    }
    .rail-arrow.prev {
      left: 0;
    }
    .rail-arrow.next {
      right: 0;
    }
  }
</style>
