---
---

<section class="partners-hero" aria-labelledby="partners-hero-title">
  <picture class="artwork" aria-hidden="true">
    <!-- Phones: portrait crop centred on the two hands' fingers so the joined
         fingers stay visible instead of the wide 1440 art cropping to an empty
         centre slice. Baked by `npm run assets:heroes`. -->
    <source
      media="(max-width: 600px)"
      srcset="
        /images/partners/hero-bg-mobile.webp     480w,
        /images/partners/hero-bg-mobile-2x.webp  960w,
        /images/partners/hero-bg-mobile-3x.webp 1440w
      "
      sizes="100vw"
    />
    <img
      class="art-bg"
      src="/images/partners/hero-bg.webp"
      srcset="
        /images/partners/hero-bg.webp     1440w,
        /images/partners/hero-bg-2x.webp 2880w,
        /images/partners/hero-bg-3x.webp 4320w
      "
      sizes="100vw"
      width="1440"
      height="659"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-content">
    <span class="pill">Create · Collaborate · Make an impact</span>
    <h1 id="partners-hero-title">
      <span>Let's Build Something </span>
      <span>Meaningful Together.</span>
    </h1>
  </div>
</section>

<style>
  /* Matches Figma node 1439:4788 (1440 x 659, page 1439:4787): column,
     IMAGE fill, CTA pill 1439:4789 228x26 on rgba(255,255,255,.15), heading
     1439:4791 single Bluu Next Bold 700 80/102 text node (one 181deg gradient
     spanning the 223px box). Full-screen migration (#9): the hero art is the
     supplied `assets/hero gambar/Hero Section - Partners.png` → hero-bg.webp
     (npm run assets:heroes); the video was removed and the section is one
     screen tall (100svh) with the content centred. */
  .partners-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 80px;
    box-sizing: border-box;
    overflow: clip;
    background: var(--color-background);
    text-align: center;
  }
  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .artwork .art-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 1280px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    color: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    line-height: 18px;
    white-space: nowrap;
  }
  h1 {
    margin: 0;
    width: 100%;
    height: 223px;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 102px;
    letter-spacing: normal;
    text-align: center;
    /* One gradient across the whole 2-line text node (not per line). */
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h1 span {
    display: block;
  }
  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
  }

  @media (max-width: 1100px) {
    .partners-hero {
      padding: calc(94px + 64px) 48px 96px;
    }
    h1 {
      height: auto;
      font-size: clamp(40px, 6.5vw, 68px);
      line-height: 1.2;
    }
  }
  @media (max-width: 760px) {
    h1 span {
      display: inline;
    }
    h1 span:not(:last-child)::after {
      content: ' ';
    }
  }
  @media (max-width: 600px) {
    .partners-hero {
      min-height: 100vh;
      min-height: 100dvh;
      justify-content: center;
      padding: clamp(90px, 14dvh, 130px) 24px clamp(40px, 8dvh, 60px);
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 70%, #050507 100%);
      pointer-events: none;
    }
    h1 {
      font-size: clamp(30px, 8.4vw, 44px);
      line-height: 1.2;
    }
  }
</style>
