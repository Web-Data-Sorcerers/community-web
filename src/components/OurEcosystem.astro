---
interface Step {
  number: string;
  title: string;
  description: string;
  width: number;
  lineHeight: number; // Vertical connecting line height in desktop px
}

const steps: Step[] = [
  {
    number: '01',
    title: 'COMMUNITY',
    description: 'Entry point, shared culture, and talent gathering',
    width: 188,
    lineHeight: 188,
  },
  {
    number: '02',
    title: 'LEARNING + HoDS',
    description:
      '4 House Domains (Data Intelligence, Core AI, Language & Reasoning, Vision)',
    width: 175,
    lineHeight: 116,
  },
  {
    number: '03',
    title: 'EXPERIMENTATION<br />+ RESEARCH',
    description: 'Rapid prototyping, paper drafting, testing ideas.',
    width: 188,
    lineHeight: 188,
  },
  {
    number: '04',
    title: 'PROJECT + BUILD',
    description: 'Open source projects, system building, team collaboration.',
    width: 175,
    lineHeight: 116,
  },
  {
    number: '05',
    title: 'OUTPUT & IMPACT',
    description:
      'Output Branches: RESEARCH, PAPER, OPEN SOURCE, PRODUCT, BUSINESS',
    width: 175,
    lineHeight: 217,
  },
];
---

<section id="our-ecosystem" class="ecosystem" aria-labelledby="ecosystem-title">
  <div class="canvas">
    <header class="ecosystem-header">
      <div class="eyebrow" aria-hidden="true">
        Our Ecosystem
      </div>
      <h2 id="ecosystem-title" class="title">
        From Community to Impact
      </h2>
      <p class="subtitle">
        Every member is part of an interconnected ecosystem — from learning to
        producing real work.
      </p>
    </header>

    <div class="pipeline-container">
      <div class="steps-row">
        {steps.map((step) => (
          <div
            class="step-col"
            style={`--col-w: ${step.width}px; --line-h: ${step.lineHeight}px;`}
          >
            <div class="step-card">
              <div class="step-badge">
                <span class="step-number" aria-hidden="true">
                  {step.number}
                </span>
                <h3 class="step-title" set:html={step.title} />
              </div>
              <p class="step-desc">{step.description}</p>
            </div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
        ))}
      </div>
      <img
        class="baseline"
        src="/images/about/ecosystem-baseline.svg"
        width="1280"
        height="2"
        alt=""
        aria-hidden="true"
      />
    </div>
  </div>
</section>

<style>
  .ecosystem {
    position: relative;
    width: 100%;
    background: linear-gradient(24.75deg, #050507 53%, #6c3bff 133%);
    overflow: clip;
  }

  .canvas {
    position: relative;
    max-width: 1440px;
    min-height: 100vh;
    min-height: 100svh;
    margin-inline: auto;
    padding: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  /* The gradient stays section-level (full-bleed) so the glow stretches continuously across the viewport; the canvas stays at 1440px max-width without zoom, matching the Philosophy About variant behaviour. */

  .ecosystem-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 931px;
    margin-inline: auto;
    padding: 10px;
    box-sizing: border-box;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font: 400 12px/18px var(--font-body, 'Manrope', sans-serif);
    margin-bottom: 8px;
    user-select: none;
  }

  .title {
    margin: 0 0 24px;
    /* Figma lineHeight 67.2 but node bbox 67; 67 keeps header at 172 / pipeline 368. */
    font: 700 56px/67px var(--font-display);
    text-align: center;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: normal;
  }

  .subtitle {
    margin: 0;
    max-width: 911px;
    font: 500 18px/27px var(--font-body, 'Manrope', sans-serif);
    color: #ffffff;
    text-align: center;
  }

  /* Pipeline steps */
  .pipeline-container {
    position: relative;
    width: 100%;
    max-width: 1280px;
    min-height: 426px;
    margin-top: 116px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 18px;
    box-sizing: border-box;
  }

  .steps-row {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 52px;
    width: 100%;
    max-width: 1109px;
  }

  .step-col {
    position: relative;
    width: var(--col-w, 175px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .step-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 175px;
    margin-inline: auto;
    gap: 12px;
  }

  .step-badge {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
  }

  .step-number {
    font: 700 56px/54px var(--font-body, 'Manrope', sans-serif);
    background: linear-gradient(180deg, #6c3bff 20.8%, rgba(5, 5, 7, 0) 75%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
    pointer-events: none;
  }

  .step-title {
    margin: -18px 0 0;
    font: 500 18px/27px var(--font-body, 'Manrope', sans-serif);
    color: #ffffff;
    text-align: center;
    position: relative;
    z-index: 1;
    word-break: normal;
  }

  .step-desc {
    margin: 0;
    font: 400 14px/21px var(--font-body, 'Manrope', sans-serif);
    color: #ffffff;
    text-align: center;
    width: 100%;
  }

  .step-line {
    width: 1px;
    height: var(--line-h, 116px);
    background: linear-gradient(180deg, #6c3bff, #fff);
  }

  .baseline {
    display: block;
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    max-width: 1280px;
    height: 2px;
  }

  /* Responsive styles */
  @media (min-width: 1051px) and (max-width: 1284px) {
    .steps-row {
      gap: 3vw;
    }

    .step-col {
      flex: 0 1 var(--col-w);
      min-width: 0;
    }

    .step-card {
      width: 100%;
    }

    .step-title {
      font-size: clamp(13px, 1.25vw, 18px);
      line-height: 1.4;
    }

    .step-desc {
      font-size: clamp(11px, 0.97vw, 14px);
      line-height: 1.5;
    }
  }

  @media (max-width: 1050px) {
    .canvas {
      padding: 60px 24px 60px;
    }

    .title {
      font-size: clamp(32px, 5vw, 44px);
      line-height: 1.2;
    }

    .subtitle {
      font-size: 16px;
      line-height: 24px;
    }

    .pipeline-container {
      margin-top: 48px;
      max-width: 600px;
      min-height: 0;
      padding-bottom: 0;
    }

    .steps-row {
      flex-direction: column;
      align-items: center;
      gap: 36px;
      max-width: 100%;
    }

    .step-col {
      width: 100%;
      max-width: 320px;
      margin-top: 0 !important;
    }

    .step-line {
      height: 36px !important;
      margin-top: 20px;
      background: linear-gradient(
        180deg,
        #6c3bff 0%,
        rgba(108, 59, 255, 0.2) 100%
      );
    }

    .step-col:last-child .step-line {
      display: none;
    }

    .baseline {
      display: none;
    }
  }

  @media (min-width: 701px) and (max-width: 1050px) {
    .steps-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      column-gap: 32px;
      row-gap: 40px;
    }

    .step-col {
      max-width: none;
    }

    .step-col:last-child {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc((100% - 32px) / 2);
    }

    .step-line {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .ecosystem {
      background: linear-gradient(
        180deg,
        #050507 0%,
        #1e1045 50%,
        #050507 100%
      );
    }
  }

  @media (max-width: 600px) {
    .canvas {
      padding: 48px 16px 48px;
    }

    .title {
      font-size: 28px;
      line-height: 1.25;
    }

    .subtitle {
      font-size: 14px;
      line-height: 21px;
    }
  }
</style>
