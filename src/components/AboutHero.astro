---
---

<section class="about-hero" aria-labelledby="about-hero-title">
  <div class="artwork" aria-hidden="true">
    <img
      class="art-bg"
      src="/images/about/hero-bg.webp"
      srcset="
        /images/about/hero-bg.webp     1440w,
        /images/about/hero-bg-2x.webp 2880w,
        /images/about/hero-bg-3x.webp 4320w
      "
      sizes="100vw"
      width="1440"
      height="903"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-content">
    <h1 id="about-hero-title">
      <span>Architecting the Future of AI </span>
      <span>&amp; Data Innovation.</span>
    </h1>
    <p>
      Data Sorcerers is an AI &amp; Data Innovation Community dedicated to
      developing people, knowledge, research, and technology through
      collaborative learning and real-world experimentation.
    </p>
  </div>
</section>

<style>
  /* Matches Figma node 1439:4185 (1440 x 903), page 1439:4184.
     Section: column, padding 80px, justify center, gap 16px, IMAGE fill.
     Content frame 1439:4186 (1280 x 287.4, hug): headline 1439:4187
     Bluu Next Bold 700 80/95.2 ls -0.88 (gradient per line) + subtitle
     1439:4188 Manrope Medium 500 18/27 #fff, text-shadow 0 4px 20px #000. */
  .about-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    padding: 80px;
    overflow: clip;
    text-align: center;
  }

  .artwork {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .artwork img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }

  h1 {
    margin: 0;
    width: 100%;
    max-width: 1124px;
    font-family: var(--font-display);
    font-size: 80px;
    font-weight: 700;
    line-height: 95.2px;
    letter-spacing: -0.88px;
    text-align: center;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  h1 span {
    display: block;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  p {
    margin: 0;
    width: 100%;
    max-width: 680px;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    letter-spacing: 0;
    text-align: center;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 1);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  @media (max-width: 1100px) {
    .about-hero {
      padding-top: calc(94px + 32px);
    }
    h1 {
      font-size: clamp(40px, 5.5vw, 68px);
      line-height: 1.18;
      letter-spacing: -0.5px;
    }
    p {
      font-size: clamp(16px, 1.8vw, 18px);
      line-height: 1.5;
    }
  }

  @media (max-width: 760px) {
    h1 span {
      display: inline;
    }
    h1 span:not(:last-child)::after {
      content: ' ';
    }
  }

  @media (min-width: 1921px) {
    .artwork {
      left: 50%;
      right: auto;
      width: 1920px;
      transform: translateX(-50%);
      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 12%,
        #000 88%,
        transparent
      );
    }
  }

  @media (max-width: 600px) {
    .about-hero {
      min-height: 100vh;
      min-height: 100dvh;
      justify-content: center;
      padding-top: clamp(90px, 13dvh, 120px);
      padding-bottom: clamp(40px, 8dvh, 60px);
    }
    .artwork::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 70%, #050507 100%);
      pointer-events: none;
    }
    .hero-content {
      gap: 16px;
    }
    h1 {
      font-size: clamp(26px, 7.5vw, 40px);
      line-height: 1.2;
      letter-spacing: -0.3px;
    }
    p {
      font-size: clamp(14px, 3.8vw, 16px);
      line-height: 1.55;
    }
  }
</style>
