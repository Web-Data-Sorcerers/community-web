---
import { canNavigateToTarget } from '../data/site-visibility-registry.mjs';
const canVisit = (page: string, section?: string) =>
  !Astro.locals.visibility ||
  canNavigateToTarget(Astro.locals.visibility, page, section);
import Button from './Button.astro';
---

<section
  id="recruitment"
  class="recruitment"
  aria-labelledby="recruitment-title"
>
  <div class="recruitment-panel">
    <div class="recruitment-copy">
      <header>
        <span class="eyebrow">Recruitment</span>
        <h2 id="recruitment-title">Ready to Become a Sorcery?</h2>
      </header>
      <p>
        Join a community where your learning can become experimentation, your
        ideas can become projects, and your work can create real impact.
      </p>
    </div>
    <div class="recruitment-actions">
      {canVisit('recruitment') && (
        <Button variant="community" href="/recruitment">
          Join the Community
        </Button>
      )}
    </div>
    <div class="glow-frame" aria-hidden="true">
      <div class="glow-art">
        <img src="/images/recruitment/glow.svg" alt="" loading="lazy" />
      </div>
    </div>
  </div>
</section>
<style>
  .recruitment {
    padding: 80px var(--page-gutter);
    background: var(--color-background);
  }
  .recruitment-panel {
    position: relative;
    isolation: isolate;
    max-width: 1280px;
    height: 394px;
    margin-inline: auto;
    padding: 64px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    border: 1px solid transparent;
    border-radius: 20px;
    overflow: hidden;
    background: rgb(98 80 255 / 10%);
  }
  .recruitment-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, #e0dcff, #504677 48%, #e0dcff);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }
  .recruitment-copy {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  header {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 4px 12px;
    border-radius: 32px;
    background: rgb(255 255 255 / 15%);
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 40%);
    font-size: 12px;
    line-height: 18px;
  }
  h2 {
    margin: 0;
    width: 100%;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67px;
    letter-spacing: 0;
    text-align: center;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  p {
    margin: 0;
    width: 586px;
    max-width: 100%;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.176px;
    text-align: center;
  }
  .recruitment-actions {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .glow-frame {
    position: absolute;
    z-index: -1;
    left: 268.83px;
    top: 270px;
    width: 1000.331px;
    height: 271.502px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .glow-art {
    position: relative;
    flex: none;
    width: 992px;
    height: 233px;
    transform: rotate(-2.23deg);
  }
  .glow-art img {
    position: absolute;
    left: -81.8%;
    top: -33.43%;
    width: 200.33%;
    height: 229.49%;
    max-width: none;
  }
  /* One-way sweep: the glow drifts left -> right and repeats, fading only at the seam so the reset is invisible (full opacity across the middle, no up/down). */
  @media (prefers-reduced-motion: no-preference) {
    .glow-art {
      animation: cta-glow-sweep 6.5s linear infinite;
    }
    .recruitment.is-idle .glow-art {
      animation-play-state: paused;
    }
  }
  @keyframes cta-glow-sweep {
    0% {
      translate: -150px 0;
      scale: 1;
      opacity: 0.5;
    }
    25% {
      opacity: 1;
    }
    50% {
      scale: 1.04;
    }
    75% {
      opacity: 1;
    }
    100% {
      translate: 150px 0;
      scale: 1;
      opacity: 0.5;
    }
  }
  @media (max-width: 1199px) {
    .recruitment-panel {
      padding-inline: 24px;
    }
    h2 {
      font-size: clamp(30px, 4.4vw, 56px);
      line-height: 1.214286;
    }
    .glow-frame {
      left: calc(100% - 1010px);
      top: auto;
      bottom: -125px;
    }
  }
  @media (max-width: 600px) {
    .recruitment {
      padding-block: 64px;
    }
    .recruitment-panel {
      padding: 48px 20px;
      gap: 32px;
    }
    h2 {
      font-size: clamp(28px, 6.8vw, 38px);
    }
    .recruitment-actions {
      flex-direction: column;
      gap: 16px;
    }
  }
  @media (max-width: 767px), (pointer: coarse) {
    .glow-art {
      animation: none;
    }
  }
</style>
