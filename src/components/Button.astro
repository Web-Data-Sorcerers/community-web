---
interface Props {
  href?: string;
  id?: string;
  disabled?: boolean;
  type?: 'button' | 'submit';
  compact?: boolean;
  variant?:
    | 'primary'
    | 'glass'
    | 'white'
    | 'secondary'
    | 'apply'
    | 'community'
    | 'explore';
}
const {
  href,
  id,
  disabled = true,
  type = 'button',
  variant = 'primary',
  compact = false,
} = Astro.props;
---

{href ? (
  <a
    class:list={['button', variant, { compact }]}
    href={href}
    data-sfx="click"
    data-sfx-hover="hover"
  >
    <slot />
  </a>
) : (
  <button
    class:list={['button', variant, { compact }]}
    id={id}
    type={type}
    aria-disabled={disabled ? 'true' : undefined}
    disabled={id ? disabled : undefined}
    data-sfx={disabled ? 'error' : 'click'}
    data-sfx-hover="hover"
  >
    <slot />
  </button>
)}
<style>
  .button {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 51px;
    padding: 8px 16px;
    border: 0;
    border-radius: 200px;
    font-size: 18px;
    font-weight: 600;
    line-height: 34.098px;
    white-space: nowrap;
    color: white;
    cursor: pointer;
    /* Gradients cannot interpolate, so only the rim/text fade; the fill swaps instantly. */
    transition:
      box-shadow 0.3s ease,
      color 0.3s ease,
      outline-color 0.3s ease;
  }
  .button:is(:active, [data-pressed]):not(:disabled):not(
      [aria-disabled='true']
    ) {
    opacity: 0.88;
    transition: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .button:is(:active, [data-pressed]):not(:disabled):not(
        [aria-disabled='true']
      ) {
      scale: 0.98;
    }
  }
  .button[aria-disabled] {
    cursor: default;
  }
  .primary {
    box-shadow:
      inset 0 2px 1.2px #cfdfff,
      inset -2px -2px 1.4px #97bfff,
      inset -8px -6px 8px rgb(226 202 255 / 25%),
      inset -2px -2px 4px rgb(178 211 255 / 90%);
    outline: 2px solid #cbc5ff;
    outline-offset: -1px;
    width: 205px;
    background: #6c3bff;
    overflow: hidden;
  }
  /* A rotated elliptical gradient reproduces the Figma radial paint in CSS. */
  .primary::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 20px;
    height: 20px;
    left: 44.211px;
    top: -10px;
    background: radial-gradient(
      circle closest-side at center,
      #6c3bff 0%,
      #845bff 25%,
      #9b7bff 50%,
      #845bff 75%,
      #6c3bff 100%
    );
    transform: matrix(13.439, 5.508, -22.14, 30.09, 0, 0);
  }
  .primary::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 2px 1.2px #cfdfff,
      inset -2px -2px 1.4px #97bfff,
      inset -8px -6px 8px rgb(226 202 255 / 25%),
      inset -2px -2px 4px rgb(178 211 255 / 90%);
  }
  .primary:hover {
    background: #2f196f;
  }
  .primary:hover::before {
    opacity: 0;
  }
  /* Figma CTA Navbar (component set 97:483 / Component 5): white pill,
     4px/16px padding, 2px gradient rim (148deg), 172x43px. */
  .white {
    width: 172px;
    height: 43px;
    padding: 4px 16px;
    background: #ffffff;
    color: #1e1e1e;
    box-shadow:
      inset 0 1.5px 1px #cfdfff,
      inset -1px -1px 1px #97bfff,
      inset -4px -3px 6px rgba(226, 202, 255, 0.25),
      inset -1px -1px 2px rgba(178, 211, 255, 0.6);
  }
  .white::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      148deg,
      rgba(203, 197, 255, 0.65) 0%,
      rgba(47, 90, 255, 0.45) 50%,
      rgba(238, 245, 255, 0.65) 100%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  /* Figma "Apply Noww Button" Secondary (1436:3498):
     solid #1A1A1A, 12px blur, inner shadows, 43px tall, border-radius 20px;
     Secondary hover (1436:3500) = solid #4C3B7E. */
  .secondary {
    height: 43px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    background-color: #1a1a1a;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      inset 0 0 40px rgb(242 242 242 / 25%),
      inset 0 0 0 1px rgb(153 153 153 / 60%),
      inset 0 2px 2px -1px rgb(255 255 255 / 80%),
      inset 2px 2px 3px -2px rgb(255 255 255 / 35%),
      inset -2px -2px 3px -2px rgb(196 191 220 / 45%);
  }
  .secondary:hover {
    background-color: #4c3b7e;
  }
  /* Apply Now variant for role detail pages & instances: radial violet, hover #2F196F. */
  .apply {
    height: 43px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    background: radial-gradient(
      circle at 26% 0%,
      #6c3bff 0%,
      #9b7bff 50%,
      #6c3bff 100%
    );
    box-shadow:
      inset 0 2px 1.2px rgb(255 255 255 / 50%),
      inset -2px -2px 1.4px #bca6ff,
      inset -2px -2px 4px rgb(188 166 255 / 90%);
  }
  .apply:hover {
    background: #2f196f;
  }
  .glass {
    width: 198px;
    overflow: hidden;
    background: rgb(217 217 217 / 10%);
    backdrop-filter: blur(6px);
    box-shadow:
      inset 6px 6px 1.06557px -6px rgb(255 255 255 / 50%),
      inset 4px 4px 2px -4px #b3b3b3,
      inset -6px -6px 2px -4px #b3b3b3,
      inset 0 0 0 2px #999,
      inset -3px -3px 3px -1px rgb(255 255 255 / 85%),
      inset 0 0 40px rgb(242 242 242 / 25%);
  }
  .glass::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      ellipse 54px 30px at 30% 110%,
      transparent 40%,
      rgb(255 255 255 / 24%) 55%,
      transparent 75%
    );
  }
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(
      130deg,
      #fff 4%,
      #ffffff20 20%,
      #ffffff50 70%,
      #fff 92%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .glass.compact {
    width: 179px;
    background: rgb(217 217 217 / 10%);
    box-shadow:
      inset 6px 6px 1.06557px -6px rgb(255 255 255 / 50%),
      inset 4px 4px 2px -4px #b3b3b3,
      inset -6px -6px 2px -4px #b3b3b3,
      inset 0 0 0 2px #999,
      inset 0 0 40px rgb(242 242 242 / 50%);
  }
  /* Homepage revision (Figma component sets 1393:3304 / 1393:3355 / 1393:3307):
     Primary = violet radial pill that hugs its label, 43px tall (18/27 + 8px
     padding); hover fills solid #2F196F. */
  .community {
    height: 43px;
    padding: 8px 16px;
    font-weight: 500;
    line-height: 27px;
    background: radial-gradient(
      circle at 26% 0%,
      #6c3bff 0%,
      #9b7bff 50%,
      #6c3bff 100%
    );
    box-shadow:
      inset 0 2px 1.2px rgb(255 255 255 / 50%),
      inset -2px -2px 1.4px #bca6ff,
      inset -2px -2px 4px rgb(188 166 255 / 90%);
  }
  .community:hover {
    background: #2f196f;
  }
  /* Secondary = dark glass pill that hugs its label; hover #4C3B7E. The raw
     Figma inset shadows (40px inner glow + 2px #999 ring) render far brighter
     than the node/PNG, so the rim is baked from the reference export instead:
     a dark violet fill with a thin bright edge and a soft top-left highlight. */
  .explore {
    height: 43px;
    padding: 8px 16px;
    font-weight: 500;
    line-height: 27px;
    background: #22213a;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow:
      inset 0 0 0 1px rgb(184 182 205 / 55%),
      inset 0 2px 2px -1px rgb(255 255 255 / 80%),
      inset 2px 2px 3px -2px rgb(255 255 255 / 35%),
      inset -2px -2px 3px -2px rgb(196 191 220 / 45%);
  }
  .explore:hover {
    background: #4c3b7e;
  }
  /* Hover: glass and white turn violet. */
  .glass:hover,
  .white:hover {
    background: radial-gradient(
      circle at 26% 0%,
      #6c3bff 0%,
      #9b7bff 50%,
      #6c3bff 100%
    );
    box-shadow:
      inset -2px -2px 4px rgb(178 211 255 / 90%),
      inset -8px -6px 8px rgb(226 202 255 / 25%),
      inset -2px -2px 1.4px #97bfff,
      inset 0 2px 1.2px #cfdfff;
  }
  .white:hover {
    color: #fff;
  }
  .glass:hover::before {
    opacity: 0;
  }
  .glass:hover::after {
    background: linear-gradient(
      148deg,
      rgb(203 197 255 / 50%) 0%,
      rgb(47 90 255 / 50%) 50%,
      rgb(238 245 255 / 50%) 100%
    );
  }
  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
  @media (max-width: 600px) {
    .button {
      font-size: 15px;
      height: 48px;
    }
    .primary {
      width: 184px;
    }
    .glass {
      width: 180px;
    }
  }
</style>
