---
import { canNavigateToTarget } from '../data/site-visibility-registry.mjs';
const canVisit = (page: string, section?: string) =>
  !Astro.locals.visibility ||
  canNavigateToTarget(Astro.locals.visibility, page, section);
import type { HodDetail } from '../data/hods';
interface Props {
  hod: HodDetail;
}
const { hod } = Astro.props;
const fromRecruitment =
  Astro.url.searchParams.get('from') === 'recruitment' &&
  canVisit('recruitment');
const backPage = fromRecruitment ? 'recruitment' : 'home';
const backSection = fromRecruitment ? 'who-should-join' : 'domains';
const backPath = fromRecruitment ? '/recruitment/' : '/';
const backHref = canVisit(backPage, backSection)
  ? (fromRecruitment ? '/recruitment' : '/') + '#' + backSection
  : backPath;
---

<main class="hods-detail">
  <span class="detail-wave" aria-hidden="true" />
  <div class="hods-detail-inner">
    <a class="back" href={backHref} data-sfx="select" data-sfx-hover="hover">
      <img src="/images/hods/arrow.svg" width="24" height="24" alt="" />
      <span>
        {fromRecruitment ? 'Back to Who Should Join' : 'Back to HoDS'}
      </span>
    </a>

    <div class="role-card">
      <img
        class="role-art"
        src={hod.cardImage}
        width="1280"
        height="279"
        alt=""
        loading="eager"
        decoding="async"
      />
      <div class="role-copy">
        <h1>{hod.title}</h1>
        <p>{hod.description}</p>
      </div>
    </div>

    <div class="role-body">
      <div class="tabs" role="tablist" aria-label={`${hod.title} roles`}>
        {hod.tabs.map((tab, index) => (
          <button
            class:list={['tab', { active: index === 0 }]}
            type="button"
            role="tab"
            id={`tab-${hod.id}-${index}`}
            aria-controls={`panel-${hod.id}-${index}`}
            aria-selected={index === 0}
            tabindex={index === 0 ? 0 : -1}
            data-index={index}
            data-sfx-hover="hover"
          >
            {tab.label}
          </button>
        ))}
      </div>

      {hod.tabs.map((tab, index) => (
        <div
          class="panel"
          id={`panel-${hod.id}-${index}`}
          role="tabpanel"
          aria-labelledby={`tab-${hod.id}-${index}`}
          hidden={index !== 0}
        >
          {tab.sections.map((section, i) => (
            <section class="block" style={`--i:${i}`}>
              <h2>{section.title}</h2>
              {section.kind === 'bullets' ? (
                <ul class="bullets">
                  {section.bullets?.map((item) => (
                    <li>
                      <span class="dot" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class:list={['body', section.color === 'white' && 'white']}>
                  {section.text}
                </p>
              )}
            </section>
          ))}
        </div>
      ))}
    </div>
  </div>
</main>

<script>
  // Re-run after every client-side navigation: the DOM and the `from` query are
  // both new, so the back link and the tabs must be (re)wired each time.
  const initHoDSDetail = () => {
    document.querySelectorAll<HTMLElement>('.hods-detail').forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
      const panels = [...root.querySelectorAll<HTMLElement>('.panel')];
      const select = (index: number) => {
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.classList.toggle('active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[i].hidden = !active;
        });
        window.dispatchEvent(
          new CustomEvent('ds:sfx', { detail: { cue: 'select' } }),
        );
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index));
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
          event.preventDefault();
          const next =
            (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) %
            tabs.length;
          select(next);
          tabs[next].focus();
        });
      });
    });
  };

  document.addEventListener('astro:page-load', initHoDSDetail);
</script>

<style>
  /* The gradient is full-bleed; the content stays on the 1440 grid. */
  .hods-detail {
    position: relative;
    width: 100%;
    background: linear-gradient(-9deg, rgb(108 59 255 / 50%) 0%, #050507 19%);
  }
  /* One-way glow wave along the bottom edge: the same oversized glow.svg sweep
     as the CTA, so there is no tiling seam. Two layers drift in opposite
     directions and breathe so the glow feels alive. Hidden under reduced motion
     so the static page stays pixel-identical to the reference. */
  .detail-wave {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 0;
    height: 190px;
    overflow: hidden;
    pointer-events: none;
  }
  .detail-wave::before,
  .detail-wave::after {
    content: '';
    position: absolute;
    background: url('/images/recruitment/glow.svg') center bottom / 100% 100%
      no-repeat;
    opacity: 0;
  }
  .detail-wave::before {
    left: -6%;
    bottom: -330px;
    width: 112%;
    height: 480px;
  }
  .detail-wave::after {
    left: -14%;
    bottom: -360px;
    width: 128%;
    height: 540px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .detail-wave::before {
      animation: detail-wave-drift 19s ease-in-out infinite;
    }
    .detail-wave::after {
      animation: detail-wave-breathe 14s ease-in-out infinite;
    }
  }
  @keyframes detail-wave-drift {
    0%,
    100% {
      translate: -70px 6px;
      opacity: 0.34;
    }
    50% {
      translate: 70px -6px;
      opacity: 0.62;
    }
  }
  @keyframes detail-wave-breathe {
    0%,
    100% {
      translate: 44px 0;
      opacity: 0.16;
    }
    50% {
      translate: -44px 0;
      opacity: 0.4;
    }
  }
  .hods-detail-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 56px;
    width: 100%;
    max-width: 1440px;
    min-height: 1280px;
    margin-inline: auto;
    padding: 80px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    align-self: flex-start;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }
  .back img {
    display: block;
    width: 24px;
    height: 24px;
  }
  .role-card {
    position: relative;
    isolation: isolate;
    width: 1280px;
    max-width: 100%;
    height: 279px;
    border-radius: 20px;
  }
  .role-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(136deg, #e0dcff 2%, #2e276c 51%, #cbc5ff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  .role-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }
  .role-copy {
    position: absolute;
    left: 42px;
    top: 85px;
    width: 1196px;
    max-width: calc(100% - 84px);
  }
  .role-copy h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(270deg, #fff, #ede8ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .role-copy p {
    margin: 14px 0 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 39px;
    color: #fff;
  }
  .role-body {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .tab {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 4px 12px;
    border: 0;
    border-radius: 20px;
    background: rgb(255 255 255 / 15%);
    color: #fff;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .tab:hover {
    background-color: rgb(255 255 255 / 24%);
  }
  /* Active fill lives on a pseudo so the gradient can cross-fade (gradients themselves cannot interpolate). */
  .tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      88.1% 186.23% at 8.33% 18.75%,
      #6c3bff 0%,
      #3c2189 98.03%
    );
    box-shadow: inset 0 -1px 1.9px rgb(255 255 255 / 25%);
    opacity: 0;
    transition: opacity 0.34s ease;
  }
  .tab.active {
    background-color: transparent;
  }
  .tab.active::before {
    opacity: 1;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 42px;
  }
  .panel[hidden] {
    display: none;
  }
  /* Each tab swap re-runs these (display:none -> block restarts the animation). */
  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) .block {
      animation: hods-block-in 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
  }
  @keyframes hods-block-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab,
    .tab::before {
      transition: none;
    }
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .block h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    line-height: 39px;
    color: #fff;
  }
  .body {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: #ede8ff;
    white-space: pre-line;
  }
  .body.white {
    color: #fff;
  }
  .bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    display: flex;
    align-items: center;
    gap: 23px;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
  }
  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6c3bff 17%, #ede8ff 50%, #6c3bff 83%);
  }
  @media (max-width: 900px) {
    /* Fill the viewport so the gradient never leaves a body-coloured gap below it when the content is shorter than the screen (phones with the browser chrome hidden). Desktop keeps the exact 1280px reference frame. */
    .hods-detail {
      min-height: 100vh;
      min-height: 100lvh;
    }
    .hods-detail-inner {
      min-height: 0;
      gap: 40px;
      padding: calc(40px + env(safe-area-inset-top, 0px)) 24px 40px;
    }
    .role-card {
      height: auto;
      min-height: 220px;
      display: flex;
      align-items: flex-end;
    }
    .role-copy {
      position: relative;
      left: 0;
      top: 0;
      width: auto;
      max-width: none;
      padding: 24px;
    }
    .role-copy h1 {
      font-size: 32px;
    }
    .role-copy p {
      font-size: 16px;
      line-height: 27px;
    }
    .tab {
      font-size: 14px;
    }
    .block h2 {
      font-size: 22px;
      line-height: 33px;
    }
    .body,
    .bullets li {
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
