<!-- Client Script: Stepper, Reactive HoDS Matrix, Autosave LocalStorage, and Submission -->
<script>
  import { HODS_DIVISIONS } from '../../data/recruitment-form';

  const STORAGE_KEY = 'ds_recruitment_application_draft';

  const initRecruitmentForm = () => {
    const form = document.getElementById(
      'recruitment-apply-form',
    ) as HTMLFormElement | null;
    if (!form) return;

    const steps = Array.from(form.querySelectorAll<HTMLElement>('.form-step'));
    const stepNavBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.step-btn'),
    );
    const progressBar = document.getElementById('stepper-progress');
    const successScreen = document.getElementById('success-screen');
    const specificAreaContainer = document.getElementById(
      'specific-area-options',
    );
    const skillsMatrixContainer = document.getElementById(
      'skills-matrix-container',
    );

    let currentStep = 1;
    const totalSteps = steps.length;

    // Helper: Update UI for active step
    const goToStep = (stepNumber: number) => {
      if (stepNumber < 1 || stepNumber > totalSteps) return;
      currentStep = stepNumber;

      steps.forEach((stepEl) => {
        const stepIdx = Number(stepEl.dataset.stepPanel);
        stepEl.classList.toggle('is-active', stepIdx === currentStep);
      });

      stepNavBtns.forEach((btn) => {
        const btnIdx = Number(btn.dataset.step);
        btn.classList.toggle('is-active', btnIdx === currentStep);
        btn.classList.toggle('is-completed', btnIdx < currentStep);
      });

      if (progressBar) {
        const pct = (currentStep / totalSteps) * 100;
        progressBar.style.width = `${pct}%`;
      }

      // Smooth scroll to top of form
      const applySection = document.getElementById('apply-section');
      if (applySection) {
        applySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    // Validate a specific fieldset/step
    const validateStep = (stepNumber: number): boolean => {
      const activeStepEl = steps.find(
        (s) => Number(s.dataset.stepPanel) === stepNumber,
      );
      if (!activeStepEl) return true;

      let isValid = true;
      const requiredInputs = activeStepEl.querySelectorAll<
        HTMLInputElement | HTMLTextAreaElement
      >('[required]');

      // Clear previous error messages in this step
      activeStepEl
        .querySelectorAll<HTMLElement>('.field-error')
        .forEach((err) => (err.textContent = ''));
      activeStepEl
        .querySelectorAll<HTMLElement>('.has-error')
        .forEach((el) => el.classList.remove('has-error'));

      const checkedGroups = new Set<string>();

      requiredInputs.forEach((input) => {
        const fieldParent =
          input.closest('.field') || input.closest('.agreement-field');

        if (input.type === 'radio') {
          if (checkedGroups.has(input.name)) return;
          checkedGroups.add(input.name);
          const checked = activeStepEl.querySelector<HTMLInputElement>(
            `input[name="${input.name}"]:checked`,
          );
          if (!checked) {
            isValid = false;
            if (fieldParent) {
              fieldParent.classList.add('has-error');
              const errSpan =
                fieldParent.querySelector<HTMLElement>('.field-error');
              if (errSpan) errSpan.textContent = 'Pilihan ini wajib diisi.';
            }
          }
        } else if (
          input instanceof HTMLInputElement &&
          input.type === 'checkbox'
        ) {
          if (!input.checked) {
            isValid = false;
            if (fieldParent) {
              fieldParent.classList.add('has-error');
              const errSpan =
                fieldParent.querySelector<HTMLElement>('.field-error');
              if (errSpan)
                errSpan.textContent =
                  'Harap centang semua pernyataan persetujuan.';
            }
          }
        } else {
          if (!input.value.trim()) {
            isValid = false;
            if (fieldParent) {
              fieldParent.classList.add('has-error');
              const errSpan =
                fieldParent.querySelector<HTMLElement>('.field-error');
              if (errSpan) errSpan.textContent = 'Bagian ini wajib diisi.';
            }
          } else if (
            input.type === 'email' &&
            !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())
          ) {
            isValid = false;
            if (fieldParent) {
              fieldParent.classList.add('has-error');
              const errSpan =
                fieldParent.querySelector<HTMLElement>('.field-error');
              if (errSpan) errSpan.textContent = 'Format email tidak valid.';
            }
          }
        }
      });

      return isValid;
    };

    // Render Dynamic Specific Areas & Skills Matrix when HoDS changes
    const renderHoDSFields = (hodsId: string) => {
      const hods = HODS_DIVISIONS.find((h) => h.id === hodsId);
      if (!hods) return;

      // 1. Specific Areas
      if (specificAreaContainer) {
        specificAreaContainer.innerHTML = '';
        hods.specificAreas.forEach((area) => {
          const label = document.createElement('label');
          label.className = 'pill-radio-label';
          label.innerHTML = `
            <input type="radio" name="specific_area" value="${area}" />
            <span class="pill-content">${area}</span>
          `;
          specificAreaContainer.appendChild(label);
        });
      }

      // 2. Skills Matrix
      if (skillsMatrixContainer) {
        skillsMatrixContainer.innerHTML = '';
        hods.skills.forEach((group) => {
          if (group.category) {
            const catTitle = document.createElement('h4');
            catTitle.className = 'skill-cat-title';
            catTitle.textContent = group.category;
            skillsMatrixContainer.appendChild(catTitle);
          }
          const pillsGrid = document.createElement('div');
          pillsGrid.className = 'pills-grid';

          group.items.forEach((skill) => {
            const label = document.createElement('label');
            label.className = 'pill-checkbox-label';
            label.innerHTML = `
              <input type="checkbox" name="foundation_skills" value="${skill}" />
              <span class="pill-content">${skill}</span>
            `;
            pillsGrid.appendChild(label);
          });
          skillsMatrixContainer.appendChild(pillsGrid);
        });
      }
    };

    // Listen to HoDS radio changes
    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target && target.name === 'primary_hods') {
        renderHoDSFields(target.value);
        saveDraft();
      }
    });

    // Save Draft to LocalStorage (debounced)
    let saveTimeout: ReturnType<typeof setTimeout>;
    const saveDraft = () => {
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(() => {
        try {
          const formData = new FormData(form);
          const draft: Record<string, any> = {};
          formData.forEach((val, key) => {
            if (draft[key]) {
              if (Array.isArray(draft[key])) {
                draft[key].push(val);
              } else {
                draft[key] = [draft[key], val];
              }
            } else {
              draft[key] = val;
            }
          });
          localStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
        } catch {
          // Ignore localStorage errors
        }
      }, 400);
    };

    form.addEventListener('input', saveDraft);
    form.addEventListener('change', saveDraft);

    // Restore Draft from LocalStorage
    const restoreDraft = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw);

        // Pre-render HoDS if saved
        if (draft.primary_hods) {
          const hodsRadio = form.querySelector<HTMLInputElement>(
            `input[name="primary_hods"][value="${draft.primary_hods}"]`,
          );
          if (hodsRadio) {
            hodsRadio.checked = true;
            renderHoDSFields(draft.primary_hods);
          }
        }

        Object.entries(draft).forEach(([key, val]) => {
          if (key === 'primary_hods') return; // already restored

          if (Array.isArray(val)) {
            val.forEach((itemVal) => {
              const el = form.querySelector<HTMLInputElement>(
                `[name="${key}"][value="${itemVal}"]`,
              );
              if (el && el.type === 'checkbox') el.checked = true;
            });
          } else {
            const el = form.elements.namedItem(key);
            if (el instanceof HTMLInputElement) {
              if (el.type === 'checkbox' || el.type === 'radio') {
                const specificEl = form.querySelector<HTMLInputElement>(
                  `[name="${key}"][value="${val}"]`,
                );
                if (specificEl) specificEl.checked = true;
              } else {
                el.value = String(val);
              }
            } else if (el instanceof HTMLTextAreaElement) {
              el.value = String(val);
            }
          }
        });
      } catch {
        // Ignore restore errors
      }
    };

    // Auto-select HoDS from URL query param ?role=...
    const checkUrlRoleParam = () => {
      const params = new URLSearchParams(window.location.search);
      const roleParam = params.get('role');
      if (roleParam) {
        // Map common aliases to role ids
        const normalized = roleParam.toLowerCase();
        let targetId = '';
        if (normalized.includes('data')) targetId = 'data';
        else if (
          normalized.includes('core') ||
          normalized.includes('ai-engineer')
        )
          targetId = 'core';
        else if (normalized.includes('lang') || normalized.includes('reason'))
          targetId = 'language';
        else if (normalized.includes('vision') || normalized.includes('multi'))
          targetId = 'vision';
        else if (normalized.includes('prod') || normalized.includes('soft'))
          targetId = 'product';
        else if (normalized.includes('growth') || normalized.includes('comm'))
          targetId = 'growth';

        if (targetId) {
          const radio = form.querySelector<HTMLInputElement>(
            `input[name="primary_hods"][value="${targetId}"]`,
          );
          if (radio) {
            radio.checked = true;
            renderHoDSFields(targetId);
          }
        }
      }
    };

    // Stepper Navigation clicks
    stepNavBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetStep = Number(btn.dataset.step);
        if (targetStep < currentStep) {
          goToStep(targetStep);
        } else if (targetStep > currentStep) {
          if (validateStep(currentStep)) {
            goToStep(targetStep);
          }
        }
      });
    });

    // Next / Prev button actions
    form.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-action]',
      );
      if (!target) return;

      const action = target.dataset.action;
      if (action === 'next-step') {
        if (validateStep(currentStep)) {
          goToStep(currentStep + 1);
        }
      } else if (action === 'prev-step') {
        goToStep(currentStep - 1);
      }
    });

    // Form Submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateStep(currentStep)) {
        return;
      }

      const submitBtn = document.getElementById(
        'btn-submit-application',
      ) as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
      }

      const formData = new FormData(form);
      const webhookUrl = form.dataset.webhook || '';

      try {
        if (webhookUrl && webhookUrl.startsWith('http')) {
          await fetch(webhookUrl, {
            method: 'POST',
            body: formData,
            mode: 'no-cors', // standard for Google Apps Script webhooks
          });
        } else {
          // If no webhook provided yet, log draft to console and proceed
          const draftPayload: Record<string, any> = {};
          formData.forEach((val, key) => {
            draftPayload[key] = val;
          });
          console.info('Data Sorcerers Application payload:', draftPayload);
        }

        // Clean up draft
        localStorage.removeItem(STORAGE_KEY);

        // Sound effect cue
        window.dispatchEvent(new CustomEvent('ds:sfx', { detail: 'success' }));

        // Hide form and show success screen
        form.style.display = 'none';
        const stepperNav = document.querySelector<HTMLElement>('.stepper-nav');
        if (stepperNav) stepperNav.style.display = 'none';

        if (successScreen) {
          successScreen.hidden = false;
          successScreen.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (err) {
        console.error('Submission error:', err);
        alert(
          'Terjadi kendala saat mengirim aplikasi. Silakan coba sesaat lagi.',
        );
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('is-loading');
        }
      }
    });

    // Initialization sequence
    restoreDraft();
    checkUrlRoleParam();
  };

  document.addEventListener('astro:page-load', initRecruitmentForm);
</script>

