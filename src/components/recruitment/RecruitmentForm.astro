---
import {
  HODS_DIVISIONS,
  CURRENT_STATUS_OPTIONS,
  CURRENT_LEVEL_OPTIONS,
  LEARNING_METHODS_OPTIONS,
  PROJECT_EXPERIENCE_OPTIONS,
  DESIRED_OUTPUT_OPTIONS,
  TEAM_ROLES_OPTIONS,
  TIME_COMMITMENT_OPTIONS,
  CONTRIBUTION_TYPE_OPTIONS,
  CROSS_HODS_OPTIONS,
  BEST_DESCRIPTION_OPTIONS,
  INDEPENDENT_LEARNING_OPTIONS,
  AGREEMENT_STATEMENTS,
} from '../../data/recruitment-form';

interface Props {
  webhookUrl?: string;
}

const { webhookUrl = '' } = Astro.props;
---

<section class="recruitment-form-section" id="apply-section">
  <!-- Subtle background glow orbs -->
  <div class="glow-orb glow-top-left" aria-hidden="true"></div>
  <div class="glow-orb glow-bottom-right" aria-hidden="true"></div>

  <div class="form-container">
    <!-- Header Hero -->
    <header class="form-header">
      <div class="pill-badge">
        <span class="pill-dot" aria-hidden="true"></span>
        <span>OPEN RECRUITMENT 2026</span>
      </div>
      <h1 class="headline">
        <span>BRING YOUR FOUNDATION.</span>
        <span>BUILD WHAT COMES NEXT.</span>
      </h1>
      <div class="description-card">
        <p>
          Data Sorcerers is an AI & Data Innovation Community where people
          learn, experiment, research, build, and create real-world impact.
        </p>
        <p>
          We are looking for people who already have a foundation in their
          chosen field and are ready to develop it through real projects,
          experimentation, research, and collaboration.
        </p>
        <p class="highlight-quote">
          <strong>
            You don't need to be an expert. But you shouldn't be starting from
            zero.
          </strong>
        </p>
        <p class="closing-call">
          Choose your area, show us what you've explored, and tell us what you
          want to build next.
        </p>
      </div>
    </header>

    <!-- Stepper Indicator -->
    <nav class="stepper-nav" aria-label="Recruitment form steps">
      <div class="stepper-progress-track">
        <div
          class="stepper-progress-bar"
          id="stepper-progress"
          style="width: 25%;"
        ></div>
      </div>
      <div class="steps-list" id="steps-list">
        <button
          type="button"
          class="step-btn is-active"
          data-step="1"
          data-sfx="click"
        >
          <span class="step-num">01</span>
          <span class="step-label">Identity & Level</span>
        </button>
        <button type="button" class="step-btn" data-step="2" data-sfx="click">
          <span class="step-num">02</span>
          <span class="step-label">Domain & Skills</span>
        </button>
        <button type="button" class="step-btn" data-step="3" data-sfx="click">
          <span class="step-num">03</span>
          <span class="step-label">Evidence & Vision</span>
        </button>
        <button type="button" class="step-btn" data-step="4" data-sfx="click">
          <span class="step-num">04</span>
          <span class="step-label">Commitment & Values</span>
        </button>
      </div>
    </nav>

    <!-- Form Element -->
    <form id="recruitment-apply-form" data-webhook={webhookUrl} novalidate>
      <!-- STEP 1: IDENTITY & LEVEL -->
      <fieldset class="form-step is-active" data-step-panel="1">
        <legend class="sr-only">
          Step 1: Personal Information & Know Yourself
        </legend>

        <!-- Section 01: Personal Information -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 01</span>
            <h2>Personal Information</h2>
          </div>

          <div class="fields-grid">
            <label class="field col-span-2">
              <span class="field-label">
                1. Full Name <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Nama lengkap sesuai identitas yang biasa digunakan.
              </span>
              <input
                type="text"
                name="full_name"
                required
                placeholder="e.g. Alex Morgan"
                autocomplete="name"
              />
              <span class="field-error" aria-live="polite"></span>
            </label>

            <label class="field">
              <span class="field-label">
                2. Preferred Name <mark class="req">*</mark>
              </span>
              <span class="field-desc">Nama panggilan sehari-hari.</span>
              <input
                type="text"
                name="preferred_name"
                required
                placeholder="e.g. Alex"
              />
              <span class="field-error" aria-live="polite"></span>
            </label>

            <label class="field">
              <span class="field-label">
                3. Email Address <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Pastikan email aktif untuk informasi pengumuman.
              </span>
              <input
                type="email"
                name="email"
                required
                placeholder="alex@example.com"
                autocomplete="email"
              />
              <span class="field-error" aria-live="polite"></span>
            </label>

            <label class="field">
              <span class="field-label">
                4. WhatsApp Number <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Nomor WhatsApp aktif untuk koordinasi.
              </span>
              <input
                type="tel"
                name="whatsapp"
                required
                placeholder="08xxxxxxxxxx / +628xxxxxxxxxx"
                autocomplete="tel"
              />
              <span class="field-error" aria-live="polite"></span>
            </label>

            <label class="field">
              <span class="field-label">
                5. Current Institution / University / Organization{' '}
                <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Nama kampus, sekolah, atau institusi saat ini.
              </span>
              <input
                type="text"
                name="institution"
                required
                placeholder="e.g. Institut Teknologi Bandung / Tech Company"
              />
              <span class="field-error" aria-live="polite"></span>
            </label>

            <div class="field col-span-2">
              <span class="field-label">
                6. Current Status <mark class="req">*</mark>
              </span>
              <span class="field-desc">Pilih status utama Anda saat ini.</span>
              <div class="pills-grid">
                {CURRENT_STATUS_OPTIONS.map((status) => (
                  <label class="pill-radio-label">
                    <input
                      type="radio"
                      name="current_status"
                      value={status}
                      required
                    />
                    <span class="pill-content">{status}</span>
                  </label>
                ))}
              </div>
              <span class="field-error" aria-live="polite"></span>
            </div>

            <label class="field col-span-2">
              <span class="field-label">
                7. City / Region <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Data Sorcerers operates in a hybrid environment. You can apply
                from anywhere.
              </span>
              <input
                type="text"
                name="city_region"
                required
                placeholder="e.g. Jakarta, Bandung, Surabaya, Yogyakarta, dll."
              />
              <span class="field-error" aria-live="polite"></span>
            </label>
          </div>
        </div>

        <!-- Section 02: Know Yourself -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 02</span>
            <h2>Know Yourself</h2>
          </div>

          <div class="fields-stack">
            <div class="field">
              <span class="field-label">
                8. How would you describe your current level?{' '}
                <mark class="req">*</mark>
              </span>
              <div class="notice-box">
                <span class="notice-icon" aria-hidden="true">
                  ✦
                </span>
                <p>
                  <strong>Catatan:</strong> Pilihan <em>"Foundation"</em> adalah
                  target utama recruitment. Beginner tidak otomatis ditolak,
                  tetapi kandidat perlu menunjukkan bukti bahwa mereka sudah
                  mulai belajar dan mencoba.
                </p>
              </div>
              <div class="level-cards-grid">
                {CURRENT_LEVEL_OPTIONS.map((level) => (
                  <label class="level-card-label">
                    <input
                      type="radio"
                      name="current_level"
                      value={level.value}
                      required
                    />
                    <div class="level-card-content">
                      <span class="level-tag">{level.value}</span>
                      <span class="level-detail">{level.label}</span>
                    </div>
                  </label>
                ))}
              </div>
              <span class="field-error" aria-live="polite"></span>
            </div>

            <div class="field">
              <span class="field-label">
                9. How do you usually learn new things?
              </span>
              <span class="field-desc">
                Pilih semua media belajar yang biasa Anda gunakan.
              </span>
              <div class="pills-grid">
                {LEARNING_METHODS_OPTIONS.map((method) => (
                  <label class="pill-checkbox-label">
                    <input
                      type="checkbox"
                      name="learning_methods"
                      value={method}
                    />
                    <span class="pill-content">{method}</span>
                  </label>
                ))}
              </div>
            </div>

            <label class="field">
              <span class="field-label">
                10. What are you currently exploring?
              </span>
              <span class="field-desc">
                Ceritakan secara singkat teknologi, bidang, atau topik yang
                sedang kamu pelajari.
              </span>
              <textarea
                name="currently_exploring"
                rows="3"
                placeholder="Misal: Saat ini saya sedang mendalami prompt engineering untuk RAG, mempelajari arsitektur Next.js 15, atau belajar machine learning dengan scikit-learn..."
              ></textarea>
            </label>
          </div>
        </div>

        <div class="step-actions">
          <button
            type="button"
            class="btn-step-action btn-next"
            data-action="next-step"
            data-sfx="click"
          >
            <span>Continue to Domain & Skills</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </button>
        </div>
      </fieldset>

      <!-- STEP 2: DOMAIN & SKILLS -->
      <fieldset class="form-step" data-step-panel="2">
        <legend class="sr-only">
          Step 2: Choose Your HoDS & Foundation Skills
        </legend>

        <!-- Section 03: Choose Your HoDS -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 03</span>
            <h2>Choose Your House of Data Sorcerers (HoDS)</h2>
          </div>

          <div class="fields-stack">
            <div class="field">
              <span class="field-label">
                11. Which HoDS do you want to join? <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Pilih <strong>satu HoDS utama</strong> sebagai divisi rumah
                kemampuan Anda.
              </span>

              <div class="hods-cards-grid" id="hods-selector-group">
                {HODS_DIVISIONS.map((hods) => (
                  <label class="hods-card-label" data-hods-id={hods.id}>
                    <input
                      type="radio"
                      name="primary_hods"
                      value={hods.id}
                      required
                    />
                    <div class="hods-card-content">
                      <div class="hods-card-top">
                        <span class="hods-dot" aria-hidden="true"></span>
                        <h3 class="hods-title">{hods.name}</h3>
                      </div>
                      <p class="hods-desc">{hods.shortDesc}</p>
                      <div class="hods-chips">
                        {hods.specificAreas.slice(0, 3).map((area) => (
                          <span class="chip-tag">{area}</span>
                        ))}
                      </div>
                    </div>
                  </label>
                ))}
              </div>
              <span class="field-error" aria-live="polite"></span>
            </div>

            <!-- Dynamic Specific Areas -->
            <div class="field" id="specific-area-container">
              <span class="field-label">
                12. What specific area are you most interested in?
              </span>
              <span class="field-desc">
                Pilihan area ini disesuaikan dengan HoDS yang Anda pilih di
                atas.
              </span>
              <div class="pills-grid" id="specific-area-options">
                <!-- Dynamically rendered by JS -->
                <p class="muted-note">
                  Silakan pilih HoDS utama terlebih dahulu di atas.
                </p>
              </div>
            </div>

            <label class="field">
              <span class="field-label">
                13. Do you have a secondary area of interest?
              </span>
              <span class="field-desc">
                Berguna untuk mengetahui potensi kolaborasi lintas divisi (e.g.
                Primary: Generative AI, Secondary: Machine Learning).
              </span>
              <input
                type="text"
                name="secondary_interest"
                placeholder="e.g. UI/UX Design, DevOps, or Data Engineering"
              />
            </label>
          </div>
        </div>

        <!-- Section 04: Your Foundation -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 04</span>
            <h2>Your Foundation Skills</h2>
          </div>

          <div class="fields-stack">
            <div class="field">
              <span class="field-label">14. What do you already know?</span>
              <span class="field-desc">
                Pilih teknologi / konsep yang pernah kamu pelajari atau gunakan.
              </span>
              <div id="skills-matrix-container" class="skills-matrix-box">
                <!-- Dynamically populated based on chosen HoDS -->
                <p class="muted-note">
                  Pilih HoDS di atas untuk memuat daftar keahlian terkait.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="step-actions">
          <button
            type="button"
            class="btn-step-action btn-prev"
            data-action="prev-step"
            data-sfx="click"
          >
            <span class="arrow" aria-hidden="true">
              ←
            </span>
            <span>Back</span>
          </button>
          <button
            type="button"
            class="btn-step-action btn-next"
            data-action="next-step"
            data-sfx="click"
          >
            <span>Continue to Evidence & Vision</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </button>
        </div>
      </fieldset>

      <!-- STEP 3: EVIDENCE & VISION -->
      <fieldset class="form-step" data-step-panel="3">
        <legend class="sr-only">
          Step 3: Evidence, Problem & Research Interest, What to Build
        </legend>

        <!-- Section 05: Show Us What You've Done -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 05</span>
            <h2>Show Us What You've Done</h2>
          </div>

          <div class="fields-stack">
            <div class="field">
              <span class="field-label">
                15. Have you ever built, analyzed, designed, researched, or
                contributed to something related to your chosen field?
              </span>
              <div class="pills-grid">
                {PROJECT_EXPERIENCE_OPTIONS.map((exp) => (
                  <label class="pill-radio-label">
                    <input type="radio" name="project_experience" value={exp} />
                    <span class="pill-content">{exp}</span>
                  </label>
                ))}
              </div>
            </div>

            <label class="field">
              <span class="field-label">
                16. Tell us about your most relevant work.{' '}
                <mark class="req">*</mark>
              </span>
              <div class="notice-box">
                <span class="notice-icon" aria-hidden="true">
                  ✦
                </span>
                <p>
                  Tidak harus project besar. Bisa berupa tugas kuliah, personal
                  project, eksperimen, kompetisi, riset, desain UI, repository
                  GitHub, konten, atau kegiatan organisasi.
                  <br />
                  <strong>Jelaskan:</strong> 1) Apa yang kamu buat? 2) Apa
                  masalah yang ingin diselesaikan? 3) Apa kontribusimu? 4)
                  Tools/teknologi apa yang dipakai? 5) Apa yang kamu pelajari?
                </p>
              </div>
              <textarea
                name="most_relevant_work"
                rows="5"
                required
                placeholder="Tuliskan cerita singkat tentang project/karya yang paling relevan bagi Anda..."
              ></textarea>
              <span class="field-error" aria-live="polite"></span>
            </label>

            <label class="field">
              <span class="field-label">17. Portfolio / Evidence Link</span>
              <span class="field-desc">
                Masukkan tautan relevan jika ada (GitHub, Figma, Behance,
                Website, LinkedIn, Kaggle, Google Drive, dll).
              </span>
              <input
                type="url"
                name="portfolio_link"
                placeholder="https://github.com/... or https://figma.com/..."
              />
            </label>

            <label class="field">
              <span class="field-label">
                18. If you don't have a portfolio, show us something else.
              </span>
              <span class="field-desc">
                Tautan Google Drive dokumen/screenshot project, notebook,
                artikel, hasil kompetisi, atau penjelasan karya lainnya.
              </span>
              <textarea
                name="alternative_evidence"
                rows="3"
                placeholder="Tautan Google Drive atau penjelasan alternatif karya Anda..."
              ></textarea>
            </label>
          </div>
        </div>

        <!-- Section 06: Problem & Research Interest -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 06</span>
            <h2>Problem & Research Interest</h2>
          </div>

          <div class="fields-stack">
            <label class="field">
              <span class="field-label">
                19. What real-world problem are you interested in solving?{' '}
                <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Tidak perlu memiliki solusi terlebih dahulu. Ceritakan masalah
                yang menurutmu menarik, penting, atau belum terselesaikan dengan
                baik.
                <br />
                <em>
                  Contoh: “Saya tertarik pada bagaimana AI dapat membantu
                  digitalisasi naskah kuno Nusantara” atau “Saya tertarik
                  membuat sistem RAG untuk riset medis akademik”.
                </em>
              </span>
              <textarea
                name="real_world_problem"
                rows="4"
                required
                placeholder="Tuliskan problem nyata yang menarik perhatian Anda..."
              ></textarea>
              <span class="field-error" aria-live="polite"></span>
            </label>

            <label class="field">
              <span class="field-label">
                20. What technology or approach would you like to explore to
                solve it?
              </span>
              <span class="field-desc">
                Tidak harus benar atau sempurna. Kami ingin melihat alur
                berpikir kamu tentang sebuah masalah.
              </span>
              <textarea
                name="technology_approach"
                rows="3"
                placeholder="Misal: Menggabungkan fine-tuned vision-language model, arsitektur graph RAG, atau pipeline scraping terdistribusi..."
              ></textarea>
            </label>

            <div class="field">
              <span class="field-label">
                21. Which type of output interests you most?
              </span>
              <span class="field-desc">
                Pilih luaran yang paling ingin Anda hasilkan selama berada di
                Data Sorcerers.
              </span>
              <div class="pills-grid">
                {DESIRED_OUTPUT_OPTIONS.map((output) => (
                  <label class="pill-checkbox-label">
                    <input
                      type="checkbox"
                      name="desired_output"
                      value={output}
                    />
                    <span class="pill-content">{output}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Section 07: What Do You Want to Build? -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 07</span>
            <h2>What Do You Want to Build?</h2>
          </div>

          <div class="fields-stack">
            <label class="field">
              <span class="field-label">
                22. What do you want to explore or build with Data Sorcerers?{' '}
                <mark class="req">*</mark>
              </span>
              <span class="field-desc">
                Tell us what you want to learn, experiment with, research, or
                build.
              </span>
              <textarea
                name="explore_or_build"
                rows="4"
                required
                placeholder="Tuliskan aspirasi proyek atau eksplorasi teknologi Anda bersama komunitas..."
              ></textarea>
              <span class="field-error" aria-live="polite"></span>
            </label>

            <label class="field">
              <span class="field-label">
                23. What skill do you want to improve the most?
              </span>
              <input
                type="text"
                name="skill_to_improve"
                placeholder="e.g. MLOps, AI Agents, Deep Learning, UI Design System, Public Speaking"
              />
            </label>

            <label class="field">
              <span class="field-label">
                24. What would you like to achieve in your first 6 months at
                Data Sorcerers?
              </span>
              <span class="field-desc">
                Contoh: “Saya ingin mampu membuat production-ready RAG system
                dan ikut mempublikasikan satu research paper atau project
                nyata.”
              </span>
              <textarea
                name="six_months_goal"
                rows="3"
                placeholder="Target konkret Anda dalam 6 bulan pertama..."
              ></textarea>
            </label>
          </div>
        </div>

        <div class="step-actions">
          <button
            type="button"
            class="btn-step-action btn-prev"
            data-action="prev-step"
            data-sfx="click"
          >
            <span class="arrow" aria-hidden="true">
              ←
            </span>
            <span>Back</span>
          </button>
          <button
            type="button"
            class="btn-step-action btn-next"
            data-action="next-step"
            data-sfx="click"
          >
            <span>Continue to Commitment & Values</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </button>
        </div>
      </fieldset>

      <!-- STEP 4: COMMITMENT & VALUES -->
      <fieldset class="form-step" data-step-panel="4">
        <legend class="sr-only">
          Step 4: Collaboration, Commitment, Motivation, and Agreement
        </legend>

        <!-- Section 08: Collaboration -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 08</span>
            <h2>Collaboration & Teamwork</h2>
          </div>

          <div class="fields-stack">
            <div class="field">
              <span class="field-label">
                25. How comfortable are you working in a team?
              </span>
              <span class="field-desc">
                Skala kenyamanan berkolaborasi dengan tim lintas disiplin.
              </span>
              <div class="linear-scale-group">
                <span class="scale-label-start">1: Prefer working alone</span>
                <div class="scale-buttons">
                  {[1, 2, 3, 4, 5].map((num) => (
                    <label class="scale-radio-label">
                      <input
                        type="radio"
                        name="team_comfort"
                        value={num}
                        checked={num === 4}
                      />
                      <span class="scale-number">{num}</span>
                    </label>
                  ))}
                </div>
                <span class="scale-label-end">
                  5: Very comfortable collaborating
                </span>
              </div>
            </div>

            <div class="field">
              <span class="field-label">
                26. What role do you usually take in a team?
              </span>
              <div class="pills-grid">
                {TEAM_ROLES_OPTIONS.map((role) => (
                  <label class="pill-checkbox-label">
                    <input type="checkbox" name="team_roles" value={role} />
                    <span class="pill-content">{role}</span>
                  </label>
                ))}
              </div>
            </div>

            <label class="field">
              <span class="field-label">
                27. Tell us about a time you worked with others to solve a
                problem.
              </span>
              <span class="field-desc">
                Bisa dari project kuliah, organisasi, hackathon, pekerjaan, atau
                kolaborasi open-source.
              </span>
              <textarea
                name="team_story"
                rows="3"
                placeholder="Ceritakan peran dan pengalaman Anda ketika bekerja bersama tim..."
              ></textarea>
            </label>
          </div>
        </div>

        <!-- Section 09: Commitment -->
        <div class="section-card">
          <div class="section-title-row">
            <span class="section-badge">SECTION 09</span>
            <h2>Commitment & Availability</h2>
          </div>

          <div class="fields-stack">
            <div class="field">
              <span class="field-label">
