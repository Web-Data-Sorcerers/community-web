---
import TeamCard from './TeamCard.astro';
import { leaderTeam, hodsTeams } from '../data/team';

const PAGE_SIZE = 3;
const STEP = 948;
---

<section class="our-team" aria-labelledby="team-title">
  <div class="team-canvas">
    <header class="team-header">
      <div class="eyebrow" aria-hidden="true">
        Our Team
      </div>
      <h2 id="team-title" class="team-title">
        The Sorcerers Behind It All
      </h2>
    </header>

    <div class="team-groups">
      <!-- Leader Team (Figma 1688:2941). -->
      <div class="team-group">
        <h3 class="team-group-title">Leader Team</h3>
        <div
          class:list={[
            'team-cards',
            'team-cards--leader',
            { 'is-growing': leaderTeam.length > 2 },
          ]}
        >
          {leaderTeam.map((member) => (
            <TeamCard {...member} fade={hodsTeams[1].fade} />
          ))}
        </div>
      </div>

      <!-- House of Data Sorcerers — per-HoDS carousel (Figma 1688:2978 / 1594:5145). -->
      <div class="team-group" data-hods>
        <h3 class="team-group-title">House of Data Sorcerers</h3>

        <div class="hods-carousel">
          <div class="hods-top">
            <div class="hods-chips-row">
              <button
                class="hods-arrow is-prev"
                type="button"
                data-hods-prev
                aria-label="Previous house"
              >
                <svg viewBox="0 0 13 11" fill="none" aria-hidden="true">
                  <path
                    d="M0.754756 5.49939H12.1494M5.50252 0.751626L0.754756 5.49939L5.50252 10.2472"
                    stroke="white"
                    stroke-width="1.51073"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </button>

              <div class="hods-chips-viewport">
                <div class="hods-chips" data-hods-chips>
                  {hodsTeams.map((group, i) => (
                    <button
                      class:list={['hods-chip', { 'is-active': i === 0 }]}
                      type="button"
                      data-hods-chip={i}
                      style={`--chip:${group.chip}`}
                    >
                      {group.title}
                    </button>
                  ))}
                </div>
              </div>

              <button
                class="hods-arrow is-next"
                type="button"
                data-hods-next
                aria-label="Next house"
              >
                <svg viewBox="0 0 13 11" fill="none" aria-hidden="true">
                  <path
                    d="M0.754756 5.49939H12.1494M5.50252 0.751626L0.754756 5.49939L5.50252 10.2472"
                    stroke="white"
                    stroke-width="1.51073"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </button>
            </div>

            <div class="hods-dots" role="tablist" aria-label="Houses">
              <button
                class="hods-dot is-active"
                type="button"
                data-hods-dot="0"
                aria-label="Houses 1"
              ></button>
              <button
                class="hods-dot"
                type="button"
                data-hods-dot="1"
                aria-label="Houses 2"
              ></button>
            </div>
          </div>

          <div class="hods-panels">
            {hodsTeams.map((group, i) => (
              <div
                class:list={['hods-panel', { 'is-active': i === 0 }]}
                data-hods-panel={i}
              >
                <div class="team-cards team-cards--hods">
                  {group.members.map((member) => (
                    <TeamCard {...member} fade={group.fade} />
                  ))}
                  {group.joinNow && (
                    <a class="team-card team-card--join" href="/recruitment">
                      <img
                        class="team-card-frame"
                        src="/images/team/card-frame.webp"
                        srcset="/images/team/card-frame.webp 1x, /images/team/card-frame-2x.webp 2x"
                        width="295"
                        height="277"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="team-join-mark" aria-hidden="true">
                        ?
                      </span>
                      <span class="team-join-divider" aria-hidden="true" />
                      <span class="team-join-label">Join Now!</span>
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { syncLiveTeam } from '../scripts/cms-live-sync.js';

  let controller: AbortController | undefined;

  const initHods = () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const root = document.querySelector<HTMLElement>('[data-hods]');
    if (!root) return;

    const chips = [...root.querySelectorAll<HTMLElement>('[data-hods-chip]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-hods-panel]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-hods-dot]')];
    const chipsEl = root.querySelector<HTMLElement>('[data-hods-chips]');
    const prev = root.querySelector<HTMLElement>('[data-hods-prev]');
    const next = root.querySelector<HTMLElement>('[data-hods-next]');
    if (!chips.length || !panels.length) return;

    const total = chips.length;
    const pageSize = 3;
    let active = 0;
    let shown = -1;

    const render = () => {
      const page = Math.floor(active / pageSize);
      chips.forEach((chip, i) =>
        chip.classList.toggle('is-active', i === active),
      );
      panels.forEach((panel, i) => {
        const isActive = i === active;
        panel.classList.toggle('is-active', isActive);
        // Restart the gated entrance on the newly shown panel. Skipped on the
        // first render so the section's scroll-reveal owns the first appearance.
        if (isActive && i !== shown && shown !== -1) {
          panel
            .querySelectorAll<HTMLElement>('.team-card')
            .forEach((card, index) =>
              card.style.setProperty('--i', String(index)),
            );
          panel.classList.remove('is-entering');
          void panel.offsetWidth;
          panel.classList.add('is-entering');
        }
      });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === page));
      chipsEl?.style.setProperty('--hods-page', String(page));
      shown = active;
    };

    chips.forEach((chip, i) =>
      chip.addEventListener(
        'click',
        () => {
          active = i;
          render();
        },
        { signal },
      ),
    );
    dots.forEach((dot, i) =>
      dot.addEventListener(
        'click',
        () => {
          active = i * pageSize;
          render();
        },
        { signal },
      ),
    );
    prev?.addEventListener(
      'click',
      () => {
        active = (active - 1 + total) % total;
        render();
      },
      { signal },
    );
    next?.addEventListener(
      'click',
      () => {
        active = (active + 1) % total;
        render();
      },
      { signal },
    );

    render();
    syncLiveTeam({ root, signal });
  };

  document.addEventListener('astro:page-load', initHods);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>

<style>
  /* Matches Figma node 1688:2933 (1440 x 1562): padding 80px, gap 80px, fill #050507. Header + groups gap 48; groups container 1287 centered. Leader cards 2 x 302x400 centered; HoDS carousel: chips row + dots + 4 cards 302x400 (left-aligned in the 1287 container -> x 76). */
  .our-team {
    position: relative;
    background: #050507;
    overflow: clip;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .team-canvas {
    position: relative;
    max-width: 1440px;
    width: 100%;
    margin-inline: auto;
    padding: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    box-sizing: border-box;
  }

  .team-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 1280px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26px;
    padding: 4px 8px;
    box-sizing: border-box;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.15);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4);
    color: #ffffff;
    font: 400 12px/18px var(--font-body);
    white-space: nowrap;
    user-select: none;
  }

  .team-title {
    margin: 0;
    width: 100%;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67px;
    text-align: center;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .team-groups {
    display: flex;
    flex-direction: column;
    gap: 80px;
    /* Figma group frame 1688:2940 is 1287 wide, centered in the 1280 content box -> x 76.5 (the 4 HoDS cards are left-aligned in it); margin:auto cannot create the negative offset for an overflowing child, so compute it explicitly. */
    width: 1287px;
    margin-inline: calc((100% - 1287px) / 2);
  }

  .team-group {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .team-group-title {
    margin: 0;
    width: 100%;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 700;
    line-height: 67px;
    text-align: center;
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .team-cards {
    display: flex;
    gap: 24px;
    width: 100%;
  }

  .team-cards--leader {
    justify-content: center;
  }

  .team-cards--leader.is-growing {
    justify-content: flex-start;
    overflow-x: auto;
    padding-top: 136px;
    margin-top: -136px;
  }

  .team-cards--hods {
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
    /* Room for the HoDS portraits to bleed above the card (Hall of Frames treatment). `overflow-x: auto` also clips the cross axis, so the bleed lives inside this padding box; the negative margin keeps the card row at its Figma position. Leader cards keep the clipped Figma framing. */
    padding-top: 48px;
    margin-top: -48px;
  }

  /* Leader portraits bleed above the card too (the reference shows the head
     ~19px above the card top); the row has no overflow so the bleed is free. */
  .team-cards--leader :global(.team-card) {
    overflow: visible;
  }

  .hods-panel :global(.team-card) {
    overflow: visible;
  }

  /* Bleeding portraits (leader + HoDS) would be cut by the card's 1px top rim at the card's top edge, so hide just that top edge on the bleeding cards. */
  .hods-panel :global(.team-card::after),
  .team-cards--leader :global(.team-card::after) {
    clip-path: inset(1px 0 0 0);
  }

  .team-cards--hods::-webkit-scrollbar {
    display: none;
  }

  /* HoDS carousel */
  .hods-carousel {
    display: flex;
    flex-direction: column;
    gap: 72px;
    width: 100%;
  }

  .hods-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .hods-chips-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .hods-arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    padding: 12px;
    box-sizing: border-box;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    cursor: pointer;
  }

  .hods-arrow svg {
    display: block;
    width: 13px;
    height: 11px;
  }

  .hods-arrow.is-next svg {
    transform: scaleX(-1);
  }

  .hods-chips-viewport {
    width: 932px;
    max-width: 100%;
    overflow: hidden;
  }

  .hods-chips {
    display: flex;
    gap: 16px;
    transform: translateX(calc(var(--hods-page, 0) * -948px));
  }

  .hods-chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 300px;
    height: 49px;
    padding: 8px 24px;
    box-sizing: border-box;
    border: 0;
    border-radius: 20px;
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font: 700 22px/33px var(--font-body);
    white-space: nowrap;
    cursor: pointer;
  }

  .hods-chip.is-active {
    background-color: rgba(0, 0, 0, 0.2);
    background-image: var(--chip);
  }

  .hods-dots {
    display: flex;
    gap: 8px;
  }

  .hods-dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
  }

  .hods-dot.is-active {
    background: #6c3bff;
  }

  .hods-panels {
    width: 100%;
    /* Panels share one grid cell so a swap can cross-fade instead of the hard display:none/block cut. All panels hold the same 4-card row, so the grid keeps a single stable height. */
    display: grid;
  }

  .hods-panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
  }

  .hods-panel.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
  }

  /* Join Now card (Growth #4, Figma 1598:5506). */
  .team-card--join {
    position: relative;
    display: block;
    flex: none;
    width: 302px;
    height: 400px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
    text-decoration: none;
  }

  .team-card--join .team-card-frame {
    position: absolute;
    left: 3px;
    top: 13px;
    width: 295px;
    height: 277px;
    z-index: 1;
    pointer-events: none;
  }

  .team-join-mark {
    position: absolute;
    left: 117px;
    top: 132px;
    width: 67px;
    height: 102px;
    z-index: 2;
    font: 700 120px/102px var(--font-body);
    text-align: center;
    background: linear-gradient(180deg, #ffffff 0%, #6c3bff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .team-join-divider {
    position: absolute;
    left: 38px;
    top: 323px;
    width: 217px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .team-join-label {
    position: absolute;
    left: 38px;
    top: 336px;
    width: 217px;
    height: 24px;
    font: 400 16px/24px var(--font-body);
    text-align: center;
    color: #d8d1d1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hods-panel {
      transition:
        opacity 0.5s ease,
        visibility 0s linear 0.5s;
    }
    .hods-panel.is-active {
      transition:
        opacity 0.5s ease,
        visibility 0s;
    }
    .hods-chips {
      transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
      will-change: transform;
    }
    .hods-chip,
    .hods-dot,
    .hods-arrow {
      transition:
        background-color 0.3s ease,
        transform 0.25s ease,
        opacity 0.3s ease;
    }
    .hods-chip:hover {
      transform: translateY(-1px);
    }
    .hods-dot:hover {
      transform: scale(1.3);
    }
    .hods-arrow:hover {
      background-color: rgb(255 255 255 / 28%);
      transform: scale(1.06);
    }
    .hods-arrow:active {
      transform: scale(0.9);
    }
    .hods-panel.is-active.is-entering :global(.team-card) {
      animation: hods-card-in 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
    @keyframes hods-card-in {
      from {
        opacity: 0;
        transform: translateY(20px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
  }

  @media (max-width: 1367px) {
    .team-groups {
      width: 100%;
      margin-inline: 0;
    }
  }

  @media (max-width: 1100px) {
    .team-canvas {
      padding: 64px 24px;
      gap: 40px;
    }
    .team-title,
    .team-group-title {
      font-size: clamp(32px, 5vw, 48px);
      line-height: 1.2;
    }
    .team-groups {
      gap: 56px;
    }
    .team-group {
      gap: 40px;
    }
    .team-cards {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .team-card,
    .team-card--join {
      scroll-snap-align: start;
    }
  }

  @media (max-width: 1050px) {
    .hods-chips-viewport {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .hods-chips-viewport::-webkit-scrollbar {
      display: none;
    }
    .hods-chips {
      transform: none;
    }
    .hods-arrow,
    .hods-dots {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .team-canvas {
      padding: 48px 16px;
      gap: 32px;
    }
    .team-groups {
      gap: 40px;
    }
    .team-group {
      gap: 32px;
    }
    .hods-carousel {
      gap: 48px;
    }
    .hods-chip {
      width: 236px;
      height: 43px;
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
