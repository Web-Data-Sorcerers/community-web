---
const navigation = [
  'Home',
  'About Us',
  'Recruitment',
  'Hall of Frames',
  'Partners',
  'Contact',
];
const legal = ['Terms', 'Privacy', 'Cookies'];
const destinations: Record<string, string> = {
  Home: '/',
  'About Us': '/about',
  Recruitment: '/recruitment',
  'Hall of Frames': '/hall-of-frames',
  Partners: '/partners',
  Contact: '/contact',
};
---

<footer class="footer">
  <picture class="backdrop">
    <source
      media="(max-width: 600px)"
      srcset="/images/backgrounds/footer-mobile.webp"
    />
    <img
      src="/images/backgrounds/footer.webp"
      srcset="/images/backgrounds/footer-1440.webp 1440w, /images/backgrounds/footer.webp 2880w, /images/backgrounds/footer-5760.webp 5760w, /images/backgrounds/footer-7200.webp 7200w"
      sizes="100vw"
      width="1440"
      height="556"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="top">
    <div class="brand">
      <div class="brand-copy">
        <div class="brand-lockup">
          <div class="brand-name">
            <span>DATA</span>
            <span>SORCERERS</span>
          </div>
          <p class="brand-tagline">Sorcery In Data, Magic In AI</p>
        </div>
        <p class="brand-desc">
          United by curiosity, driven by
          <br />
          technology, enchanted by
          <br />
          collaboration.
        </p>
      </div>
      <div class="socials">
        <span class="social" title="Instagram">
          <img
            src="/images/footer/instagram.svg"
            width="24"
            height="24"
            alt="Instagram"
          />
        </span>
        <span class="social" title="LinkedIn">
          <img
            src="/images/footer/linkedin.svg"
            width="24"
            height="24"
            alt="LinkedIn"
          />
        </span>
      </div>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <h2>Navigation</h2>
      <ul>
        {navigation.map((label) => (
          <li>
            <a
              href={destinations[label] || '#'}
              data-sfx="select"
              data-sfx-hover="hover"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="footer-contact">
      <h2>Contact</h2>
      <ul>
        <li>
          Contact Person:{' '}
          <a href="tel:+6285727246733" data-sfx="click" data-sfx-hover="hover">
            +62 8572 -7246-733
          </a>
        </li>
        <li>
          Email:{' '}
          <a
            href="mailto:datasorcerers@gmail.com"
            data-sfx="click"
            data-sfx-hover="hover"
          >
            datasorcerers@gmail.com
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="bottom">
    <a
      class="scroll-up"
      href="#"
      aria-label="Scroll to top"
      data-sfx="select"
      data-sfx-hover="hover"
    >
      <svg
        width="12"
        height="12"
        viewBox="0 0 12 12"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M6 11V1M1.5 5.5L6 1L10.5 5.5"
          stroke="white"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
    <hr class="divider" />
    <div class="legal">
      <p>© DATA SORCERERS 2026. All right reserved</p>
      <div class="legal-links">
        {legal.map((label) => (
          <span aria-disabled="true">{label}</span>
        ))}
      </div>
    </div>
  </div>
</footer>
<script>
  // The scroll-up control must scroll the page, not trigger a View Transition.
  // `href="#"` is a same-origin link, so ClientRouter would otherwise intercept
  // it as a client navigation. Intercept and scroll manually (respecting
  // reduced motion), then drop the stale hash.
  let controller: AbortController | undefined;
  const initScrollUp = () => {
    controller?.abort();
    controller = new AbortController();
    const button = document.querySelector<HTMLAnchorElement>('.scroll-up');
    if (!button) return;
    button.addEventListener(
      'click',
      (event) => {
        event.preventDefault();
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        history.replaceState(null, '', location.pathname + location.search);
      },
      { signal: controller.signal },
    );
  };
  initScrollUp();
  document.addEventListener('astro:page-load', initScrollUp);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
<style>
  .footer {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 60px;
    min-height: 556px;
    padding: 80px var(--page-gutter) 28px;
    overflow: clip;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .backdrop img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .brand {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .brand-lockup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 206px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 38.4px;
    background: linear-gradient(270deg, #fff 0%, #ede8ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .brand-name span {
    display: block;
  }
  .brand-tagline {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #fff;
  }
  .brand-desc {
    margin: 0;
    font-size: 17.5px;
    font-weight: 400;
    line-height: 28.44px;
    color: #fff;
  }
  .socials {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 12px;
    border: 0.75px solid #fff;
    border-radius: 31.5px;
  }
  .social img {
    display: block;
    width: 24px;
    height: 24px;
  }
  .footer-nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .footer-nav h2,
  .footer-contact h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #fff;
  }
  .footer-nav ul,
  .footer-contact ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-nav li,
  .footer-contact li {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    letter-spacing: -0.176px;
    color: #fff;
    white-space: nowrap;
  }
  .footer-contact a {
    color: inherit;
    text-decoration: none;
  }
  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    text-decoration: underline;
  }
  .top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .scroll-up {
    position: absolute;
    right: 0;
    bottom: calc(100% + 8px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 37px;
    height: 37px;
    padding: 12px;
    border-radius: 20px;
    background: rgb(255 255 255 / 15%);
    transition: background 0.25s ease;
  }
  .scroll-up:hover {
    background: rgb(108 59 255 / 60%);
  }
  .scroll-up svg {
    display: block;
    width: 11.31px;
    height: 11.31px;
  }
  .brand,
  .footer-nav,
  .footer-contact {
    position: relative;
  }
  .bottom {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .divider {
    height: 1px;
    margin: 0;
    border: 0;
    background: rgb(203 197 255 / 30%);
  }
  .legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .legal p {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #fff;
    white-space: nowrap;
  }
  .legal-links {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .legal-links span {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: #fff;
    white-space: nowrap;
  }
  @media (max-width: 1300px) {
    .top {
      gap: 60px;
    }
  }
  @media (max-width: 1050px) {
    .footer {
      gap: 48px;
      padding-top: 64px;
    }
    .top {
      flex-wrap: wrap;
      gap: 56px;
    }
    .brand {
      flex-basis: 100%;
    }
    .legal {
      justify-content: space-between;
      gap: 24px;
    }
  }
  @media (max-width: 600px) {
    .footer {
      gap: 40px;
      padding-top: 56px;
      padding-bottom: max(64px, calc(env(safe-area-inset-bottom, 34px) + 32px));
    }
    /* Portrait backdrop: the landscape is anchored at the bottom edge. */
    .backdrop img {
      object-position: center bottom;
    }
    .top {
      flex-direction: column;
      gap: 40px;
    }
    .legal {
      flex-wrap: wrap;
      gap: 16px;
      padding-bottom: 8px;
    }
    .legal p,
    .legal-links span {
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-up {
      transition: none;
    }
  }
</style>
