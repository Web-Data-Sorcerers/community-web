---
// Figma node 1436:3637 ("TIMELINE", 1440 × 812px). The table is 1280 wide: a header row then a body with
// six phase rows separated by 1px gradient rules. Registration dates follow
// the owner-supplied October 2026 poster; subsequent phases are not announced.
import { RECRUITMENT_CAMPAIGN } from '../data/recruitment-campaign';

const phases = [
  'OPEN RECRUITMENT',
  'APPLICATION',
  'FOUNDATION SCREENING',
  'HOODS INTERVIEW',
  'TRIAL / CHALLENGE',
  'MEMBER',
];
const registration = {
  start: RECRUITMENT_CAMPAIGN.startDate,
  end: RECRUITMENT_CAMPAIGN.endDate,
};
---

<section
  id="selection-timeline"
  class="selection-timeline"
  aria-labelledby="selection-timeline-title"
>
  <h2 id="selection-timeline-title">
    <span class="tl-heading-text">Selection Timeline</span>
  </h2>

  <div class="timeline">
    <div class="tl-head">
      <span class="phase head">Phase</span>
      <span class="date-col head">Date</span>
    </div>
    <div class="tl-body">
      {phases.map((phase, index) => (
        <div class="tl-row">
          <span class="phase">{phase}</span>
          <span class="date-col">
            {index === 0 ? (
              <>
                <time datetime={registration.start}>12 Oct</time>
                {' – '}
                <time datetime={registration.end}>12 Nov 2026</time>
              </>
            ) : (
              'TBA'
            )}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .selection-timeline {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 56px;
    /* Full-screen standard (#9): one section = one screen, content centred. */
    min-height: 100vh;
    min-height: 100svh;
    padding: 80px;
    background: #050507;
  }
  h2 {
    margin: 0;
    width: 100%;
    max-width: 1280px;
    font: 700 56px/67.2px var(--font-display);
    background: linear-gradient(181deg, #ffffff 15%, #999999 42%, #ffffff 79%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tl-heading-text {
    position: relative;
    top: 1px;
  }
  .timeline {
    width: 100%;
    max-width: 1280px;
  }
  .tl-head,
  .tl-body {
    position: relative;
  }
  .tl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Heights include the 1px ring so the table totals 529px. */
    height: 78px;
    padding: 18px 32px;
    border-radius: 20px 20px 0 0;
    background: rgb(108 59 255 / 25%);
  }
  .tl-body {
    display: flex;
    flex-direction: column;
    gap: 36px;
    height: 451px;
    padding: 18px 32px;
    border-radius: 0 0 20px 20px;
    background: rgb(255 255 255 / 15%);
  }
  .tl-head::after,
  .tl-body::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(90deg, #ede8ff 0%, #2e276c 50%, #ede8ff 100%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  /* Figma draws the junction 1px higher: a 2px header base + no body top edge. */
  .tl-head::after {
    padding: 1px 1px 2px 1px;
  }
  .tl-body::after {
    padding: 0 1px 1px 1px;
  }
  .tl-row {
    position: relative;
    display: flex;
    align-items: center;
  }
  .tl-row + .tl-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -18.5px;
    /* Reaches the body's right edge (content width + the 32px right padding). */
    width: calc(100% + 32px);
    height: 1px;
    /* Figma fades to white (non-premultiplied); split colour + alpha ramps. */
    background: linear-gradient(90deg, #9b7bff, #ffffff);
    -webkit-mask-image: linear-gradient(90deg, #000, transparent);
    mask-image: linear-gradient(90deg, #000, transparent);
  }
  .phase {
    flex: 1;
    font-size: 26px;
    font-weight: 500;
    line-height: 39px;
    color: #fff;
  }
  .phase.head {
    font-weight: 700;
  }
  .date-col {
    flex: none;
    /* 568px of the 1216px body content, proportional so it never overflows. */
    width: 46.710526%;
    font-size: 26px;
    font-weight: 500;
    line-height: 39px;
    color: #fff;
  }
  .date-col.head {
    font-weight: 700;
  }
  @media (max-width: 760px) {
    .selection-timeline {
      gap: 40px;
      padding: 64px 24px;
    }
    h2 {
      font-size: clamp(30px, 8vw, 48px);
      line-height: 1.214286;
    }
    .tl-body {
      gap: 24px;
      height: auto;
      min-height: 451px;
    }
    .tl-row {
      gap: 16px;
    }
    .phase,
    .date-col {
      font-size: 18px;
      line-height: 27px;
    }
    .date-col {
      width: 40%;
    }
    .phase,
    .date-col {
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .tl-row + .tl-row::before {
      top: -12.5px;
      width: 100%;
    }
  }
</style>
