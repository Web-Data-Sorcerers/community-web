---
import '../styles/global.css';
import { getPageState, PAGE_BY_ID } from '../data/site-visibility-registry.mjs';
import { ClientRouter } from 'astro:transitions';
import Splash from '../components/Splash.astro';
import Sound from '../components/Sound.astro';
import { getSiteOrigin, canonicalUrl } from '../data/site-url.mjs';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  robots?: string;
  structuredData?: Record<string, any>[];
}
const {
  title = 'Data Sorcerers — Sorcery in Data, Magic in AI',
  description = 'An AI & Data Innovation Community where people learn, experiment, research, and build meaningful technology together.',
  image = '/og/og-default.jpg',
  type = 'website',
  noindex = false,
  robots,
  structuredData: extraStructuredData = [],
} = Astro.props;

const visibility = Astro.locals.visibility;
const inactive =
  visibility && !getPageState(visibility, Astro.locals.visibilityPageId);
const site = Astro.site ?? new URL(getSiteOrigin());
const canonicalPath = visibility
  ? (PAGE_BY_ID[Astro.locals.visibilityPageId ?? '']?.path ??
    Astro.url.pathname)
  : Astro.url.pathname;
const pageUrl = canonicalUrl(canonicalPath, site);
const imageUrl = new URL(image, site).href;
const imageAlt = 'Data Sorcerers — Sorcery in Data, Magic in AI';

const baseStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': canonicalUrl('/#organization', site),
    name: 'Data Sorcerers',
    url: site.href,
    logo: new URL('/icon-512.png', site).href,
    description,
    sameAs: [
      'https://www.instagram.com/datasorcerers',
      'https://www.linkedin.com/company/data-sorcerers',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': canonicalUrl('/#website', site),
    name: 'Data Sorcerers',
    url: site.href,
    publisher: {
      '@id': canonicalUrl('/#organization', site),
    },
  },
];
const allStructuredData = [...baseStructuredData, ...extraStructuredData];
---

<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        inactive
          ? 'noindex, follow'
          : robots
            ? robots
            : noindex
              ? 'noindex, nofollow'
              : 'index, follow'
      }
    />
    <link rel="canonical" href={pageUrl} />
    {import.meta.env.GOOGLE_SITE_VERIFICATION && (
      <meta
        name="google-site-verification"
        content={import.meta.env.GOOGLE_SITE_VERIFICATION}
      />
    )}
    <meta name="theme-color" content="#050507" />
    <!-- Client-side navigation swaps pages without a fade and keeps the DOM/JS
         context (and the Web Audio engine) alive, so the sound does not cut on
         navigation. Component scripts are re-run per page via `astro:page-load`
         because Astro does not re-execute bundled scripts on a swap. -->
    <ClientRouter fallback="swap" />
    {visibility && (
      <meta name="ds-visibility-revision" content={visibility.revision} />
    )}
    <script>
      import '../scripts/site-visibility-navigation.js';
      import '../scripts/press-feedback.js';
      import '../scripts/navigation-styles.js';
    </script>
    <meta name="author" content="Data Sorcerers" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Data Sorcerers" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link
      rel="preload"
      href="/fonts/manrope-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(allStructuredData)}
    ></script>
    <script is:inline>
      // Components push promises here for the splash to await (see Splash.astro):
      // the heavy hero three.js chunk and the background video, so the overlay
      // only lifts once the page can actually run without janking.
      window.__dsPreload = window.__dsPreload || [];
      (function () {
        var root = document.documentElement;
        try {
          var seen = sessionStorage.getItem('ds:splash') === '1';
          var reduce = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches;
          var firstDocumentRun = !window.__dsSplashBootstrapped;
          window.__dsSplashBootstrapped = true;
          var navigation = performance.getEntriesByType('navigation')[0];
          var home = location.pathname === '/';
          var reload = navigation && navigation.type === 'reload';
          // Navigation timing belongs to the original document even after an
          // Astro swap. Only a real Home document load can arm the splash.
          if (firstDocumentRun && home && (!seen || reload) && !reduce) {
            root.classList.add('splash-armed');
            if ('scrollRestoration' in history) {
              history.scrollRestoration = 'manual';
            }
          } else {
            root.classList.add('splash-done');
            // Warm, in-session navigation (the splash already played): tell the
            // hero to present itself settled instead of replaying its entrance
            // blur/sweep on every Home <-> Recruitment switch.
            if (seen || !firstDocumentRun) root.classList.add('nav-warm');
          }
        } catch (e) {
          root.classList.add('splash-done');
        }
        // The ClientRouter overwrites <html>'s attributes on every swap, which
        // would drop the runtime `splash-done`/`nav-warm` classes added above.
        // Re-apply them right after each swap (before `astro:page-load` runs the
        // component init), so the splash never reappears and the hero stays
        // "warm" instead of replaying its entrance on every page switch.
        document.addEventListener('astro:after-swap', function () {
          root.classList.remove('splash-armed');
          root.classList.add('splash-done', 'nav-warm');
        });
      })();
    </script>
    <script is:inline>
      // Keep deep links (e.g. `/#domains` from a HoDS detail "Back") and reloads
      // on the right section. The browser's initial fragment scroll happens
      // before the splash lifts (`overflow: hidden` on <html>) and before Motion
      // installs the hero pin spacer, so the target shifts and the jump lands in
      // the wrong place. Re-apply it once the page has settled — briefly, so a
      // user who starts scrolling immediately keeps control.
      (function () {
        var target = function () {
          var hash = location.hash;
          if (!hash || hash.length < 2) return null;
          try {
            return document.getElementById(decodeURIComponent(hash.slice(1)));
          } catch (e) {
            return null;
          }
        };
        var jump = function () {
          var el = target();
          if (el) el.scrollIntoView({ block: 'start' });
        };
        var soon = function () {
          window.requestAnimationFrame(jump);
          window.setTimeout(jump, 250);
          window.setTimeout(jump, 700);
        };
        window.addEventListener('ds:splash-done', soon);
        // Client-side navigation: Astro updates the hash + scroll, but the hero
        // pin spacer is installed after the swap, so re-apply once it settles.
        document.addEventListener('astro:page-load', soon);
        window.addEventListener('load', function () {
          window.setTimeout(jump, 0);
        });
        document.addEventListener('DOMContentLoaded', function () {
          window.setTimeout(jump, 0);
        });
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () {
            window.requestAnimationFrame(jump);
          });
        }
      })();
    </script>
  </head>
  <body>
    <Splash />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <Sound />
  </body>
</html>
