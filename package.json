{
  "name": "data-sorcerers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "verify:visual": "node scripts/verify.mjs",
    "verify:vt": "node scripts/verify-vt.mjs",
    "audit:navbar": "node scripts/navbar-audit.mjs",
    "audit:spacing": "node scripts/spacing-audit.mjs",
    "assets:optimize": "node scripts/optimize-images.mjs",
    "assets:og": "node scripts/generate-og.mjs",
    "assets:starfield": "node scripts/generate-star-tiles.mjs",
    "assets:footer": "node scripts/generate-footer-background.mjs",
    "assets:partners": "node scripts/generate-partners-assets.mjs",
    "assets:hof": "node scripts/generate-hof-assets.mjs",
    "assets:contact": "node scripts/generate-contact-assets.mjs",
    "assets:about": "node scripts/generate-about-assets.mjs",
    "assets:heroes": "node scripts/generate-hero-bg.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "perf:audit": "node scripts/perf-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/fetch-cms.mjs",
