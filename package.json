    "verify:recruitment-db": "node scripts/verify-recruitment-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "astro": "7.3.3",
    "gsap": "^3.15.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "three": "0.186.0",
    "typescript": "6.0.3"
  }
